<file path="src/pages/blog/[slug].astro">
---
import Layout from "../../layouts/Layout.astro";
import { ARTIGOS_BLOG, type ArtigoBlog } from "../../data/artigos";
import BlogGeoSchema from "../../components/artigosBlog/BlogGeoSchema.astro";
import BlogShare from "../../components/artigosBlog/BlogShare.astro";
import BlogCard from "../../components/artigosBlog/BlogCard.astro";

export function getStaticPaths() {
  return ARTIGOS_BLOG.map((artigo) => ({
    params: { slug: artigo.slug },
    props: { artigo },
  }));
}

interface Props {
  artigo: ArtigoBlog;
}

const { artigo } = Astro.props;
const currentUrl = new URL(
  Astro.url.pathname,
  Astro.site || "https://lzba.com.br",
).toString();

// Artigos relacionados (outros artigos excluindo o atual)
const artigosRelacionados = ARTIGOS_BLOG.filter(
  (item) => item.slug !== artigo.slug,
).slice(0, 2);
---

<Layout
  title={`${artigo.titulo} | Blog LZBA Incorporadora`}
  description={artigo.metaDescription}
  currentPath={`/blog/${artigo.slug}`}
  image={artigo.imagemCapa}
>
  <!-- Metadados de SEO Local & GEO + JSON-LD Schema.org -->
  <Fragment slot="head">
    <BlogGeoSchema artigo={artigo} url={currentUrl} />
  </Fragment>

  <!-- 1. TOPO EDITORIAL / BREADCRUMB & TÍTULO -->
  <header
    class="pt-28 pb-12 sm:pt-36 sm:pb-16 bg-lzba-dark text-white relative overflow-hidden"
  >
    <!-- Overlay Arquitetônico -->
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 hero-overlay"></div>
    </div>
    <div
      class="absolute top-0 right-1/4 w-80 h-80 bg-lzba-gold/10 rounded-full blur-3xl pointer-events-none"
    >
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Badges de Categoria & Localização GEO -->
      <div class="flex flex-wrap items-center gap-2.5 mb-5">
        <span
          class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white/10 text-neutral-200 border border-white/10"
        >
          {artigo.categoria}
        </span>
        <span
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-lzba-gold/15 text-lzba-gold border border-lzba-gold/30"
        >
          <svg
            class="w-3.5 h-3.5 text-lzba-gold"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          {artigo.geo.regiao} • {artigo.geo.bairro}
        </span>
      </div>

      <!-- H1 Oficial do Artigo -->
      <h1
        class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight mb-6 font-heading uppercase"
      >
        {artigo.titulo}
      </h1>

      <!-- Meta informações: Autor, Data e Leitura -->
      <div
        class="flex flex-wrap items-center gap-4 text-xs sm:text-sm text-neutral-400 pt-4 border-t border-neutral-800"
      >
        <div class="flex items-center gap-2">
          <div
            class="w-8 h-8 rounded-full bg-lzba-red text-white font-bold flex items-center justify-center text-xs"
          >
            LZ
          </div>
          <div>
            <p class="font-medium text-white">{artigo.autor.nome}</p>
            <p class="text-xs text-neutral-400">{artigo.autor.cargo}</p>
          </div>
        </div>

        <span class="hidden sm:inline text-neutral-600">•</span>

        <time datetime={artigo.dataPublicacao} class="text-neutral-300">
          {artigo.dataPublicacaoFormatada}
        </time>

        <span class="hidden sm:inline text-neutral-600">•</span>

        <span class="inline-flex items-center gap-1 text-neutral-300">
          <svg
            class="w-4 h-4 text-neutral-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          {artigo.tempoLeitura}
        </span>
      </div>
    </div>
  </header>

  <!-- 2. CORPO DO ARTIGO -->
  <article class="bg-white py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Imagem de Capa Principal com Aspecto e Legenda -->
      <figure
        class="mb-12 rounded-2xl overflow-hidden shadow-lg border border-neutral-200"
      >
        <img
          src={artigo.imagemCapa}
          alt={artigo.imagemAlt}
          width="1200"
          height="675"
          class="w-full h-auto max-h-130 object-cover object-center"
          loading="eager"
        />
        <figcaption
          class="p-3 bg-neutral-50 text-xs text-neutral-500 italic border-t border-neutral-200"
        >
          {artigo.imagemAlt}
        </figcaption>
      </figure>

      <!-- Conteúdo Editorial Semântico -->
      <div
        class="prose prose-lg max-w-none text-neutral-800 leading-relaxed font-light space-y-6"
      >
        {
          artigo.secoes.map((secao) => {
            if (secao.tipo === "paragrafo") {
              return (
                <p class="text-base sm:text-lg leading-relaxed text-neutral-700">
                  {secao.texto}
                </p>
              );
            }

            if (secao.tipo === "h2") {
              return (
                <h2 class="text-2xl sm:text-3xl font-bold text-neutral-900 mt-10 mb-4 pt-6 border-t border-neutral-100">
                  {secao.texto}
                </h2>
              );
            }

            if (secao.tipo === "h3") {
              return (
                <h3 class="text-xl sm:text-2xl font-semibold text-neutral-900 mt-6 mb-3">
                  {secao.texto}
                </h3>
              );
            }

            if (secao.tipo === "lista" && secao.itens) {
              return (
                <ul class="my-6 space-y-4">
                  {secao.itens.map((item) => (
                    <li class="flex items-start gap-3 bg-neutral-50 p-4 rounded-xl border border-neutral-200/80">
                      <span class="mt-1 w-2 h-2 rounded-full bg-amber-500 shrink-0" />
                      <div class="text-sm sm:text-base text-neutral-700">
                        {item.titulo && (
                          <strong class="font-bold text-neutral-900 block mb-1">
                            {item.titulo}
                          </strong>
                        )}
                        <span>{item.descricao}</span>
                      </div>
                    </li>
                  ))}
                </ul>
              );
            }

            if (secao.tipo === "destaque") {
              return (
                <blockquote class="my-8 p-6 bg-lzba-light/60 border-l-4 border-lzba-gold rounded-r-xl">
                  <p class="text-lg sm:text-xl font-medium text-lzba-dark italic leading-relaxed">
                    "{secao.texto}"
                  </p>
                </blockquote>
              );
            }

            if (secao.tipo === "cta") {
              return (
                <div class="my-10 p-8 bg-lzba-dark text-white rounded-2xl shadow-xl relative overflow-hidden border border-white/10">
                  <div class="relative z-10">
                    <h3 class="text-xl sm:text-2xl font-bold text-lzba-gold mb-2 font-heading uppercase">
                      {secao.titulo}
                    </h3>
                    <p class="text-neutral-300 font-light mb-6 text-sm sm:text-base">
                      {secao.texto}
                    </p>
                    <a
                      href={secao.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 px-6 py-3.5 bg-lzba-red hover:bg-lzba-red/90 text-white font-medium text-xs sm:text-sm uppercase tracking-wider transition-all duration-300 shadow-md"
                    >
                      {secao.linkTexto}
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M14 5l7 7m0 0l-7 7m7-7H3"
                        />
                      </svg>
                    </a>
                  </div>
                </div>
              );
            }

            return null;
          })
        }
      </div>

      <!-- Empreendimento Relacionado Vinculado ao Artigo -->
      {
        artigo.empreendimentoVinculado && (
          <aside class="my-12 p-6 sm:p-8 bg-linear-to-br from-neutral-50 to-neutral-100 rounded-2xl border border-neutral-200">
            <div class="flex flex-col sm:flex-row items-center gap-6">
              <img
                src={artigo.empreendimentoVinculado.imagemCapa}
                alt={artigo.empreendimentoVinculado.nome}
                width="240"
                height="160"
                class="w-full sm:w-48 h-36 object-cover rounded-xl shadow-xs shrink-0"
              />
              <div class="grow text-center sm:text-left">
                <span class="text-xs font-semibold uppercase tracking-wider text-lzba-gold block mb-1">
                  Empreendimento em Destaque
                </span>
                <h4 class="text-xl font-bold text-neutral-900 mb-2 font-heading">
                  {artigo.empreendimentoVinculado.nome}
                </h4>
                <p class="text-sm text-neutral-600 font-light mb-4">
                  {artigo.empreendimentoVinculado.tagline}
                </p>
                <a
                  href={`/empreendimentos/${artigo.empreendimentoVinculado.slug}`}
                  class="inline-flex items-center gap-1.5 text-sm font-bold text-neutral-900 hover:text-lzba-red transition-colors"
                >
                  Conheça as plantas e detalhes do projeto
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </aside>
        )
      }

      <!-- Tags do Artigo -->
      <div class="mt-12 pt-6 border-t border-neutral-200">
        <h4
          class="text-xs uppercase font-semibold text-neutral-500 tracking-wider mb-3"
        >
          Tags Relacionadas:
        </h4>
        <div class="flex flex-wrap gap-2">
          {
            artigo.tags.map((tag) => (
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-neutral-100 text-neutral-700 hover:bg-neutral-200 transition-colors">
                #{tag}
              </span>
            ))
          }
        </div>
      </div>

      <!-- Compartilhamento Social -->
      <div class="mt-6">
        <BlogShare titulo={artigo.titulo} url={currentUrl} />
      </div>
    </div>
  </article>

  <!-- 3. ARTIGOS RELACIONADOS -->
  {
    artigosRelacionados.length > 0 && (
      <section class="py-16 bg-neutral-50 border-t border-neutral-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between mb-8">
            <div>
              <span class="text-xs uppercase font-semibold text-lzba-gold tracking-wider block mb-1">
                Continue Lendo
              </span>
              <h3 class="text-2xl font-bold text-neutral-900 font-heading">
                Outros Artigos da Zona Norte
              </h3>
            </div>
            <a
              href="/blog"
              class="text-sm font-semibold text-neutral-900 hover:text-lzba-red transition-colors flex items-center gap-1"
            >
              Ver todos
              <svg
                class="w-4 h-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {artigosRelacionados.map((relacionado) => (
              <BlogCard artigo={relacionado} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>
</file>

<file path="src/pages/empreendimentos/[slug].astro">
---
import Layout from '../../layouts/Layout.astro';
import CtaSection from '../../components/sections/CtaSection.astro';
import { EMPREENDIMENTOS, CONTATO_LZBA, type Empreendimento } from '../../data/empreendimentos';

export function getStaticPaths() {
  return EMPREENDIMENTOS.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

interface Props {
  item: Empreendimento;
}

const { item } = Astro.props;

const statusStyles = {
  lancamento: 'bg-lzba-gold/20 text-lzba-gold border-lzba-gold/50',
  em_obras: 'bg-sky-500/20 text-sky-300 border-sky-400/40',
  entregue: 'bg-emerald-500/20 text-emerald-300 border-emerald-400/40',
};

const whatsappText = encodeURIComponent(`Olá! Gostaria de mais informações sobre o ${item.titulo} (${item.bairro}).`);
const whatsappCustomLink = `https://wa.me/5511999618125?text=${whatsappText}`;

const plantasComImagem = (item.plantas || []).filter(
  (planta) => typeof planta.imagem === 'string' && planta.imagem.trim() !== ''
);
---

<Layout
  title={`${item.titulo} | LZBA Construtora e Incorporadora`}
  description={`${item.titulo} em ${item.bairro}: ${item.metragem}, ${item.dormitorios}, ${item.vagas}. Conheça plantas, diferenciais e status da obra.`}
  currentPath={`/empreendimentos/${item.slug}`}
  image={item.imagemCapa}
>
  <!-- 1. HERO DO EMPREENDIMENTO (PADRÃO ESTÉTICO DA HOME) -->
  <section class="relative min-h-[60vh] sm:min-h-[68vh] flex flex-col justify-end pt-16 pb-16 sm:pb-20 overflow-hidden bg-lzba-dark text-white">
    <!-- Imagem de Fundo com Overlay Arquitetônico -->
    <div class="absolute inset-0 z-0">
      <img 
        src={item.imagemCapa} 
        alt={item.titulo} 
        class="w-full h-full object-cover object-center brightness-[0.38] scale-100"
        loading="eager"
      />
      <div class="absolute inset-0 hero-overlay"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full my-auto">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8">
        <div class="max-w-3xl space-y-3">
          <div class="animate-hero-1 inline-flex items-center gap-3">
            <span class={`inline-flex items-center px-3.5 py-1 text-[11px] font-bold uppercase tracking-widest border backdrop-blur-md ${statusStyles[item.status]}`}>
              {item.statusLabel}
            </span>
            <span class="text-xs uppercase tracking-widest text-neutral-300 font-medium">
              {item.bairro}, {item.cidade} - {item.estado}
            </span>
          </div>

          <h1 class="animate-hero-2 text-3xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight uppercase leading-[1.1] font-heading">
            {item.titulo}
          </h1>
          
          <p class="animate-hero-3 text-sm sm:text-base lg:text-lg text-neutral-200 font-light max-w-2xl leading-relaxed">
            {item.subtitulo}
          </p>
        </div>

        
      </div>
    </div>
  </section>

  <!-- 2. QUICK SPECS FLUTUANTE (MOLDURA ARQUITETÔNICA ELEGANTE) -->
  <section class="relative z-20 -mt-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="reveal-up bg-white border border-lzba-border shadow-xl p-6 sm:p-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center divide-y md:divide-y-0 md:divide-x divide-lzba-border/80">
        <div class="pt-2 md:pt-0">
          <span class="block text-[11px] uppercase tracking-widest text-neutral-500 font-semibold">Metragem Privativa</span>
          <span class="text-xl sm:text-2xl font-bold text-lzba-dark font-heading mt-1.5 block">{item.metragem}</span>
        </div>
        <div class="pt-4 md:pt-0">
          <span class="block text-[11px] uppercase tracking-widest text-neutral-500 font-semibold">Dormitórios</span>
          <span class="text-xl sm:text-2xl font-bold text-lzba-dark font-heading mt-1.5 block">{item.dormitorios}</span>
        </div>
        <div class="pt-4 md:pt-0">
          <span class="block text-[11px] uppercase tracking-widest text-neutral-500 font-semibold">Suítes</span>
          <span class="text-xl sm:text-2xl font-bold text-lzba-dark font-heading mt-1.5 block">{item.suites}</span>
        </div>
        <div class="pt-4 md:pt-0">
          <span class="block text-[11px] uppercase tracking-widest text-neutral-500 font-semibold">Vagas de Garagem</span>
          <span class="text-xl sm:text-2xl font-bold text-lzba-dark font-heading mt-1.5 block">{item.vagas}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. CONTEÚDO PRINCIPAL (SOBRE + GALERIA + DIFERENCIAIS + PLANTAS + EVOLUÇÃO + FORMULÁRIO) -->
  <section class="py-16 sm:py-16 bg-neutral-50/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14">
        
        <!-- Coluna Esquerda: Descrição, Galeria, Diferenciais, Plantas, Evolução, Localização -->
        <div class="lg:col-span-8 space-y-16">
          
          <div class="animate-hero-4 flex flex-wrap items-center gap-3 shrink-0">
          <a
            href={item.hotsite}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 text-xs font-bold uppercase tracking-widest text-lzba-dark bg-white hover:bg-lzba-light transition-all duration-300 shadow-md flex items-center gap-2.5 border border-lzba-gold cursor-pointer"
          >
      
            <span>HOTSITE</span>
          </a>
          <a
            href={item.tourVirtual}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 text-xs font-bold uppercase tracking-widest text-lzba-dark bg-white hover:bg-lzba-light transition-all duration-300 shadow-md flex items-center gap-2.5 border border-lzba-gold cursor-pointer"
          > 
            Tour Virtual
          </a>
        </div>



          <!-- Descrição -->
          <div class="reveal-up space-y-4">
            <span class="text-xs uppercase font-bold tracking-widest text-lzba-gold block font-sans">
              CONCEITO & PROJETO
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold text-lzba-dark font-heading tracking-tight">
              Sobre o Empreendimento
            </h2>
            <div class="w-12 h-0.5 bg-lzba-gold my-2"></div>
            <p class="text-neutral-700 text-base sm:text-lg leading-relaxed font-light">
              {item.descricaoCompleta}
            </p>
          </div>

          <!-- Galeria de Imagens -->
          <div class="reveal-up space-y-6">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-xs uppercase font-bold tracking-widest text-lzba-gold block font-sans">
                  PERSPECTIVAS & REGISTROS
                </span>
                <h2 class="text-2xl sm:text-3xl font-bold text-lzba-dark font-heading tracking-tight">
                  Galeria do Projeto
                </h2>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              {item.galeria.map((img, idx) => (
                <button
                  type="button"
                  class="gallery-trigger group relative border border-lzba-border p-1.5 sm:p-2 bg-white shadow-2xs overflow-hidden transition-all duration-300 hover:border-lzba-gold cursor-zoom-in text-left block w-full focus:outline-none focus:ring-2 focus:ring-lzba-gold"
                  data-gallery="projeto"
                  data-index={idx}
                  data-src={img}
                  data-alt={`${item.titulo} - Foto ${idx + 1}`}
                  aria-label={`Ver imagem ${idx + 1} ampliada`}
                >
                  <div class="relative overflow-hidden aspect-16/10 bg-neutral-100">
                    <img 
                      src={img} 
                      alt={`${item.titulo} - Imagem ${idx + 1}`}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                      loading="lazy"
                    />
                    <!-- Overlay sutil com ícone de expansão no hover -->
                    <div class="absolute inset-0 bg-neutral-950/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                      <div class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-white flex items-center justify-center shadow-lg transform scale-90 group-hover:scale-100 transition-transform duration-300">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/>
                        </svg>
                      </div>
                    </div>
                  </div>
                </button>
              ))}
            </div>
          </div>

          <!-- Diferenciais Exclusivos -->
          <div class="reveal-up space-y-6">
            <div>
              <span class="text-xs uppercase font-bold tracking-widest text-lzba-gold block font-sans">
                INFRAESTRUTURA & BEM-ESTAR
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold text-lzba-dark font-heading tracking-tight">
                Diferenciais do Condomínio
              </h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              {item.diferenciais.map((dif) => (
                <div class="flex items-center gap-3.5 p-4 bg-white border border-lzba-border shadow-2xs hover:border-lzba-gold/50 transition-colors">
                  <div class="w-6 h-6 rounded-full bg-lzba-gold/15 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-sm font-medium text-neutral-800">{dif}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Galeria de Plantas Humanizadas Disponíveis -->
          {plantasComImagem.length > 0 && (
            <div class="reveal-up space-y-6">
              <div>
                <span class="text-xs uppercase font-bold tracking-widest text-lzba-gold block font-sans">
                  DISTRIBUIÇÃO INTELIGENTE
                </span>
                <h2 class="text-2xl sm:text-3xl font-bold text-lzba-dark font-heading tracking-tight">
                  Opções de Plantas
                </h2>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                {plantasComImagem.map((planta, idx) => (
                  <div class="border border-lzba-border bg-white shadow-2xs hover:border-lzba-gold transition-all duration-300 flex flex-col justify-between overflow-hidden">
                    <!-- Imagem da Planta com Gatilho de Zoom -->
                    <button
                      type="button"
                      class="gallery-trigger group relative p-3 bg-neutral-50/80 border-b border-lzba-border overflow-hidden cursor-zoom-in text-left block w-full focus:outline-none focus:ring-2 focus:ring-lzba-gold"
                      data-gallery="plantas"
                      data-index={idx}
                      data-src={planta.imagem}
                      data-alt={`${planta.titulo} (${planta.metragem})`}
                      aria-label={`Ver planta ampliada: ${planta.titulo}`}
                    >
                      <div class="relative overflow-hidden aspect-4/3 bg-white border border-lzba-border/60 p-2 flex items-center justify-center">
                        <img 
                          src={planta.imagem} 
                          alt={`${planta.titulo} - ${planta.metragem}`}
                          class="w-full h-full object-contain transition-transform duration-700 group-hover:scale-105"
                          loading="lazy"
                        />
                        <!-- Overlay com ícone de expansão no hover -->
                        <div class="absolute inset-0 bg-neutral-950/25 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                          <div class="w-10 h-10 rounded-full bg-white/30 backdrop-blur-md border border-white/40 text-white flex items-center justify-center shadow-lg transform scale-90 group-hover:scale-100 transition-transform duration-300">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"/>
                            </svg>
                          </div>
                        </div>
                      </div>
                    </button>

                    <!-- Informações da Planta -->
                    <div class="p-5 space-y-3 flex-1 flex flex-col justify-between">
                      <div>
                        <div class="flex items-start justify-between gap-3">
                          <h3 class="text-base sm:text-lg font-bold text-lzba-dark font-heading leading-tight">{planta.titulo}</h3>
                          <span class="px-2.5 py-1 bg-lzba-gold/15 text-amber-900 border border-lzba-gold/30 text-xs font-bold uppercase tracking-wider shrink-0">
                            {planta.metragem}
                          </span>
                        </div>
                        {planta.descricao && (
                          <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed font-light mt-2">{planta.descricao}</p>
                        )}
                      </div>


                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Status / Acompanhamento de Obras -->
          {item.estagioObras && (
            <div class="reveal-up space-y-6">
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xs uppercase font-bold tracking-widest text-lzba-gold block font-sans">
                    CRONOGRAMA CONSTRUTIVO
                  </span>
                  <h2 class="text-2xl sm:text-3xl font-bold text-lzba-dark font-heading tracking-tight">
                    Evolução da Obra
                  </h2>
                </div>
              </div>

              <div class="bg-white p-6 sm:p-8 border border-lzba-border shadow-2xs space-y-6">
                <!-- Barra Geral -->
                <div>
                  <div class="flex justify-between text-xs text-neutral-700 mb-2 font-semibold uppercase tracking-wider">
                    <span>Progresso Geral da Obra</span>
                    <span class="text-lzba-dark font-bold text-sm">{item.estagioObras.geral}%</span>
                  </div>
                  <div class="w-full bg-neutral-200 h-3 rounded-full overflow-hidden">
                    <div class="bg-lzba-gold h-3 rounded-full transition-all duration-1000" style={`width: ${item.estagioObras.geral}%`}></div>
                  </div>
                </div>

                <!-- Detalhes por Etapa -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-5 border-t border-lzba-border text-xs">
                  <div>
                    <div class="flex justify-between text-neutral-600 mb-1.5 font-medium">
                      <span>Fundação</span>
                      <span class="text-lzba-dark font-bold">{item.estagioObras.fundacao}%</span>
                    </div>
                    <div class="w-full bg-neutral-200 h-2 rounded-full overflow-hidden">
                      <div class="bg-lzba-gold/30 h-2 rounded-full" style={`width: ${item.estagioObras.fundacao}%`}></div>
                    </div>
                  </div>

                  <div>
                    <div class="flex justify-between text-neutral-600 mb-1.5 font-medium">
                      <span>Estrutura</span>
                      <span class="text-lzba-dark font-bold">{item.estagioObras.estrutura}%</span>
                    </div>
                    <div class="w-full bg-neutral-200 h-2 rounded-full overflow-hidden">
                      <div class="bg-lzba-gold/30 h-2 rounded-full" style={`width: ${item.estagioObras.estrutura}%`}></div>
                    </div>
                  </div>

                  <div>
                    <div class="flex justify-between text-neutral-600 mb-1.5 font-medium">
                      <span>Alvenaria</span>
                      <span class="text-lzba-dark font-bold">{item.estagioObras.alvenaria}%</span>
                    </div>
                    <div class="w-full bg-neutral-200 h-2 rounded-full overflow-hidden">
                      <div class="bg-lzba-gold/30 h-2 rounded-full" style={`width: ${item.estagioObras.alvenaria}%`}></div>
                    </div>
                  </div>

                  <div>
                    <div class="flex justify-between text-neutral-600 mb-1.5 font-medium">
                      <span>Acabamento</span>
                      <span class="text-lzba-dark font-bold">{item.estagioObras.acabamento}%</span>
                    </div>
                    <div class="w-full bg-neutral-200 h-2 rounded-full overflow-hidden">
                      <div class="bg-lzba-gold/30 h-2 rounded-full" style={`width: ${item.estagioObras.acabamento}%`}></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}

          <!-- Localização e Endereço -->
          <div class="reveal-up space-y-4">
            <span class="text-xs uppercase font-bold tracking-widest text-lzba-gold block font-sans">
              ENDEREÇO
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold text-lzba-dark font-heading tracking-tight">
              Localização Privilegiada
            </h2>
            <div class="bg-white p-6 sm:p-8 border border-lzba-border shadow-2xs space-y-4">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-lzba-gold/15 flex items-center justify-center shrink-0 text-amber-800">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="text-base sm:text-lg font-bold text-lzba-dark font-heading">{item.endereco}</h3>
                  <p class="text-sm text-neutral-500 mt-0.5">{item.bairro}, {item.cidade} - {item.estado}</p>
                </div>
              </div>
              <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed border-t border-lzba-border pt-4 font-light">
                Região valorizada e consolidada com completa infraestrutura de serviços, comércios, conveniência, gastronomia refinada e rápido acesso às principais vias da Zona Norte e da capital paulista.
              </p>
            </div>
          </div>

        </div>

        <!-- Coluna Direita: Formulário Flutuante de Contato / Atendimento -->
        <div class="lg:col-span-4" id="formulario">
          <div class="sticky top-28 bg-white border border-lzba-border border-t-4 border-t-lzba-gold shadow-xl p-6 sm:p-8 space-y-6">
            
            <div class="space-y-2">
              <span class="text-xs font-bold uppercase tracking-widest text-lzba-gold block font-sans">
                ATENDIMENTO EXCLUSIVO
              </span>
              <h3 class="text-xl sm:text-2xl font-bold text-lzba-dark font-heading leading-tight">
                Interessado no {item.titulo}?
              </h3>
              <p class="text-xs text-neutral-500 leading-relaxed font-light">
                Fale agora com a nossa equipe comercial para receber a tabela de vendas atualizada e agendar uma visita.
              </p>
            </div>

            <!-- Botão WhatsApp Direto -->
            <a
              href={whatsappCustomLink}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-center gap-2.5 py-3.5 px-4 text-xs font-bold uppercase tracking-widest text-lzba-dark bg-lzba-gold hover:bg-amber-400 shadow-md transition-all duration-300 border border-lzba-gold cursor-pointer"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.149.929 3.182 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.288.043.088.072.189.014.305-.058.115-.087.188-.173.289l-.26.309c-.087.086-.179.18-.077.355.101.173.45 0.742.966 1.202.665.592 1.226.776 1.399.863.173.086.275.072.376-.044.101-.116.433-.506.549-.679.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.044.073.044.419-.1 0.824z"/>
              </svg>
              <span>Plantão no WhatsApp</span>
            </a>

            <div class="relative flex items-center justify-center my-4">
              <div class="border-t border-lzba-border w-full"></div>
              <span class="bg-white px-3 text-[11px] text-neutral-400 uppercase tracking-widest">ou envie seus dados</span>
            </div>

            <!-- Formulário -->
            <form class="space-y-3.5" action="/contato" method="GET">
              <input type="hidden" name="empreendimento" value={item.titulo} />
              
              <div>
                <label for="lead-name" class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1">Nome Completo</label>
                <input
                  type="text"
                  id="lead-name"
                  name="nome"
                  required
                  placeholder="Seu nome"
                  class="w-full px-3.5 py-2.5 bg-neutral-50 border border-lzba-border text-neutral-900 placeholder-neutral-400 text-sm focus:outline-none focus:border-lzba-gold focus:bg-white transition-colors"
                />
              </div>

              <div>
                <label for="lead-email" class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1">E-mail</label>
                <input
                  type="email"
                  id="lead-email"
                  name="email"
                  required
                  placeholder="seu@email.com"
                  class="w-full px-3.5 py-2.5 bg-neutral-50 border border-lzba-border text-neutral-900 placeholder-neutral-400 text-sm focus:outline-none focus:border-lzba-gold focus:bg-white transition-colors"
                />
              </div>

              <div>
                <label for="lead-phone" class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1">Telefone / WhatsApp</label>
                <input
                  type="tel"
                  id="lead-phone"
                  name="telefone"
                  required
                  placeholder="(11) 90000-0000"
                  class="w-full px-3.5 py-2.5 bg-neutral-50 border border-lzba-border text-neutral-900 placeholder-neutral-400 text-sm focus:outline-none focus:border-lzba-gold focus:bg-white transition-colors"
                />
              </div>

              <button
                type="submit"
                class="w-full py-3.5 px-4 text-xs font-bold uppercase tracking-widest text-white bg-lzba-dark hover:bg-neutral-800 transition-colors shadow-sm cursor-pointer"
              >
                Enviar Mensagem
              </button>

              <p class="text-[11px] text-neutral-500 text-center leading-relaxed font-light">
                Seus dados estão protegidos conforme nossa <a href="/politica-de-privacidade" class="text-neutral-700 underline hover:text-lzba-gold">Política de Privacidade</a>.
              </p>
            </form>

          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 4. BANNER INSTITUCIONAL DE FECHAMENTO -->
  <CtaSection />

  <!-- MODAL / LIGHTBOX DA GALERIA COM EFEITO GLASSMORPHISM -->
  <div
    id="gallery-modal"
    class="fixed inset-0 z-50 hidden opacity-0 transition-opacity duration-300 items-center justify-center p-4 sm:p-6 md:p-10"
    role="dialog"
    aria-modal="true"
    aria-label="Galeria em tela cheia"
  >
    <!-- Fundo Glassmorphism (Vidro Fosco Refinado com Blur Elevado) -->
    <div
      id="gallery-backdrop"
      class="absolute inset-0 bg-neutral-950/80 backdrop-blur-xl backdrop-saturate-150 transition-all duration-300"
    ></div>

    <!-- Botão Fechar -->
    <button
      id="gallery-close"
      type="button"
      aria-label="Fechar visualização"
      class="absolute top-4 right-4 sm:top-6 sm:right-6 z-30 w-11 h-11 flex items-center justify-center rounded-full bg-white/10 hover:bg-white/25 text-white border border-white/20 backdrop-blur-md transition-all duration-200 cursor-pointer focus:outline-none focus:ring-2 focus:ring-lzba-gold"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <!-- Botão Imagem Anterior -->
    <button
      id="gallery-prev"
      type="button"
      aria-label="Imagem anterior"
      class="absolute left-3 sm:left-6 z-30 w-11 h-11 hidden sm:flex items-center justify-center rounded-full bg-white/10 hover:bg-white/25 text-white border border-white/20 backdrop-blur-md transition-all duration-200 cursor-pointer focus:outline-none focus:ring-2 focus:ring-lzba-gold"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
    </button>

    <!-- Botão Próxima Imagem -->
    <button
      id="gallery-next"
      type="button"
      aria-label="Próxima imagem"
      class="absolute right-3 sm:right-6 z-30 w-11 h-11 hidden sm:flex items-center justify-center rounded-full bg-white/10 hover:bg-white/25 text-white border border-white/20 backdrop-blur-md transition-all duration-200 cursor-pointer focus:outline-none focus:ring-2 focus:ring-lzba-gold"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </button>

    <!-- Container da Imagem Ampliada com Moldura de Vidro -->
    <div class="relative z-20 max-w-5xl w-full max-h-[90vh] flex flex-col items-center select-none pointer-events-auto">
      <div class="relative p-2 sm:p-3 bg-white/10 border border-white/20 rounded-2xl backdrop-blur-2xl shadow-2xl overflow-hidden max-h-[78vh] flex items-center justify-center">
        <img
          id="gallery-modal-img"
          src=""
          alt=""
          class="max-w-full max-h-[74vh] w-auto h-auto object-contain rounded-xl shadow-inner transition-transform duration-300"
        />
      </div>

      <!-- Barra de Identificação com Glassmorphism -->
      <div class="mt-4 px-4 py-2 rounded-full bg-neutral-900/60 border border-white/15 backdrop-blur-md text-xs tracking-wider uppercase text-neutral-200 font-medium flex items-center gap-3 shadow-lg">
        <span id="gallery-counter" class="text-lzba-gold font-bold font-sans"></span>
        <span class="w-1 h-1 rounded-full bg-white/40"></span>
        <span id="gallery-caption" class="text-neutral-300 font-light truncate max-w-55 sm:max-w-md"></span>
      </div>
    </div>
  </div>

  <script is:inline>
    const initGalleryModal = () => {
      const modal = document.getElementById('gallery-modal');
      const backdrop = document.getElementById('gallery-backdrop');
      const closeBtn = document.getElementById('gallery-close');
      const prevBtn = document.getElementById('gallery-prev');
      const nextBtn = document.getElementById('gallery-next');
      const modalImg = document.getElementById('gallery-modal-img');
      const counterEl = document.getElementById('gallery-counter');
      const captionEl = document.getElementById('gallery-caption');
      const triggers = Array.from(document.querySelectorAll('.gallery-trigger'));

      if (!modal || !modalImg || !triggers.length) return;

      let activeGroupTriggers = [];
      let currentIndex = 0;

      const updateModalImage = (index) => {
        if (!activeGroupTriggers.length) return;
        if (index < 0) index = activeGroupTriggers.length - 1;
        if (index >= activeGroupTriggers.length) index = 0;
        currentIndex = index;

        const trigger = activeGroupTriggers[currentIndex];
        const src = trigger.getAttribute('data-src') || '';
        const alt = trigger.getAttribute('data-alt') || '';

        modalImg.src = src;
        modalImg.alt = alt;
        if (counterEl) counterEl.textContent = `${currentIndex + 1} / ${activeGroupTriggers.length}`;
        if (captionEl) captionEl.textContent = alt;

        if (prevBtn) prevBtn.style.display = activeGroupTriggers.length > 1 ? '' : 'none';
        if (nextBtn) nextBtn.style.display = activeGroupTriggers.length > 1 ? '' : 'none';
      };

      const openModal = (trigger) => {
        const group = trigger.getAttribute('data-gallery') || 'default';
        activeGroupTriggers = Array.from(document.querySelectorAll(`.gallery-trigger[data-gallery="${group}"]`));
        if (!activeGroupTriggers.length) {
          activeGroupTriggers = [trigger];
        }
        const index = activeGroupTriggers.indexOf(trigger);
        updateModalImage(index >= 0 ? index : 0);

        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(() => {
          modal.classList.remove('opacity-0');
          modal.classList.add('opacity-100');
        });
      };

      const closeModal = () => {
        modal.classList.remove('opacity-100');
        modal.classList.add('opacity-0');
        setTimeout(() => {
          modal.classList.remove('flex');
          modal.classList.add('hidden');
          document.body.style.overflow = '';
          modalImg.src = '';
        }, 200);
      };

      triggers.forEach((trigger) => {
        trigger.onclick = () => openModal(trigger);
      });

      if (closeBtn) closeBtn.onclick = closeModal;
      if (backdrop) backdrop.onclick = closeModal;

      if (prevBtn) {
        prevBtn.onclick = (e) => {
          e.stopPropagation();
          updateModalImage(currentIndex - 1);
        };
      }

      if (nextBtn) {
        nextBtn.onclick = (e) => {
          e.stopPropagation();
          updateModalImage(currentIndex + 1);
        };
      }

      const handleKeyDown = (e) => {
        if (modal.classList.contains('hidden')) return;
        if (e.key === 'Escape') closeModal();
        else if (e.key === 'ArrowLeft') updateModalImage(currentIndex - 1);
        else if (e.key === 'ArrowRight') updateModalImage(currentIndex + 1);
      };

      window.removeEventListener('keydown', handleKeyDown);
      window.addEventListener('keydown', handleKeyDown);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGalleryModal);
    } else {
      initGalleryModal();
    }
    document.addEventListener('astro:page-load', initGalleryModal);
  </script>
</Layout>
</file>

<file path="src/pages/empreendimentos/index.astro">
---
import Layout from "../../layouts/Layout.astro";
import BuildingCard from "../../components/BuildingCard.astro";
import CtaSection from "../../components/sections/CtaSection.astro";
import { EMPREENDIMENTOS } from "../../data/empreendimentos";

const totalProjetos = EMPREENDIMENTOS.length;
const totalDestaques = EMPREENDIMENTOS.filter((e) => e.destaque).length;
const totalLancamentos = EMPREENDIMENTOS.filter(
  (e) => e.status === "lancamento",
).length;
const totalEmObras = EMPREENDIMENTOS.filter(
  (e) => e.status === "em_obras",
).length;
const totalEntregues = EMPREENDIMENTOS.filter(
  (e) => e.status === "entregue",
).length;
---

<Layout
  title="Empreendimentos | Construtora e Incorporadora LZBA"
  description="Catálogo de empreendimentos LZBA: lançamentos, edifícios em construção e apartamentos entregues na Zona Norte e regiões nobres de São Paulo."
  currentPath="/empreendimentos"
  image="/images/02023-scaled-1.jpg"
>
  <!-- 1. HERO INSTITUCIONAL DE EMPREENDIMENTOS (PADRÃO ESTÉTICO DA HOME) -->
  <section
    class="relative pt-20 sm:pt-16 pb-16 overflow-hidden bg-lzba-dark text-white"
  >
    <!-- Imagem de Fundo com Overlay Arquitetônico -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/02023-scaled-1.jpg"
        alt="Empreendimentos LZBA na Zona Norte"
        class="w-full h-full object-cover object-top sm:object-center brightness-[0.4] scale-100"
        loading="eager"
      />
      <div class="absolute inset-0 hero-overlay"></div>
    </div>

    <div
      class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full my-auto"
    >
      <div class="max-w-3xl">
        <span
          class="animate-hero-1 text-xs uppercase font-bold tracking-widest text-lzba-gold block mb-3 font-sans"
        >
          PORTFÓLIO IMOBILIÁRIO • TRADIÇÃO NA ZONA NORTE
        </span>
        <h1
          class="animate-hero-2 text-3xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight uppercase leading-[1.12] font-heading"
        >
          Nossos Empreendimentos.
        </h1>
        <p
          class="animate-hero-3 text-sm sm:text-base lg:text-lg text-neutral-300 max-w-2xl mt-6 font-light leading-relaxed"
        >
          Projetos concebidos para proporcionar sofisticação, conforto acústico,
          funcionalidade real de plantas e valorização patrimonial consistente
          em endereços consolidados de São Paulo.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. BARRA DE FILTROS ARQUITETÔNICA -->
  <section
    class="bg-lzba-light border-b border-lzba-border/80 sticky top-20 z-30 shadow-2xs"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
      <div
        class="flex flex-wrap items-center justify-center sm:justify-start gap-2 sm:gap-3"
        id="filters-container"
      >
        <button
          type="button"
          data-filter="destaques"
          class="filter-btn active px-5 py-2.5 text-xs sm:text-sm font-semibold tracking-wider uppercase transition-all duration-200 border border-lzba-gold bg-lzba-gold text-lzba-dark shadow-xs cursor-pointer"
        >
          Oportunidades em Destaque ({totalDestaques})
        </button>

        <button
          type="button"
          data-filter="todos"
          class="filter-btn px-5 py-2.5 text-xs sm:text-sm font-semibold tracking-wider uppercase transition-all duration-200 border border-lzba-border bg-white text-neutral-700 hover:border-neutral-400 hover:text-neutral-900 shadow-2xs cursor-pointer"
        >
          Todos ({totalProjetos})
        </button>

        <button
          type="button"
          data-filter="lancamento"
          class="filter-btn px-5 py-2.5 text-xs sm:text-sm font-semibold tracking-wider uppercase transition-all duration-200 border border-lzba-border bg-white text-neutral-700 hover:border-neutral-400 hover:text-neutral-900 shadow-2xs cursor-pointer"
        >
          Lançamentos ({totalLancamentos})
        </button>

        <button
          type="button"
          data-filter="em_obras"
          class="filter-btn px-5 py-2.5 text-xs sm:text-sm font-semibold tracking-wider uppercase transition-all duration-200 border border-lzba-border bg-white text-neutral-700 hover:border-neutral-400 hover:text-neutral-900 shadow-2xs cursor-pointer"
        >
          Em Obras ({totalEmObras})
        </button>

        <button
          type="button"
          data-filter="entregue"
          class="filter-btn px-5 py-2.5 text-xs sm:text-sm font-semibold tracking-wider uppercase transition-all duration-200 border border-lzba-border bg-white text-neutral-700 hover:border-neutral-400 hover:text-neutral-900 shadow-2xs cursor-pointer"
        >
          Prontos / Entregues ({totalEntregues})
        </button>
      </div>
    </div>
  </section>

  <!-- 3. GRID DE EMPREENDIMENTOS -->
  <section class="py-16 sm:py-24 bg-white min-h-[50vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
        id="buildings-grid"
      >
        {
          EMPREENDIMENTOS.map((item) => (
            <div
              class="building-item"
              data-status={item.status}
              data-destaque={item.destaque ? "true" : "false"}
              style={item.destaque ? "display: block;" : "display: none;"}
            >
              <BuildingCard item={item} />
            </div>
          ))
        }
      </div>

      <!-- Estado Vazio (fallback dinâmico) -->
      <div
        id="no-results"
        class="hidden text-center py-20 p-8 border border-dashed border-lzba-border max-w-lg mx-auto"
      >
        <p class="text-neutral-500 text-base font-light">
          Nenhum empreendimento encontrado para a categoria selecionada.
        </p>
      </div>
    </div>
  </section>

  <!-- 4. CTA BANNER OFICIAL DA HOME -->
  <CtaSection />

  <!-- Script Leve de Filtragem (Zero dependências externas) -->
  <script is:inline>
    const setupFilters = () => {
      const buttons = document.querySelectorAll(".filter-btn");
      const items = document.querySelectorAll(".building-item");
      const noResults = document.getElementById("no-results");

      if (!buttons.length || !items.length) return;

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const filter = btn.getAttribute("data-filter");

          // Resetar todos os botões para o estado neutro
          buttons.forEach((b) => {
            b.classList.remove(
              "active",
              "bg-lzba-gold",
              "border-lzba-gold",
              "text-lzba-dark",
              "bg-lzba-dark",
              "text-white",
              "border-lzba-dark",
            );
            b.classList.add(
              "bg-white",
              "text-neutral-700",
              "border-lzba-border",
            );
          });

          // Ativar o botão clicado
          btn.classList.remove(
            "bg-white",
            "text-neutral-700",
            "border-lzba-border",
          );
          if (filter === "destaques") {
            btn.classList.add(
              "active",
              "bg-lzba-gold",
              "border-lzba-gold",
              "text-lzba-dark",
              "shadow-xs",
            );
          } else {
            btn.classList.add(
              "active",
              "bg-lzba-dark",
              "border-lzba-dark",
              "text-white",
              "shadow-xs",
            );
          }

          // Filtrar os cards
          let visibleCount = 0;
          items.forEach((item) => {
            const status = item.getAttribute("data-status");
            const isDestaque = item.getAttribute("data-destaque") === "true";

            let matches = false;
            if (filter === "todos") {
              matches = true;
            } else if (filter === "destaques") {
              matches = isDestaque;
            } else {
              matches = status === filter;
            }

            if (matches) {
              item.style.display = "block";
              visibleCount++;
            } else {
              item.style.display = "none";
            }
          });

          if (noResults) {
            noResults.style.display = visibleCount === 0 ? "block" : "none";
          }
        });
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupFilters);
    } else {
      setupFilters();
    }

    document.addEventListener("astro:page-load", setupFilters);
  </script>
</Layout>
</file>

<file path="src/pages/politica-de-privacidade.astro">
---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import { CONTATO_LZBA } from '../data/empreendimentos';

const dataAtualizacao = 'Outubro de 2026';
---

<Layout
  title="Política de Privacidade e LGPD | Construtora e Incorporadora LZBA"
  description="Conheça a Política de Privacidade e Proteção de Dados da Construtora e Incorporadora LZBA, em conformidade com a LGPD (Lei nº 13.709/2018)."
  currentPath="/politica-de-privacidade"
>
  <!-- 1. HERO INSTITUCIONAL (PADRÃO LZBA) -->
  <section class="relative pt-24 pb-16 sm:pb-20 overflow-hidden bg-lzba-dark text-white">
    <!-- Imagem de Fundo com Overlay Arquitetônico -->
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 hero-overlay"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full my-auto">
      <div class="max-w-3xl">
        <span class="animate-hero-1 text-xs uppercase font-bold tracking-widest text-lzba-gold block mb-3 font-sans">
          GOVERNANÇA • LGPD • TRANSPARÊNCIA
        </span>
        <h1 class="animate-hero-2 text-3xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight uppercase leading-[1.12] font-heading">
          Política de<br />Privacidade
        </h1>
        <p class="animate-hero-3 text-sm sm:text-base lg:text-lg text-neutral-300 max-w-2xl mt-4 font-light leading-relaxed">
          Em total conformidade com a Lei Geral de Proteção de Dados Pessoais (LGPD - Lei Federal nº 13.709/2018). Conheça nossas diretrizes de governança, sigilo e tratamento de dados.
        </p>

        <div class="animate-hero-4 inline-flex items-center gap-2.5 mt-6 px-4 py-2 bg-white/10 border border-white/15 text-xs text-neutral-300 backdrop-blur-xs font-sans tracking-wide">
          <svg class="w-3.5 h-3.5 text-lzba-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Última atualização: <strong>{dataAtualizacao}</strong></span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. RESUMO DE DIRETRIZES (MOLDURA ARQUITETÔNICA ELEGANTE) -->
  <section class="relative z-20 -mt-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="reveal-up bg-white border border-lzba-border shadow-xl p-6 sm:p-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center divide-y md:divide-y-0 md:divide-x divide-lzba-border/80">
        <div class="pt-2 md:pt-0">
          <span class="block text-[11px] uppercase tracking-widest text-neutral-500 font-semibold font-sans">Finalidade Legítima</span>
          <span class="text-base sm:text-lg font-bold text-lzba-dark font-heading mt-1 block">Não comercializamos dados</span>
          <p class="text-xs text-neutral-600 mt-1 font-light">Uso restrito para atendimento e contratos</p>
        </div>
        <div class="pt-4 md:pt-0">
          <span class="block text-[11px] uppercase tracking-widest text-neutral-500 font-semibold font-sans">Direitos do Titular</span>
          <span class="text-base sm:text-lg font-bold text-lzba-dark font-heading mt-1 block">Controle e Transparência</span>
          <p class="text-xs text-neutral-600 mt-1 font-light">Acesso, correção ou exclusão a qualquer momento</p>
        </div>
        <div class="pt-4 md:pt-0">
          <span class="block text-[11px] uppercase tracking-widest text-neutral-500 font-semibold font-sans">Segurança Técnica</span>
          <span class="text-base sm:text-lg font-bold text-lzba-dark font-heading mt-1 block">Sigilo & Proteção</span>
          <p class="text-xs text-neutral-600 mt-1 font-light">Padrões rígidos de infraestrutura e criptografia</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. CONTEÚDO JURÍDICO ESTRUTURADO -->
  <section class="py-16 sm:py-24 bg-neutral-50/60">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-white border border-lzba-border shadow-xs p-8 sm:p-14 space-y-12">
        
        <!-- 1. Introdução -->
        <article class="reveal-up space-y-4">
          <span class="text-xs uppercase font-bold tracking-widest text-lzba-gold block font-sans">
            SEÇÃO 01
          </span>
          <h2 class="text-xl sm:text-2xl font-bold text-lzba-dark font-heading tracking-tight">
            1. Introdução e Compromisso com a Privacidade
          </h2>
          <div class="w-10 h-0.5 bg-lzba-gold"></div>
          <p class="text-neutral-700 leading-relaxed font-light text-sm sm:text-base">
            A <strong>LZBA Incorporadora de Imóveis Ltda.</strong> ("LZBA"), pessoa jurídica de direito privado com sede na cidade de São Paulo - SP, reconhece a extrema importância da privacidade e da proteção de dados pessoais de seus clientes, parceiros comerciais, corretores e visitantes do website.
          </p>
          <p class="text-neutral-700 leading-relaxed font-light text-sm sm:text-base">
            Esta Política de Privacidade descreve de forma clara e transparente como coletamos, utilizamos, armazenamos, compartilhamos e protegemos os seus Dados Pessoais em rigorosa conformidade com a Lei Geral de Proteção de Dados Pessoais (Lei Federal nº 13.709/2018 - "LGPD").
          </p>
        </article>

        <div class="border-t border-lzba-border/80"></div>

        <!-- 2. Dados Coletados -->
        <article class="reveal-up space-y-4">
          <span class="text-xs uppercase font-bold tracking-widest text-lzba-gold block font-sans">
            SEÇÃO 02
          </span>
          <h2 class="text-xl sm:text-2xl font-bold text-lzba-dark font-heading tracking-tight">
            2. Quais Dados Pessoais Coletamos
          </h2>
          <div class="w-10 h-0.5 bg-lzba-gold"></div>
          <p class="text-neutral-700 leading-relaxed font-light text-sm sm:text-base">
            Podemos coletar as seguintes categorias de dados fornecidas voluntariamente por você ao preencher nossos formulários de contato, solicitar tabelas de vendas ou interagir via WhatsApp oficial:
          </p>
          
          <div class="grid grid-cols-1 gap-3.5 pt-2">
            <div class="p-4 bg-neutral-50/80 border border-lzba-border flex items-start gap-3.5">
              <div class="w-6 h-6 rounded-full bg-lzba-gold/15 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div class="text-xs sm:text-sm text-neutral-700">
                <strong class="text-lzba-dark">Dados de Identificação:</strong> Nome completo, endereço de e-mail e número de telefone celular / WhatsApp.
              </div>
            </div>

            <div class="p-4 bg-neutral-50/80 border border-lzba-border flex items-start gap-3.5">
              <div class="w-6 h-6 rounded-full bg-lzba-gold/15 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div class="text-xs sm:text-sm text-neutral-700">
                <strong class="text-lzba-dark">Dados de Corretores e Imobiliárias:</strong> Número de registro no CRECI, nome da imobiliária vinculada e região de atuação.
              </div>
            </div>

            <div class="p-4 bg-neutral-50/80 border border-lzba-border flex items-start gap-3.5">
              <div class="w-6 h-6 rounded-full bg-lzba-gold/15 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div class="text-xs sm:text-sm text-neutral-700">
                <strong class="text-lzba-dark">Dados de Proprietários de Terrenos:</strong> Endereço, dimensões e características do imóvel submetido para avaliação técnica de incorporação.
              </div>
            </div>

            <div class="p-4 bg-neutral-50/80 border border-lzba-border flex items-start gap-3.5">
              <div class="w-6 h-6 rounded-full bg-lzba-gold/15 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div class="text-xs sm:text-sm text-neutral-700">
                <strong class="text-lzba-dark">Dados de Navegação Técnica:</strong> Endereço IP, tipo de navegador, registros de data/hora e cookies essenciais para o funcionamento e estabilidade do portal.
              </div>
            </div>
          </div>
        </article>

        <div class="border-t border-lzba-border/80"></div>

        <!-- 3. Finalidades -->
        <article class="reveal-up space-y-4">
          <span class="text-xs uppercase font-bold tracking-widest text-lzba-gold block font-sans">
            SEÇÃO 03
          </span>
          <h2 class="text-xl sm:text-2xl font-bold text-lzba-dark font-heading tracking-tight">
            3. Finalidades e Bases Legais do Tratamento
          </h2>
          <div class="w-10 h-0.5 bg-lzba-gold"></div>
          <p class="text-neutral-700 leading-relaxed font-light text-sm sm:text-base">
            Utilizamos os seus dados pessoais única e exclusivamente para finalidades legítimas do setor imobiliário, destacando-se:
          </p>
          <ul class="space-y-2.5 text-neutral-700 text-sm font-light">
            <li class="flex items-start gap-2.5">
              <span class="text-lzba-gold text-base leading-none font-bold mt-0.5">›</span>
              <span>Atendimento a solicitações de informações sobre empreendimentos, agendamento de visitas a apartamentos decorados e plantões de vendas;</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-lzba-gold text-base leading-none font-bold mt-0.5">›</span>
              <span>Envio de tabelas de vendas, espelhos de unidades e materiais de suporte a corretores credenciados;</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-lzba-gold text-base leading-none font-bold mt-0.5">›</span>
              <span>Elaboração de propostas preliminares de aquisição de unidades ou avaliação técnica de terrenos;</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-lzba-gold text-base leading-none font-bold mt-0.5">›</span>
              <span>Cumprimento de obrigações legais, regulatórias e fiscais inerentes à incorporação e construção civil;</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-lzba-gold text-base leading-none font-bold mt-0.5">›</span>
              <span>Exercício regular de direitos em contratos preliminares e processos administrativos ou judiciais.</span>
            </li>
          </ul>
        </article>

        <div class="border-t border-lzba-border/80"></div>

        <!-- 4. Compartilhamento -->
        <article class="reveal-up space-y-4">
          <span class="text-xs uppercase font-bold tracking-widest text-lzba-gold block font-sans">
            SEÇÃO 04
          </span>
          <h2 class="text-xl sm:text-2xl font-bold text-lzba-dark font-heading tracking-tight">
            4. Compartilhamento com Terceiros
          </h2>
          <div class="w-10 h-0.5 bg-lzba-gold"></div>
          <p class="text-neutral-700 leading-relaxed font-light text-sm sm:text-base">
            <strong>A LZBA não vende, não aluga e não comercializa dados pessoais sob nenhuma hipótese.</strong> O compartilhamento restringe-se ao estritamente necessário para a prestação dos serviços imobiliários:
          </p>
          <ul class="space-y-2.5 text-neutral-700 text-sm font-light">
            <li class="flex items-start gap-2.5">
              <span class="text-lzba-gold text-base leading-none font-bold mt-0.5">›</span>
              <span>Corretores de imóveis credenciados responsáveis pelo atendimento presencial e apresentação das unidades;</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-lzba-gold text-base leading-none font-bold mt-0.5">›</span>
              <span>Instituições financeiras e agentes de crédito imobiliário, mediante consentimento explícito do comprador para análise de financiamento;</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-lzba-gold text-base leading-none font-bold mt-0.5">›</span>
              <span>Prestadores de serviços de tecnologia essenciais à operação (hospedagem segura, CRM e segurança digital);</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-lzba-gold text-base leading-none font-bold mt-0.5">›</span>
              <span>Autoridades públicas ou cartórios de registro de imóveis quando exigido pela legislação vigente.</span>
            </li>
          </ul>
        </article>

        <div class="border-t border-lzba-border/80"></div>

        <!-- 5. Segurança -->
        <article class="reveal-up space-y-4">
          <span class="text-xs uppercase font-bold tracking-widest text-lzba-gold block font-sans">
            SEÇÃO 05
          </span>
          <h2 class="text-xl sm:text-2xl font-bold text-lzba-dark font-heading tracking-tight">
            5. Segurança e Retenção dos Dados
          </h2>
          <div class="w-10 h-0.5 bg-lzba-gold"></div>
          <p class="text-neutral-700 leading-relaxed font-light text-sm sm:text-base">
            Adotamos medidas técnicas, administrativas e organizacionais aptas a proteger seus dados contra acessos não autorizados, destruição, perda, alteração ou qualquer modalidade de tratamento inadequado ou ilícito.
          </p>
          <p class="text-neutral-700 leading-relaxed font-light text-sm sm:text-base">
            Os dados pessoais serão conservados pelo período necessário para cumprir as finalidades contratuais ou até eventual solicitação de revogação pelo titular, ressalvadas as hipóteses de guarda obrigatória por prazos legais de garantia construtiva e prescrição imobiliária.
          </p>
        </article>

        <div class="border-t border-lzba-border/80"></div>

        <!-- 6. Direitos do Titular -->
        <article class="reveal-up space-y-4">
          <span class="text-xs uppercase font-bold tracking-widest text-lzba-gold block font-sans">
            SEÇÃO 06
          </span>
          <h2 class="text-xl sm:text-2xl font-bold text-lzba-dark font-heading tracking-tight">
            6. Seus Direitos como Titular de Dados
          </h2>
          <div class="w-10 h-0.5 bg-lzba-gold"></div>
          <p class="text-neutral-700 leading-relaxed font-light text-sm sm:text-base">
            Nos termos do artigo 18 da Lei Federal nº 13.709/2018 (LGPD), você possui o direito de solicitar a qualquer momento, mediante requisição direta:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-2">
            <div class="p-3.5 bg-neutral-50 border border-lzba-border text-xs sm:text-sm text-neutral-700">
              <strong class="text-lzba-dark block mb-1">Confirmação & Acesso</strong>
              Saber se seus dados são tratados e solicitar cópia integral dos registros sob nossa guarda.
            </div>
            <div class="p-3.5 bg-neutral-50 border border-lzba-border text-xs sm:text-sm text-neutral-700">
              <strong class="text-lzba-dark block mb-1">Correção & Atualização</strong>
              Solicitar a retificação de dados pessoais incompletos, inexatos ou desatualizados.
            </div>
            <div class="p-3.5 bg-neutral-50 border border-lzba-border text-xs sm:text-sm text-neutral-700">
              <strong class="text-lzba-dark block mb-1">Anonimização ou Bloqueio</strong>
              Pedir a eliminação de dados considerados excessivos ou desnecessários para a finalidade.
            </div>
            <div class="p-3.5 bg-neutral-50 border border-lzba-border text-xs sm:text-sm text-neutral-700">
              <strong class="text-lzba-dark block mb-1">Revogação do Consentimento</strong>
              Revogar autorizações concedidas previamente para envio de novidades comerciais.
            </div>
          </div>
        </article>

        <div class="border-t border-lzba-border/80"></div>

        <!-- 7. Contato do Encarregado (DPO) -->
        <article class="reveal-up p-6 sm:p-8 bg-lzba-light border border-lzba-gold/40 space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-lzba-gold/20 flex items-center justify-center shrink-0 text-amber-900">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <span class="text-[11px] font-bold uppercase tracking-widest text-lzba-gold block font-sans">
                CANAL EXCLUSIVO LGPD
              </span>
              <h2 class="text-lg sm:text-xl font-bold text-lzba-dark font-heading">
                7. Canal de Contato do Encarregado (DPO)
              </h2>
            </div>
          </div>

          <p class="text-xs sm:text-sm text-neutral-700 leading-relaxed font-light">
            Para exercer qualquer um dos seus direitos de titular ou esclarecer qualquer dúvida referente ao tratamento de dados pela Construtora e Incorporadora LZBA, entre em contato direto com o nosso Encarregado de Proteção de Dados:
          </p>

          <div class="pt-2 border-t border-lzba-border/60 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
            <div>
              <span class="block text-[11px] uppercase tracking-wider text-neutral-500 font-semibold">E-mail do DPO</span>
              <a href={`mailto:${CONTATO_LZBA.email}`} class="text-lzba-dark font-bold hover:text-amber-800 underline transition-colors">
                {CONTATO_LZBA.email}
              </a>
            </div>
            <div>
              <span class="block text-[11px] uppercase tracking-wider text-neutral-500 font-semibold">Telefone Institucional</span>
              <a href={`tel:${CONTATO_LZBA.telefone.replace(/\D/g, '')}`} class="text-lzba-dark font-bold hover:text-amber-800 transition-colors">
                {CONTATO_LZBA.telefone}
              </a>
            </div>
          </div>
          
          <p class="text-[11px] text-neutral-500 font-light pt-1">
            * Por favor, mencione no assunto da mensagem: <em>"Privacidade e Proteção de Dados - LGPD"</em>.
          </p>
        </article>

      </div>

    </div>
  </section>

  <!-- 4. BANNER INSTITUCIONAL DE FECHAMENTO -->
  <CtaSection />
</Layout>
</file>

<file path="src/pages/trabalhe-conosco.astro">
---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import { CONTATO_LZBA } from '../data/empreendimentos';

const whatsappCorretoresLink = `https://wa.me/5511999618125?text=${encodeURIComponent('Olá! Sou corretor/imobiliária e gostaria de me credenciar para vender os empreendimentos da LZBA.')}`;
---

<Layout
  title="Trabalhe Conosco | Portal de Corretores e Imobiliárias LZBA"
  description="Cadastre-se como corretor parceiro ou imobiliária credenciada na Construtora LZBA. Tenha acesso a tabelas de vendas, espelhos de unidades, materiais de marketing e comissionamento garantido."
  currentPath="/trabalhe-conosco"
>
  <!-- 1. HERO INSTITUCIONAL (PADRÃO ESTÉTICO LZBA) -->
  <section class="relative pt-24 pb-16 sm:pb-20 overflow-hidden bg-lzba-dark text-white">
    <!-- Imagem de Fundo com Overlay Arquitetônico -->
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 hero-overlay"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full my-auto">
      <div class="max-w-3xl">
        <span class="animate-hero-1 text-xs uppercase font-bold tracking-widest text-lzba-gold block mb-3 font-sans">
          PARCERIAS COMERCIAIS • CANAL OFICIAL
        </span>
        <h1 class="animate-hero-2 text-3xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight uppercase leading-[1.12] font-heading">
          Canal de Corretores<br />e Imobiliárias
        </h1>
        <p class="animate-hero-3 text-sm sm:text-base lg:text-lg text-neutral-300 max-w-2xl mt-4 font-light leading-relaxed">
          Seja um parceiro credenciado da Construtora e Incorporadora LZBA. Tenha acesso a tabelas atualizadas de lançamentos e unidades prontas, espelhos de vendas em tempo real e comissionamento transparente com segurança jurídica.
        </p>

        <div class="animate-hero-4 flex flex-wrap items-center gap-3 mt-8">
          <a
            href={whatsappCorretoresLink}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 text-xs font-bold uppercase tracking-widest text-lzba-dark bg-lzba-gold hover:bg-amber-400 transition-all duration-300 shadow-md flex items-center gap-2.5 border border-lzba-gold cursor-pointer"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.149.929 3.182 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.288.043.088.072.189.014.305-.058.115-.087.188-.173.289l-.26.309c-.087.086-.179.18-.077.355.101.173.45 0.742.966 1.202.665.592 1.226.776 1.399.863.173.086.275.072.376-.044.101-.116.433-.506.549-.679.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.044.073.044.419-.1 0.824z"/>
            </svg>
            <span>Plantão de Parcerias</span>
          </a>
          <a
            href="#formulario"
            class="px-6 py-3.5 text-xs font-semibold uppercase tracking-widest text-white bg-white/10 hover:bg-white/20 border border-white/20 backdrop-blur-xs transition-all duration-300"
          >
            Formulário de Credenciamento
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. PILARES DO CORRETOR (MOLDURA ARQUITETÔNICA ELEGANTE) -->
  <section class="relative z-20 -mt-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="reveal-up bg-white border border-lzba-border shadow-xl p-6 sm:p-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center divide-y md:divide-y-0 md:divide-x divide-lzba-border/80">
        <div class="pt-2 md:pt-0">
