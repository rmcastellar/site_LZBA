<file path="src/components/sections/HeroSection.astro">
---
import { NUMEROS_LZBA } from "../../data/empreendimentos";
---

<!-- 1. HERO SECTION (ALINHADO AO TOPO DA TELA ATRÁS DO HEADER) -->
<section class="relative min-h-dvh flex flex-col justify-between pt-24 sm:pt-36 lg:pt-40 pb-8 sm:pb-12 overflow-hidden bg-lzba-dark">
  <!-- Imagem de Fundo com Overlay Quente e Arquitetônico -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/empreendimentos/arbore/img-arbore-gourmet.jpg"
      alt="Fachada Empreendimento LZBA"
      class="w-full h-full object-cover object-top sm:object-center brightness-[1] scale-100"
      loading="eager"
    />
    <!-- Overlay escuro arquitetônico derivado da paleta centralizada -->
    <div class="absolute inset-0 hero-overlay"></div>
  </div>

  <!-- Conteúdo Central do Hero -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full my-auto">
    <div class="max-w-3xl">
      <!-- Título em Caixa Alta e Peso Firme -->
      <h1 class="animate-hero-1 text-2xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight uppercase leading-[1.14] font-heading">
        Solidez técnica e <br class="hidden sm:inline" />
        tradição que valorizam <br class="hidden sm:inline" />o patrimônio da
        sua família.
      </h1>

      <!-- Subtítulo / Descrição fiel -->
      <p class="animate-hero-2 text-xs sm:text-base lg:text-lg text-neutral-300 max-w-2xl mt-4 sm:mt-6 font-light leading-relaxed">
        Há 34 anos transformando projetos em lares funcionais de alta
        consistência executiva. Mais de 1.340 apartamentos rigorosamente
        planejados, construídos e entregues.
      </p>

      <!-- Botão Nossos Projetos (Estilo Outline com Moldura) -->
      <div class="animate-hero-3 mt-6 sm:mt-10">
        <a
          href="#projetos"
          class="inline-block px-6 sm:px-8 py-3 sm:py-3.5 border border-white/60 hover:border-lzba-gold text-xs sm:text-sm font-semibold tracking-widest uppercase text-white hover:text-lzba-gold hover:bg-white/10 transition-all duration-200"
        >
          NOSSOS PROJETOS
        </a>
      </div>
    </div>
  </div>

  <!-- Barra de Métricas na Base do Hero (Separada por linha sutil) -->
  <div class="animate-hero-4 relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full mt-6 sm:mt-16">
    <div class="border-t border-white/20 pt-4 sm:pt-8">
      <div class="grid grid-cols-3 gap-4 sm:gap-12 max-w-3xl">
        <!-- Métrica 1 -->
        <div>
          <span class="block text-[9px] sm:text-xs uppercase tracking-wider text-lzba-muted font-semibold leading-tight">
            Anos de
            <br />
            Experiência
          </span>
          <span
            class="block text-2xl sm:text-5xl font-bold text-white mt-1 sm:mt-2 font-heading tabular-nums"
            data-hero-metric
            data-target={NUMEROS_LZBA.anosCarreira}
            aria-label={NUMEROS_LZBA.anosCarreira}
          >
            0
          </span>
        </div>

        <!-- Métrica 2 -->
        <div>
          <span class="block text-[9px] sm:text-xs uppercase tracking-wider text-lzba-muted font-semibold leading-tight">
            Empreendimentos
            <br />
            Entregues
          </span>
          <span
            class="block text-2xl sm:text-5xl font-bold text-white mt-1 sm:mt-2 font-heading tabular-nums"
            data-hero-metric
            data-target={NUMEROS_LZBA.obrasEntregues}
            aria-label={NUMEROS_LZBA.obrasEntregues}
          >
            0
          </span>
        </div>

        <!-- Métrica 3 -->
        <div>
          <span class="block text-[9px] sm:text-xs uppercase tracking-wider text-lzba-muted font-semibold leading-tight">
            Unidades
            <br />
            Entregues
          </span>
          <span
            class="block text-2xl sm:text-5xl font-bold text-white mt-1 sm:mt-2 font-heading tabular-nums"
            data-hero-metric
            data-target={NUMEROS_LZBA.aptosEntregues}
            aria-label={NUMEROS_LZBA.aptosEntregues}
          >
            0
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const METRIC_START_DELAY_MS = 550;
  const METRIC_DURATION_MS = 3000;

  function easeOutExpo(progress: number): number {
    return progress >= 1 ? 1 : 1 - Math.pow(2, -10 * progress);
  }

  function initHeroMetrics(): void {
    const metricElements =
      document.querySelectorAll<HTMLElement>("[data-hero-metric]");
    if (metricElements.length === 0) return;

    const formatter = new Intl.NumberFormat("pt-BR");
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const targets = Array.from(metricElements).map((el) => {
      const rawTarget = el.dataset.target ?? "0";
      const numericTarget = Number.parseInt(rawTarget.replace(/\D/g, ""), 10);
      return { el, rawTarget, numericTarget };
    });

    if (prefersReducedMotion) {
      for (const { el, rawTarget } of targets) {
        el.textContent = rawTarget;
        el.dataset.animated = "true";
      }
      return;
    }

    const pendingTargets = targets.filter(
      ({ el }) => el.dataset.animated !== "true",
    );
    if (pendingTargets.length === 0) return;

    for (const { el } of pendingTargets) {
      el.dataset.animated = "true";
      el.textContent = "0";
    }

    window.setTimeout(() => {
      const startTime = performance.now();

      function tick(now: number): void {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / METRIC_DURATION_MS, 1);
        const eased = easeOutExpo(progress);

        for (const { el, rawTarget, numericTarget } of pendingTargets) {
          if (!el.isConnected) continue;

          if (Number.isNaN(numericTarget) || numericTarget <= 0) {
            el.textContent = rawTarget;
            continue;
          }

          const currentValue = Math.round(numericTarget * eased);
          el.textContent =
            progress >= 1 ? rawTarget : formatter.format(currentValue);
        }

        if (progress < 1 && pendingTargets.some(({ el }) => el.isConnected)) {
          requestAnimationFrame(tick);
        }
      }

      requestAnimationFrame(tick);
    }, METRIC_START_DELAY_MS);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeroMetrics, {
      once: true,
    });
  } else {
    initHeroMetrics();
  }

  document.addEventListener("astro:page-load", initHeroMetrics);
</script>
</file>

<file path="src/components/Header.astro">
---
import { CONTATO_LZBA } from "../data/empreendimentos";

interface Props {
  currentPath?: string;
  transparent?: boolean;
}

const { currentPath = "/", transparent = false } = Astro.props;
const isHome =
  currentPath === "/" ||
  currentPath === "" ||
  currentPath === "/home" ||
  transparent;

const navLinks = [
  { href: "/", label: "INÍCIO" },
  { href: "/blog", label: "BLOG" },
  { href: "/empreendimentos", label: "NOSSOS PROJETOS" },
];

const navLinksDrawer = [
  { href: "/", label: "INÍCIO" },
  { href: "/#projetos?status=destaques", label: "OPORTUNIDADES" },
  { href: "/sobre", label: "SOBRE" },
  { href: "/empreendimentos", label: "NOSSOS PROJETOS" },
  { href: "/blog", label: "BLOG" },
  { href: "/trabalhe-conosco", label: "TRABALHE CONOSCO" },
  { href: "/contato", label: "CONTATO" },
];
---

<header
  id="main-header"
  data-transparent={isHome ? "true" : "false"}
  class={`w-full z-50 transition-all duration-300 ${
    isHome
      ? "fixed top-0 left-0 header-glass-transparent"
      : "sticky top-0 bg-lzba-dark/95 backdrop-blur-md border-b border-white/10"
  }`}
>
  <!-- Input invisível de controle do Drawer Menu -->
  <input
    type="checkbox"
    id="mobile-menu-toggle"
    class="drawer-checkbox hidden"
  />

  <div class="max-w-full mx-auto px-4 sm:px-6 lg:px-8 relative z-50 bg-inherit">
    <div class="flex items-center justify-between h-20 gap-x-5">
      <!-- Logo LZBA -->
      <a
        href="/"
        class="flex items-center gap-3 group"
        aria-label="Página inicial LZBA"
      >
        <img
          src="/images/logo.png"
          alt="LZBA Construtora e Incorporadora"
          class="h-9 sm:h-11 w-auto object-contain transition-transform duration-300 group-hover:opacity-90"
          width="170"
          height="44"
        />
      </a>

      <!-- Direita: Navegação + Botão Oportunidades + Menu Hambúrguer -->
      <div class="flex items-center gap-6 lg:gap-8">
        <!-- Desktop Navigation (visível em telas grandes para layout refinado e sem aperto) -->
        <nav
          class="hidden lg:flex items-center gap-6 lg:gap-8"
          aria-label="Navegação Principal"
        >
          {
            navLinks.map((link) => {
              const isActive =
                currentPath === link.href ||
                (link.href !== "/" && currentPath.startsWith(link.href));
              return (
                <a
                  href={link.href}
                  class={`text-xs font-semibold tracking-widest uppercase transition-colors duration-200 py-1 border-b-2 ${
                    isActive
                      ? "text-white border-lzba-gold"
                      : "text-neutral-300 hover:text-lzba-light border-transparent"
                  }`}
                >
                  {link.label}
                </a>
              );
            })
          }

          <!-- Botão Oportunidades com Contorno e Cor de Preenchimento -->
          <a
            href="/#projetos?status=destaques"
            id="header-btn-oportunidades"
            data-filter-trigger="destaques"
            class="px-4 py-2 border border-white/40 bg-white/20 hover:bg-white/35 hover:border-white text-white text-xs font-semibold tracking-widest uppercase transition-all duration-200"
          >
            OPORTUNIDADES
          </a>
        </nav>

        <!-- Right: Hamburger Menu Toggle -->
        <div class="flex items-center">
          <label
            for="mobile-menu-toggle"
            class="cursor-pointer p-2.5 rounded-md text-neutral-300 hover:text-white hover:bg-white/10 transition-colors relative flex items-center justify-center select-none"
            aria-label="Abrir Menu Lateral"
          >
            <!-- Ícone Hambúrguer (estado fechado) -->
            <svg
              class="w-6 h-6 icon-open transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <!-- Ícone Fechar X (estado aberto) -->
            <svg
              class="w-6 h-6 icon-close hidden text-lzba-gold transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </label>
        </div>
      </div>
    </div>
  </div>

  <!-- Backdrop escurecido atrás do Drawer (fecha ao clicar em qualquer lugar da tela) -->
  <label
    for="mobile-menu-toggle"
    class="drawer-backdrop fixed inset-0 bg-black/60 backdrop-blur-xs z-40 transition-opacity duration-300 opacity-0 pointer-events-none"
    aria-hidden="true"
  >
  </label>

  <!-- Drawer Lateral Direito (Abaixo do cabeçalho principal h-20) -->
  <aside
    id="header-drawer"
    class="drawer-panel fixed top-20 right-0 w-80 sm:w-96 max-w-[88vw] h-[calc(100dvh-5rem)] z-50 bg-[#161616]/98 backdrop-blur-2xl border-l border-white/10 shadow-2xl flex flex-col justify-between overflow-y-auto"
    aria-label="Menu Lateral"
  >
    <!-- Topo do Drawer: Links de Navegação Verticais -->
    <div class="px-8 pt-8 flex flex-col">
      <nav class="flex flex-col space-y-4" aria-label="Links do Menu">
        {
          navLinksDrawer.map((link) => {
            const isActive =
              currentPath === link.href ||
              (link.href !== "/" && currentPath.startsWith(link.href));
            return (
              <a
                href={link.href}
                class={`text-sm tracking-widest uppercase font-semibold transition-all duration-200 py-1.5 flex items-center justify-between group ${
                  isActive
                    ? "text-lzba-gold font-bold translate-x-1"
                    : "text-neutral-300 hover:text-white hover:translate-x-1"
                }`}
              >
                <span>{link.label}</span>
                <span
                  class={`w-1.5 h-1.5 rounded-full transition-all ${
                    isActive
                      ? "bg-lzba-gold"
                      : "bg-transparent group-hover:bg-lzba-gold/50"
                  }`}
                />
              </a>
            );
          })
        }
      </nav>

      <!-- Ações de Contato Rápido (WhatsApp & Telefone) -->
      <div
        class="pt-8 mt-6 border-t border-white/10 flex flex-col gap-4 text-xs"
      >
        <a
          href={CONTATO_LZBA.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full text-center px-4 py-3 text-xs font-semibold uppercase tracking-wider text-lzba-dark bg-lzba-gold hover:brightness-110 transition-all shadow-sm"
        >
          Atendimento WhatsApp
        </a>

        <a
          href={`tel:${CONTATO_LZBA.telefone.replace(/\D/g, "")}`}
          class="flex items-center gap-2.5 text-neutral-300 hover:text-lzba-gold transition-colors py-1"
        >
          <svg
            class="w-4 h-4 text-lzba-gold shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
          <span class="tracking-wide">{CONTATO_LZBA.telefone}</span>
        </a>
      </div>
    </div>

    <!-- Base do Drawer: Logotipo LZBA + Ícones Sociais (Instagram e Facebook) -->
    <div
      class="px-8 pb-8 pt-6 border-t border-white/10 mt-auto flex flex-col items-start gap-4"
    >
      <!-- Logotipo LZBA -->
      <img
