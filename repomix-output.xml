        >
          <svg
            class="w-7 h-7"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.6"
              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
            ></path>
          </svg>
        </div>
        <span
          class="block text-xs uppercase tracking-wider text-lzba-muted font-medium"
        >
          Empreendimentos Entregues
        </span>
        <span
          class="block text-3xl sm:text-4xl font-bold text-white font-heading"
        >
          {NUMEROS_LZBA.obrasEntregues}
        </span>
      </div>

      <!-- Métrica 3: Unidades Entregues -->
      <div class="reveal-scale delay-300 space-y-2 pt-6 md:pt-0">
        <div
          class="w-10 h-10 mx-auto text-lzba-gold flex items-center justify-center"
        >
          <svg
            class="w-7 h-7"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
