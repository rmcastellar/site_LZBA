---
import type { Empreendimento } from "../data/empreendimentos";

interface Props {
  item: Empreendimento;
  index: number;
}

const { item, index } = Astro.props;
const numberFormatted = String(index + 1).padStart(2, "0");
---

<div
  class="project-card group relative transition-all duration-500 ease-out shrink-0 w-[82vw] sm:w-[400px] lg:w-[430px] snap-start shadow-lg hover:shadow-2xl hover:-translate-y-1.5"
  data-status={item.status}
  data-destaque={item.destaque ? "true" : "false"}
  data-slug={item.slug}
  data-index={index}
  style={item.destaque ? "" : "display: none;"}
>
  <div
    class="card-inner relative aspect-[3/4] w-full overflow-hidden flex flex-col justify-between p-6 sm:p-7 select-none transition-all duration-500 cursor-pointer"
  >
    <!-- Imagem de Fundo -->
    <img
      src={item.imagemFachada}
      alt={item.titulo}
      class="card-img absolute inset-0 w-full h-full object-cover transition-all duration-700"
      loading={index < 3 ? "eager" : "lazy"}
    />
    <!-- Overlay com gradiente arquitetônico -->
    <div class="card-overlay absolute inset-0 transition-all duration-500">
    </div>

    <!-- CONTEÚDO DO TOPO (Exibido no estado ATIVO) -->
    <div class="card-top-content relative z-10 transition-all duration-500">
      <p class="text-xs text-lzba-gold font-light pb-1">
        {item.statusLabel}
      </p>

      <h3
        class="text-lg sm:text-xl font-bold font-heading text-white leading-tight"
      >
        {item.titulo}
      </h3>
      <div class="text-xs text-lzba-muted font-light mt-1">
        {item.bairro} • {item.cidade}
      </div>
    </div>

    <!-- CONTEÚDO DA BASE (Exibido no estado INATIVO - Ancorado na base do Card) -->
    <div
      class="card-bottom-content absolute left-6 right-6 sm:left-7 sm:right-7 bottom-6 sm:bottom-7 z-10 transition-all duration-300 pointer-events-none"
    >
      <p class="text-xs text-lzba-gold font-light pb-1">
        {item.statusLabel}
      </p>
      <h3
        class="text-lg sm:text-xl font-bold font-heading text-white leading-tight"
      >
        {item.titulo}
      </h3>
      <div class="text-xs text-lzba-muted font-light mt-1">
        {item.bairro} • {item.cidade}
      </div>
      <div
        class="mt-2 pt-2 border-t border-white/20 text-[11px] text-white/90 font-mono tracking-wide translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300"
      >
        {item.metragem} • {item.dormitorios}
      </div>
    </div>

    <!-- BOTÃO COM SETA (Exibido no estado ATIVO) -->
    <div
      class="card-action-btn relative z-10 transition-all duration-300 mt-auto"
    >
      <a
        href={`/empreendimentos/${item.slug}`}
        class="inline-flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white text-lzba-dark hover:bg-lzba-gold hover:text-white shadow-md transition-all duration-300 group/btn"
        aria-label={`Ver detalhes de ${item.titulo}`}
      >
        <svg
          class="w-5 h-5 transition-transform duration-300 group-hover/btn:translate-x-0.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.8"
            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>

    <!-- Barra dourada inferior no hover -->
    <span
      class="absolute bottom-0 left-0 right-0 h-[2px] bg-lzba-gold origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500 z-20 pointer-events-none"
      aria-hidden="true"
    ></span>
  </div>
</div>

<style>
  /* Mantém a fachada colorida e vibrante com zoom suave e gradiente inferior para legibilidade */
  :global(.project-card.is-active) .card-img,
  :global(.project-card:hover) .card-img {
    transform: scale(1.03);
  }

  :global(.project-card.is-active) .card-overlay,
  :global(.project-card:hover) .card-overlay {
    background: linear-gradient(
      to top,
      rgba(22, 22, 22, 0.92) 0%,
      rgba(22, 22, 22, 0.45) 45%,
      rgba(22, 22, 22, 0.15) 100%
    );
  }
</style>
