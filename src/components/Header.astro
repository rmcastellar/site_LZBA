---
import { CONTATO_LZBA } from '../data/empreendimentos';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Início' },
  { href: '/empreendimentos', label: 'Empreendimentos' },
  { href: '/sobre', label: 'Sobre a LZBA' },
  { href: '/trabalhe-conosco', label: 'Trabalhe Conosco' },
  { href: '/contato', label: 'Contato' },
];
---

<header class="sticky top-0 z-50 w-full bg-[#0b0f17]/90 backdrop-blur-md border-b border-white/10 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo LZBA -->
      <a href="/" class="flex items-center gap-3 group" aria-label="Página inicial LZBA">
        <img 
          src="/images/logo.png" 
          alt="LZBA Construtora e Incorporadora" 
          class="h-10 sm:h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-105" 
          width="180" 
          height="48"
        />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Navegação Principal">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-3 py-2 rounded-md text-sm font-medium transition-colors duration-200 ${
                isActive
                  ? 'text-[#e5c07b] font-semibold bg-white/5'
                  : 'text-slate-300 hover:text-white hover:bg-white/5'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- CTA Buttons Desktop -->
      <div class="hidden lg:flex items-center gap-3">
        <a 
          href={`tel:${CONTATO_LZBA.telefone.replace(/\D/g, '')}`} 
          class="text-xs text-slate-400 hover:text-white flex items-center gap-1.5 transition-colors"
        >
          <svg class="w-4 h-4 text-[#c5a880]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span class="font-medium">{CONTATO_LZBA.telefone}</span>
        </a>

        <a
          href={CONTATO_LZBA.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold text-slate-950 bg-gradient-to-r from-[#e5c07b] to-[#c5a880] hover:from-[#f3cf8e] hover:to-[#d4b58b] shadow-md shadow-[#c5a880]/10 transition-all duration-300 transform hover:-translate-y-0.5"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.149.929 3.182 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.288.043.088.072.189.014.305-.058.115-.087.188-.173.289l-.26.309c-.087.086-.179.18-.077.355.101.173.45 0.742.966 1.202.665.592 1.226.776 1.399.863.173.086.275.072.376-.044.101-.116.433-.506.549-.679.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.044.073.044.419-.1 0.824z"/>
          </svg>
          <span>WhatsApp</span>
        </a>
      </div>

      <!-- Mobile Menu Toggle Button (Pure HTML Details/Summary or Checkbox toggle) -->
      <div class="flex items-center md:hidden">
        <label for="mobile-menu-toggle" class="cursor-pointer p-2 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 focus:outline-none" aria-label="Abrir Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </label>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu (Pure CSS toggle via input checkbox) -->
  <input type="checkbox" id="mobile-menu-toggle" class="peer hidden" />
  <div class="hidden peer-checked:block md:hidden bg-[#0e1422] border-b border-white/10 px-4 pt-3 pb-6 animate-fadeIn">
    <div class="flex flex-col gap-2">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${
              isActive
                ? 'text-[#e5c07b] bg-white/10 font-semibold'
                : 'text-slate-200 hover:text-white hover:bg-white/5'
            }`}
          >
            {link.label}
          </a>
        );
      })}
      
      <div class="pt-4 mt-2 border-t border-white/10 flex flex-col gap-3">
        <a 
          href={`tel:${CONTATO_LZBA.telefone.replace(/\D/g, '')}`} 
          class="flex items-center gap-2 text-slate-300 text-sm font-medium py-1"
        >
          <svg class="w-4 h-4 text-[#c5a880]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {CONTATO_LZBA.telefone}
        </a>
        
        <a
          href={CONTATO_LZBA.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full flex items-center justify-center gap-2 py-3 rounded-lg text-sm font-semibold text-slate-950 bg-gradient-to-r from-[#e5c07b] to-[#c5a880]"
        >
          <span>Falar no WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</header>
