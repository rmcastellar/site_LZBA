---
import { CONTATO_LZBA } from "../data/empreendimentos";

interface Props {
  currentPath?: string;
  transparent?: boolean;
}

const { currentPath = "/", transparent = false } = Astro.props;
const isHome = currentPath === "/" || currentPath === "" || currentPath === "/home" || transparent;

const navLinks = [
  { href: "/", label: "INÍCIO" },
  { href: "/sobre", label: "SOBRE" },
  { href: "/empreendimentos", label: "NOSSOS PROJETOS" },
];
---

<header
  id="main-header"
  data-transparent={isHome ? "true" : "false"}
  class={`w-full z-50 transition-all duration-300 ${
    isHome
      ? "fixed top-0 left-0 header-glass-transparent"
      : "sticky top-0 bg-lzba-dark/95 backdrop-blur-md border-b border-white/10"
  }`}
>
  <div class="max-w-full mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 gap-x-5">
      <!-- Logo LZBA -->
      <a
        href="/"
        class="flex items-center gap-3 group"
        aria-label="Página inicial LZBA"
      >
        <img
          src="/images/logo.png"
          alt="LZBA Construtora e Incorporadora"
          class="h-9 sm:h-11 w-auto object-contain transition-transform duration-300 group-hover:opacity-90"
          width="170"
          height="44"
        />
      </a>

      <!-- Direita: Navegação + Botão Oportunidades + Menu Hambúrguer -->
      <div class="flex items-center gap-6 lg:gap-8">
        <!-- Desktop Navigation (Mockup Exact Match) -->
        <nav
          class="hidden md:flex items-center gap-6 lg:gap-8"
          aria-label="Navegação Principal"
        >
          {
            navLinks.map((link) => {
              const isActive =
                currentPath === link.href ||
                (link.href !== "/" && currentPath.startsWith(link.href));
              return (
                <a
                  href={link.href}
                  class={`text-xs font-semibold tracking-widest uppercase transition-colors duration-200 py-1 border-b-2 ${
                    isActive
                      ? "text-white border-lzba-gold"
                      : "text-neutral-300 hover:text-lzba-light border-transparent"
                  }`}
                >
                  {link.label}
                </a>
              );
            })
          }

          <!-- Botão Oportunidades com Contorno e Cor de Preenchimento -->
          <a
            href="/#projetos?status=lancamento"
            id="header-btn-oportunidades"
            data-filter-trigger="lancamento"
            class="px-4 py-2 border border-white/40 bg-white/20 hover:bg-white/35 hover:border-white text-white text-xs font-semibold tracking-widest uppercase transition-all duration-200"
          >
            OPORTUNIDADES
          </a>
        </nav>

        <!-- Right: Hamburger Menu Toggle -->
        <div class="flex items-center">
          <label
            for="mobile-menu-toggle"
            class="cursor-pointer p-2.5 rounded-md text-neutral-300 hover:text-lzba-light hover:bg-white/10 transition-colors"
            aria-label="Abrir Menu Completo"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </label>
        </div>
      </div>
    </div>
  </div>

  <!-- Offcanvas / Drawer Menu (Pure CSS toggle via input checkbox) -->
  <input type="checkbox" id="mobile-menu-toggle" class="peer hidden" />
  <div
    class="hidden peer-checked:block bg-lzba-dark border-b border-lzba-border/20 px-6 pt-4 pb-8 shadow-2xl transition-all"
  >
    <div
      class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-center justify-between gap-6"
    >
      <div
        class="flex flex-col md:flex-row gap-4 md:gap-8 items-start md:items-center"
      >
        {
          navLinks.map((link) => {
            const isActive =
              currentPath === link.href ||
              (link.href !== "/" && currentPath.startsWith(link.href));
            return (
              <a
                href={link.href}
                class={`text-sm tracking-wider uppercase font-semibold transition-colors ${
                  isActive
                    ? "text-lzba-gold"
                    : "text-neutral-400 hover:text-white"
                }`}
              >
                {link.label}
              </a>
            );
          })
        }
        <a
          href="/contato"
          class="text-sm tracking-wider uppercase font-semibold text-neutral-400 hover:text-white transition-colors"
        >
          CONTATOS
        </a>
        <a
          href="/#projetos?status=lancamento"
          data-filter-trigger="lancamento"
          class="inline-flex items-center justify-center px-3.5 py-1.5 rounded-sm border border-white/30 bg-white/10 hover:bg-white/20 text-white text-xs font-semibold tracking-wider uppercase transition-colors"
        >
          OPORTUNIDADES
        </a>
      </div>

      <div
        class="flex flex-col sm:flex-row items-start sm:items-center gap-4 text-xs text-neutral-300 pt-4 md:pt-0 border-t md:border-t-0 border-white/10"
      >
        <a
          href={`tel:${CONTATO_LZBA.telefone.replace(/\D/g, "")}`}
          class="flex items-center gap-2 hover:text-lzba-gold transition-colors"
        >
          <svg
            class="w-4 h-4 text-lzba-gold"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
          <span>{CONTATO_LZBA.telefone}</span>
        </a>

        <a
          href={CONTATO_LZBA.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 rounded text-xs font-semibold text-lzba-dark bg-lzba-gold hover:brightness-110 transition-all"
        >
          Atendimento WhatsApp
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  function setupHeaderScroll() {
    const header = document.getElementById("main-header");
    if (!header || header.dataset.transparent !== "true") return;

    const onScroll = () => {
      if (window.scrollY > 40) {
        header.classList.add("header-glass-scrolled");
      } else {
        header.classList.remove("header-glass-scrolled");
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  setupHeaderScroll();
  document.addEventListener("astro:page-load", setupHeaderScroll);
</script>
