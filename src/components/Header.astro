---
import { CONTATO_LZBA } from "../data/empreendimentos";

interface Props {
  currentPath?: string;
  transparent?: boolean;
}

const { currentPath = "/", transparent = false } = Astro.props;
const isHome =
  currentPath === "/" ||
  currentPath === "" ||
  currentPath === "/home" ||
  transparent;

const navLinks = [
  { href: "/", label: "INÍCIO" },
  { href: "/blog", label: "BLOG" },
  { href: "/empreendimentos", label: "NOSSOS PROJETOS" },
];

const navLinksDrawer = [
  { href: "/", label: "INÍCIO" },
  { href: "/#projetos?status=destaques", label: "OPORTUNIDADES" },
  { href: "/sobre", label: "SOBRE" },
  { href: "/empreendimentos", label: "NOSSOS PROJETOS" },
  { href: "/blog", label: "BLOG" },
  { href: "/trabalhe-conosco", label: "TRABALHE CONOSCO" },
  { href: "/contato", label: "CONTATO" },
];
---

<header
  id="main-header"
  data-transparent={isHome ? "true" : "false"}
  class={`w-full z-50 transition-all duration-300 ${
    isHome
      ? "fixed top-0 left-0 header-glass-transparent"
      : "sticky top-0 bg-lzba-dark/95 backdrop-blur-md border-b border-white/10"
  }`}
>
  <!-- Input invisível de controle do Drawer Menu -->
  <input
    type="checkbox"
    id="mobile-menu-toggle"
    class="drawer-checkbox hidden"
  />

  <div class="max-w-full mx-auto px-4 sm:px-6 lg:px-8 relative z-50 bg-inherit">
    <div class="flex items-center justify-between h-20 gap-x-5">
      <!-- Logo LZBA -->
      <a
        href="/"
        class="flex items-center gap-3 group"
        aria-label="Página inicial LZBA"
      >
        <img
          src="/images/logo.png"
          alt="LZBA Construtora e Incorporadora"
          class="h-9 sm:h-11 w-auto object-contain transition-transform duration-300 group-hover:opacity-90"
          width="170"
          height="44"
        />
      </a>

      <!-- Direita: Navegação + Botão Oportunidades + Menu Hambúrguer -->
      <div class="flex items-center gap-6 lg:gap-8">
        <!-- Desktop Navigation (visível em telas grandes para layout refinado e sem aperto) -->
        <nav
          class="hidden lg:flex items-center gap-6 lg:gap-8"
          aria-label="Navegação Principal"
        >
          {
            navLinks.map((link) => {
              const isActive =
                currentPath === link.href ||
                (link.href !== "/" && currentPath.startsWith(link.href));
              return (
                <a
                  href={link.href}
                  class={`text-xs font-semibold tracking-widest uppercase transition-colors duration-200 py-1 border-b-2 ${
                    isActive
                      ? "text-white border-lzba-gold"
                      : "text-neutral-300 hover:text-lzba-light border-transparent"
                  }`}
                >
                  {link.label}
                </a>
              );
            })
          }

          <!-- Botão Oportunidades com Contorno e Cor de Preenchimento -->
          <a
            href="/#projetos?status=destaques"
            id="header-btn-oportunidades"
            data-filter-trigger="destaques"
            class="px-4 py-2 border border-white/40 bg-white/20 hover:bg-white/35 hover:border-white text-white text-xs font-semibold tracking-widest uppercase transition-all duration-200"
          >
            OPORTUNIDADES
          </a>
        </nav>

        <!-- Right: Hamburger Menu Toggle -->
        <div class="flex items-center">
          <label
            for="mobile-menu-toggle"
            class="cursor-pointer p-2.5 rounded-md text-neutral-300 hover:text-white hover:bg-white/10 transition-colors relative flex items-center justify-center select-none"
            aria-label="Abrir Menu Lateral"
          >
            <!-- Ícone Hambúrguer (estado fechado) -->
            <svg
              class="w-6 h-6 icon-open transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <!-- Ícone Fechar X (estado aberto) -->
            <svg
              class="w-6 h-6 icon-close hidden text-lzba-gold transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </label>
        </div>
      </div>
    </div>
  </div>

  <!-- Backdrop escurecido atrás do Drawer (fecha ao clicar em qualquer lugar da tela) -->
  <label
    for="mobile-menu-toggle"
    class="drawer-backdrop fixed inset-0 bg-black/60 backdrop-blur-xs z-40 transition-opacity duration-300 opacity-0 pointer-events-none"
    aria-hidden="true"
  >
  </label>

  <!-- Drawer Lateral Direito (Abaixo do cabeçalho principal h-20) -->
  <aside
    id="header-drawer"
    class="drawer-panel fixed top-20 right-0 w-80 sm:w-96 max-w-[88vw] h-[calc(100dvh-5rem)] z-50 bg-[#161616]/98 backdrop-blur-2xl border-l border-white/10 shadow-2xl flex flex-col justify-between overflow-y-auto"
    aria-label="Menu Lateral"
  >
    <!-- Topo do Drawer: Links de Navegação Verticais -->
    <div class="px-8 pt-8 flex flex-col">
      <nav class="flex flex-col space-y-4" aria-label="Links do Menu">
        {
          navLinksDrawer.map((link) => {
            const isActive =
              currentPath === link.href ||
              (link.href !== "/" && currentPath.startsWith(link.href));
            return (
              <a
                href={link.href}
                class={`text-sm tracking-widest uppercase font-semibold transition-all duration-200 py-1.5 flex items-center justify-between group ${
                  isActive
                    ? "text-lzba-gold font-bold translate-x-1"
                    : "text-neutral-300 hover:text-white hover:translate-x-1"
                }`}
              >
                <span>{link.label}</span>
                <span
                  class={`w-1.5 h-1.5 rounded-full transition-all ${
                    isActive
                      ? "bg-lzba-gold"
                      : "bg-transparent group-hover:bg-lzba-gold/50"
                  }`}
                />
              </a>
            );
          })
        }
      </nav>

      <!-- Ações de Contato Rápido (WhatsApp & Telefone) -->
      <div
        class="pt-8 mt-6 border-t border-white/10 flex flex-col gap-4 text-xs"
      >
        <a
          href={CONTATO_LZBA.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full text-center px-4 py-3 text-xs font-semibold uppercase tracking-wider text-lzba-dark bg-lzba-gold hover:brightness-110 transition-all shadow-sm"
        >
          Atendimento WhatsApp
        </a>

        <a
          href={`tel:${CONTATO_LZBA.telefone.replace(/\D/g, "")}`}
          class="flex items-center gap-2.5 text-neutral-300 hover:text-lzba-gold transition-colors py-1"
        >
          <svg
            class="w-4 h-4 text-lzba-gold shrink-0"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
          <span class="tracking-wide">{CONTATO_LZBA.telefone}</span>
        </a>
      </div>
    </div>

    <!-- Base do Drawer: Logotipo LZBA + Ícones Sociais (Instagram e Facebook) -->
    <div
      class="px-8 pb-8 pt-6 border-t border-white/10 mt-auto flex flex-col items-start gap-4"
    >
      <!-- Logotipo LZBA -->
      <img
        src="/images/logo.png"
        alt="Logo LZBA Construtora e Incorporadora"
        class="h-8 sm:h-9 w-auto object-contain opacity-90"
        width="140"
        height="36"
      />

      <!-- Ícones Sociais Circulares (conforme referência KR) -->
      <div class="flex items-center gap-3">
        <!-- Instagram -->
        <a
          href="https://www.instagram.com/construtoralzba/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram da LZBA"
          class="w-8 h-8 rounded-full bg-white text-lzba-dark hover:bg-lzba-gold hover:text-white flex items-center justify-center transition-all duration-200 shadow-sm hover:scale-105"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path
              d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
            ></path>
          </svg>
        </a>

        <!-- Facebook -->
        <a
          href="https://www.facebook.com/incorporadoralzba"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook da LZBA"
          class="w-8 h-8 rounded-full bg-white text-lzba-dark hover:bg-lzba-gold hover:text-white flex items-center justify-center transition-all duration-200 shadow-sm hover:scale-105"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path
              d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.556 5 15.63 5H18V0h-3.808C10.597 0 9 1.582 9 4.615V8z"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </aside>
</header>

<style>
  /* Controle do Drawer lateral com transição suave */
  .drawer-panel {
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .drawer-checkbox:checked ~ .drawer-panel {
    transform: translateX(0);
  }

  .drawer-checkbox:checked ~ .drawer-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  .drawer-checkbox:checked ~ div .icon-open {
    display: none;
  }

  .drawer-checkbox:checked ~ div .icon-close {
    display: block;
  }
</style>

<script>
  function setupHeaderScroll() {
    const header = document.getElementById("main-header");
    if (!header || header.dataset.transparent !== "true") return;

    const onScroll = () => {
      if (window.scrollY > 40) {
        header.classList.add("header-glass-scrolled");
      } else {
        header.classList.remove("header-glass-scrolled");
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  function setupDrawer() {
    const toggle = document.getElementById("mobile-menu-toggle") as HTMLInputElement | null;
    const drawer = document.getElementById("header-drawer");

    if (!toggle || !drawer) return;

    const closeDrawer = () => {
      if (toggle.checked) {
        toggle.checked = false;
      }
    };

    // Fecha ao clicar em qualquer lugar fora do drawer e fora do botão de toggle
    document.addEventListener("click", (event) => {
      if (!toggle.checked) return;

      const path = event.composedPath();

      // Se o clique ocorreu dentro do painel do drawer, não fecha
      if (path.includes(drawer)) return;

      // Se o clique foi no botão de abrir/fechar (label) ou no input checkbox, deixa a ação nativa do label ocorrer
      const isToggleAction = path.some(
        (el) =>
          el === toggle ||
          (el instanceof Element &&
            (el.matches('label[for="mobile-menu-toggle"]') ||
              Boolean(el.closest('label[for="mobile-menu-toggle"]'))))
      );

      if (isToggleAction) return;

      // Se clicou em qualquer outro lugar fora do drawer: fecha
      closeDrawer();
    });

    // Fecha ao pressionar Escape
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.checked) {
        closeDrawer();
      }
    });

    // Fecha ao clicar em qualquer link de navegação dentro do drawer
    const drawerLinks = drawer.querySelectorAll("a");
    drawerLinks.forEach((link) => {
      link.addEventListener("click", closeDrawer);
    });
  }

  function initHeader() {
    setupHeaderScroll();
    setupDrawer();
  }

  initHeader();
  document.addEventListener("astro:page-load", initHeader);
</script>
