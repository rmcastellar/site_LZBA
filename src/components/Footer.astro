---
import { CONTATO_LZBA } from '../data/empreendimentos';

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#080c14] border-t border-white/10 text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      
      <!-- Coluna 1: Sobre LZBA -->
      <div class="space-y-4">
        <a href="/" class="inline-block" aria-label="LZBA Início">
          <img 
            src="/images/logo.png" 
            alt="LZBA Incorporadora e Construtora" 
            class="h-11 w-auto object-contain" 
            width="170" 
            height="44"
          />
        </a>
        <p class="text-sm text-slate-400 leading-relaxed">
          Com mais de três décadas de sólida atuação no mercado imobiliário paulista, a LZBA é sinônimo de inovação, pontualidade rigorosa e projetos projetados para superar as mais altas expectativas.
        </p>
        <div class="pt-2 text-xs text-slate-500">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-950/60 text-emerald-400 border border-emerald-800/40 font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            34 anos de credibilidade e excelência
          </span>
        </div>
      </div>

      <!-- Coluna 2: Navegação Rápida -->
      <div>
        <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4 font-heading border-b border-white/10 pb-2">
          Navegação
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/" class="hover:text-[#e5c07b] transition-colors flex items-center gap-1.5">
              <span>›</span> Início
            </a>
          </li>
          <li>
            <a href="/empreendimentos" class="hover:text-[#e5c07b] transition-colors flex items-center gap-1.5">
              <span>›</span> Todos os Empreendimentos
            </a>
          </li>
          <li>
            <a href="/sobre" class="hover:text-[#e5c07b] transition-colors flex items-center gap-1.5">
              <span>›</span> Sobre a LZBA
            </a>
          </li>
          <li>
            <a href="/trabalhe-conosco" class="hover:text-[#e5c07b] transition-colors flex items-center gap-1.5">
              <span>›</span> Portal de Corretores & Parceiros
            </a>
          </li>
          <li>
            <a href="/contato" class="hover:text-[#e5c07b] transition-colors flex items-center gap-1.5">
              <span>›</span> Fale Conosco
            </a>
          </li>
        </ul>
      </div>

      <!-- Coluna 3: Empreendimentos em Destaque -->
      <div>
        <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4 font-heading border-b border-white/10 pb-2">
          Destaques
        </h3>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="/empreendimentos/residencial-season" class="group block hover:text-white transition-colors">
              <span class="font-semibold text-slate-200 group-hover:text-[#e5c07b]">Residencial Season</span>
              <span class="block text-xs text-amber-400/90 font-medium">Lançamento • Santana / Jardim São Paulo</span>
            </a>
          </li>
          <li>
            <a href="/empreendimentos/residencial-vista-vicenza" class="group block hover:text-white transition-colors">
              <span class="font-semibold text-slate-200 group-hover:text-[#e5c07b]">Residencial Vista Vicenza</span>
              <span class="block text-xs text-sky-400/90 font-medium">Em Obras • Santana</span>
            </a>
          </li>
          <li>
            <a href="/empreendimentos/residencial-capricho" class="group block hover:text-white transition-colors">
              <span class="font-semibold text-slate-200 group-hover:text-[#e5c07b]">Residencial Capricho</span>
              <span class="block text-xs text-emerald-400/90 font-medium">Pronto para Morar • Tremembé</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Coluna 4: Canais de Atendimento -->
      <div>
        <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4 font-heading border-b border-white/10 pb-2">
          Atendimento
        </h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-2.5">
            <svg class="w-5 h-5 text-[#c5a880] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <div>
              <span class="block text-xs text-slate-500">Telefone Fixo</span>
              <a href={`tel:${CONTATO_LZBA.telefone.replace(/\D/g, '')}`} class="font-medium text-slate-200 hover:text-[#e5c07b]">
                {CONTATO_LZBA.telefone}
              </a>
            </div>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.149.929 3.182 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.288.043.088.072.189.014.305-.058.115-.087.188-.173.289l-.26.309c-.087.086-.179.18-.077.355.101.173.45 0.742.966 1.202.665.592 1.226.776 1.399.863.173.086.275.072.376-.044.101-.116.433-.506.549-.679.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.044.073.044.419-.1 0.824z"/>
            </svg>
            <div>
              <span class="block text-xs text-slate-500">Plantão WhatsApp</span>
              <a href={CONTATO_LZBA.whatsappLink} target="_blank" rel="noopener noreferrer" class="font-medium text-slate-200 hover:text-emerald-400">
                {CONTATO_LZBA.whatsapp}
              </a>
            </div>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-5 h-5 text-[#c5a880] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <div>
              <span class="block text-xs text-slate-500">E-mail</span>
              <a href={`mailto:${CONTATO_LZBA.email}`} class="font-medium text-slate-200 hover:text-[#e5c07b]">
                {CONTATO_LZBA.email}
              </a>
            </div>
          </li>
          <li class="pt-2 text-xs text-slate-500">
            Horário: {CONTATO_LZBA.horario}
          </li>
        </ul>
      </div>

    </div>

    <!-- Barra Inferior de Direitos e LGPD -->
    <div class="mt-14 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>
        © {currentYear} LZBA Incorporadora de Imóveis Ltda. Todos os direitos reservados.
      </p>
      <div class="flex items-center gap-6">
        <a href="/politica-de-privacidade" class="hover:text-slate-300 transition-colors">
          Política de Privacidade (LGPD)
        </a>
        <a href="/trabalhe-conosco" class="hover:text-slate-300 transition-colors">
          Área de Corretores
        </a>
      </div>
    </div>
  </div>
</footer>
