---
import type { Empreendimento } from "../data/empreendimentos";

interface Props {
  item: Empreendimento;
}

const { item } = Astro.props;

const statusStyles = {
  lancamento: "bg-lzba-red/90 text-lzba-light border-lzba-red/30",
  em_obras: "bg-lzba-gold/90 text-lzba-dark border-lzba-gold/30",
  entregue: "bg-lzba-light/95 text-lzba-dark border-lzba-light/30",
};
---

<!-- Wrapper com a moldura e respiro arquitetônico característico da LZBA -->
<div
  class="building-card-frame group relative p-1.5 sm:p-2 border border-transparent hover:border-lzba-border transition-all duration-300 h-full"
>
  <article
    class="bg-white border border-lzba-border/80 group-hover:border-neutral-300 group-hover:shadow-xl transition-all duration-300 flex flex-col h-full overflow-hidden shadow-xs"
  >
    <!-- Imagem com Badge de Status e Localização -->
    <div class="relative aspect-16/10 overflow-hidden bg-neutral-900">
      <a href={`/empreendimentos/${item.slug}`} class="block w-full h-full">
        <img
          src={item.imagemCapa}
          alt={item.titulo}
          class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          loading="lazy"
          width="600"
          height="375"
        />
      </a>
      <div
        class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent pointer-events-none"
      >
      </div>

      <!-- Badge de Status -->
      <div class="absolute top-4 left-4">
        <span
          class={`inline-flex items-center px-3 py-1 text-xs font-semibold uppercase tracking-wider border backdrop-blur-md shadow-xs ${statusStyles[item.status]}`}
        >
          {item.statusLabel}
        </span>
      </div>

      <!-- Localização no canto inferior -->
      <div
        class="absolute bottom-3 left-4 right-4 flex items-center gap-1.5 text-xs text-white drop-shadow-sm font-medium"
      >
        <svg
          class="w-4 h-4 text-lzba-gold shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span class="truncate">{item.bairro}, {item.cidade}</span>
      </div>
    </div>

    <!-- Corpo do Card -->
    <div class="p-6 flex flex-col grow justify-between">
      <div>
        <h3
          class="text-xl font-bold text-lzba-dark group-hover:text-neutral-700 transition-colors font-heading mb-2 leading-snug"
        >
          <a href={`/empreendimentos/${item.slug}`}>
            {item.titulo}
          </a>
        </h3>

        <p
          class="text-xs sm:text-sm text-neutral-600 line-clamp-2 mb-5 leading-relaxed font-light"
        >
          {item.descricaoCurta}
        </p>
      </div>

      <!-- Atributos Chave: Metragem, Dormitórios, Vagas -->
      <div class="mt-auto">
        <div
          class="grid grid-cols-3 gap-2 py-3 border-y border-neutral-100 bg-neutral-50/50 text-center text-xs text-neutral-700"
        >
          <div>
            <span
              class="block text-[10px] text-neutral-400 uppercase font-semibold"
              >Área</span
            >
            <span class="font-bold text-lzba-dark mt-0.5 block"
              >{item.metragem}</span
            >
          </div>
          <div>
            <span
              class="block text-[10px] text-neutral-400 uppercase font-semibold"
              >Quartos</span
            >
            <span class="font-bold text-lzba-dark mt-0.5 block"
              >{item.dormitorios.replace(" dormitórios", " dorms")}</span
            >
          </div>
          <div>
            <span
              class="block text-[10px] text-neutral-400 uppercase font-semibold"
              >Vagas</span
            >
            <span class="font-bold text-lzba-dark mt-0.5 block"
              >{item.vagas}</span
            >
          </div>
        </div>

        <!-- Botão de Ação -->
        <div class="pt-5">
          <a
            href={`/empreendimentos/${item.slug}`}
            class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 text-xs font-semibold uppercase tracking-wider text-neutral-900 group-hover:bg-neutral-900 group-hover:text-white border border-neutral-300 group-hover:border-neutral-900 transition-all duration-300 shadow-2xs"
          >
            <span>Ver Detalhes do Projeto</span>
            <svg
              class="w-3.5 h-3.5 transform transition-transform group-hover:translate-x-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </article>
</div>
