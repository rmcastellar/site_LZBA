---
interface Etapa {
  numero: string;
  tituloLinha1: string;
  tituloLinha2: string;
  descricao: string;
}

const etapas: Etapa[] = [
  {
    numero: "01",
    tituloLinha1: "Planejamento Executivo",
    tituloLinha2: "& Compatibilização",
    descricao:
      "Detalhamento de projetos hidrossanitários, estruturais e elétricos com modelagem rigorosa, mitigando retrabalhos e desvios orçamentários.",
  },
  {
    numero: "02",
    tituloLinha1: "Execução com",
    tituloLinha2: "Auditoria Contínua",
    descricao:
      "Controle rigoroso de fornecedores homologados, acompanhamento in loco das etapas estruturais e relatórios periódicos de evolução física da obra para o comprador.",
  },
  {
    numero: "03",
    tituloLinha1: "Vistoria Técnica e",
    tituloLinha2: "Entrega Personalizada",
    descricao:
      "Checklist minucioso de acabamentos conduzido conjuntamente com a equipe técnica antes da assinatura do termo de entrega das chaves.",
  },
  {
    numero: "04",
    tituloLinha1: "Suporte e Garantia",
    tituloLinha2: "Pós-Chaves",
    descricao:
      "Atendimento estruturado para acionamento de garantias legais e manutenção preventiva, preservando o valor do ativo a longo prazo.",
  },
];
---

<!-- 4. PREVISIBILIDADE / JORNADA DE COMPRA -->
<section class="py-20 lg:py-28 bg-white text-lzba-dark" data-timeline-section>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Cabeçalho -->
    <div class="reveal-up max-w-3xl">
      <span class="text-xs uppercase font-bold tracking-widest text-lzba-gold block mb-2 font-sans">
        PREVISIBILIDADE
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-lzba-dark tracking-tight font-heading leading-tight">
        Jornada de Compra com Previsibilidade e Controle
      </h2>
      <p class="text-sm sm:text-base text-neutral-600 mt-4 leading-relaxed font-light">
        Do planejamento de fundações ao termo de vistoria: como garantimos a
        integridade do seu investimento.
      </p>
    </div>

    <!-- Linha do Tempo Arquitetônica: Horizontal (Desktop) / Vertical (Mobile) -->
    <div class="relative mt-16">
      <!-- Linha Contínua Horizontal (Desktop) -->
      <div
        class="hidden lg:block absolute top-6 left-0 right-0 h-px bg-lzba-border"
        aria-hidden="true"
      >
        <div
          class="h-full bg-lzba-gold origin-left scale-x-0 transition-transform duration-1000 ease-out"
          data-timeline-progress-h
        ></div>
      </div>

      <!-- Linha Contínua Vertical (Mobile) -->
      <div
        class="lg:hidden absolute top-2 bottom-2 left-3.5 w-px bg-lzba-border"
        aria-hidden="true"
      >
        <div
          class="w-full h-full bg-lzba-gold origin-top scale-y-0 transition-transform duration-1000 ease-out"
          data-timeline-progress-v
        ></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-4 gap-10 lg:gap-8">
        {
          etapas.map((etapa, index) => (
            <article
              class={`reveal-up delay-${(index + 1) * 100} relative pl-10 lg:pl-0 lg:pt-12`}
            >
              <!-- Marcador na Linha -->
              <span
                class="absolute left-2.5 top-2 lg:left-0 lg:top-[21px] w-2.5 h-2.5 bg-lzba-gold ring-4 ring-white"
                aria-hidden="true"
              ></span>

              <!-- Numeração Grande Alinhada à Esquerda -->
              <span class="block font-heading text-4xl sm:text-5xl font-bold tracking-tight text-lzba-dark/15 tabular-nums leading-none mb-4">
                {etapa.numero}
              </span>

              <h3 class="text-base sm:text-lg font-bold text-lzba-dark font-heading mb-3 leading-snug">
                {etapa.tituloLinha1}
                <br />
                {etapa.tituloLinha2}
              </h3>

              <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed font-light">
                {etapa.descricao}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  function initPrevisibilidadeTimeline(): void {
    const sections = document.querySelectorAll<HTMLElement>("[data-timeline-section]");
    if (sections.length === 0) return;

    sections.forEach((section) => {
      if (section.dataset.timelineBound === "true") return;
      section.dataset.timelineBound = "true";

      const progressH = section.querySelector<HTMLElement>("[data-timeline-progress-h]");
      const progressV = section.querySelector<HTMLElement>("[data-timeline-progress-v]");

      const fillLines = () => {
        progressH?.classList.remove("scale-x-0");
        progressH?.classList.add("scale-x-100");
        progressV?.classList.remove("scale-y-0");
        progressV?.classList.add("scale-y-100");
      };

      if (
        !("IntersectionObserver" in window) ||
        window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        fillLines();
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              fillLines();
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.2 },
      );

      observer.observe(section);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPrevisibilidadeTimeline, { once: true });
  } else {
    initPrevisibilidadeTimeline();
  }

  document.addEventListener("astro:page-load", initPrevisibilidadeTimeline);
</script>
