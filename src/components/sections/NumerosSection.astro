<!-- 5. FAIXA ESCURA DE MÉTRICAS (MOCKUP STATS STRIP) -->
<section class="py-14 bg-lzba-dark text-white border-y border-lzba-border/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center items-center"
    >
      <!-- Métrica 1: Years Of Experience -->
      <div class="space-y-2">
        <div
          class="w-10 h-10 mx-auto text-lzba-gold flex items-center justify-center"
        >
          <svg
            class="w-7 h-7"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.6"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <span
          class="block text-xs uppercase tracking-wider text-lzba-muted font-medium"
        >
          Years Of Experience
        </span>
        <span
          class="block text-3xl sm:text-4xl font-bold text-white font-heading"
        >
          15+
        </span>
      </div>

      <!-- Métrica 2: Success Projects -->
      <div class="space-y-2">
        <div
          class="w-10 h-10 mx-auto text-lzba-gold flex items-center justify-center"
        >
          <svg
            class="w-7 h-7"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.6"
              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
            ></path>
          </svg>
        </div>
        <span
          class="block text-xs uppercase tracking-wider text-lzba-muted font-medium"
        >
          Success Projects
        </span>
        <span
          class="block text-3xl sm:text-4xl font-bold text-white font-heading"
        >
          600+
        </span>
      </div>

      <!-- Métrica 3: Team Members -->
      <div class="space-y-2">
        <div
          class="w-10 h-10 mx-auto text-lzba-gold flex items-center justify-center"
        >
          <svg
            class="w-7 h-7"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.6"
              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
            ></path>
          </svg>
        </div>
        <span
          class="block text-xs uppercase tracking-wider text-lzba-muted font-medium"
        >
          Team Members
        </span>
        <span
          class="block text-3xl sm:text-4xl font-bold text-white font-heading"
        >
          40+
        </span>
      </div>

      <!-- Métrica 4: Clients Satisfactions -->
      <div class="space-y-2">
        <div
          class="w-10 h-10 mx-auto text-lzba-gold flex items-center justify-center"
        >
          <svg
            class="w-7 h-7"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.6"
              d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            ></path>
          </svg>
        </div>
        <span
          class="block text-xs uppercase tracking-wider text-lzba-muted font-medium"
        >
          Clients Satisfactions
        </span>
        <span
          class="block text-3xl sm:text-4xl font-bold text-white font-heading"
        >
          500+
        </span>
      </div>
    </div>
  </div>
</section>
