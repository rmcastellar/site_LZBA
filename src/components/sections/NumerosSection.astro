---
import { NUMEROS_LZBA } from "../../data/empreendimentos";
---

<!-- 5. FAIXA ESCURA DE MÉTRICAS (MOCKUP STATS STRIP) -->
<section class="py-14 bg-lzba-dark text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-8 text-center items-center divide-y md:divide-y-0 divide-white/10">
      <!-- Métrica 1: Anos de Experiência -->
      <div class="reveal-scale delay-100 space-y-2 pb-6 md:pb-0">
        <div
          class="w-10 h-10 mx-auto text-lzba-gold flex items-center justify-center"
        >
          <svg
            class="w-7 h-7"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.6"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <span
          class="block text-xs uppercase tracking-wider text-lzba-muted font-medium"
        >
          Anos de Experiência
        </span>
        <span
          class="block text-3xl sm:text-4xl font-bold text-white font-heading"
        >
          {NUMEROS_LZBA.anosCarreira}
        </span>
      </div>

      <!-- Métrica 2: Empreendimentos Entregues -->
      <div class="reveal-scale delay-200 space-y-2 py-6 md:py-0">
        <div
          class="w-10 h-10 mx-auto text-lzba-gold flex items-center justify-center"
        >
          <svg
            class="w-7 h-7"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.6"
              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
            ></path>
          </svg>
        </div>
        <span
          class="block text-xs uppercase tracking-wider text-lzba-muted font-medium"
        >
          Empreendimentos Entregues
        </span>
        <span
          class="block text-3xl sm:text-4xl font-bold text-white font-heading"
        >
          {NUMEROS_LZBA.obrasEntregues}
        </span>
      </div>

      <!-- Métrica 3: Unidades Entregues -->
      <div class="reveal-scale delay-300 space-y-2 pt-6 md:pt-0">
        <div
          class="w-10 h-10 mx-auto text-lzba-gold flex items-center justify-center"
        >
          <svg
            class="w-7 h-7"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.6"
              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
            ></path>
          </svg>
        </div>
        <span
          class="block text-xs uppercase tracking-wider text-lzba-muted font-medium"
        >
          Unidades Entregues
        </span>
        <span
          class="block text-3xl sm:text-4xl font-bold text-white font-heading"
        >
          {NUMEROS_LZBA.aptosEntregues}
        </span>
      </div>
    </div>
  </div>
</section>
