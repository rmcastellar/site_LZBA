---
import { EMPREENDIMENTOS } from "../../data/empreendimentos";
import ProjectCard from "../ProjectCard.astro";

const todosProjetos = [...EMPREENDIMENTOS].sort(
  (a, b) => (Number(b.ano) || 0) - (Number(a.ano) || 0),
);
---

<!-- 3. SEÇÃO PROJETOS (DESIGN EDITORIAL COM FOCO NAS IMAGENS) -->
<section
  id="projetos"
  class="py-16 sm:py-20 lg:py-24 bg-lzba-light text-lzba-dark scroll-mt-20 overflow-hidden"
>
  <div class="max-w-[1480px] mx-auto px-3 sm:px-6 lg:px-8">
    <!-- Cabeçalho Editorial + Filtros Horizontais -->
    <div class="reveal-up flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-8 sm:mb-10 px-1 sm:px-0">
      <div class="max-w-md lg:max-w-sm xl:max-w-md shrink-0">
        <span class="text-xs uppercase font-bold tracking-widest text-lzba-gold block mb-2 font-sans">
          PROJETOS
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-lzba-dark tracking-tight font-heading leading-tight">
          Empreendimentos que valorizam o seu patrimônio
        </h2>
      </div>

      <!-- Barra de Filtros Horizontal -->
      <div
        class="flex flex-wrap lg:flex-nowrap items-center gap-2 lg:justify-end"
        id="projects-filter-bar"
      >
        <button
          type="button"
          data-filter="destaques"
          class="project-filter-btn whitespace-nowrap px-4 py-2 rounded-full border border-lzba-gold bg-lzba-gold/15 hover:bg-lzba-gold/25 text-black hover:text-black text-xs font-bold tracking-widest uppercase transition-all duration-200 cursor-pointer"
        >
          Destaques
        </button>

        <button
          type="button"
          data-filter="todos"
          class="project-filter-btn whitespace-nowrap px-4 py-2 rounded-full border border-lzba-dark/20 hover:border-lzba-dark hover:bg-lzba-dark/5 text-lzba-muted hover:text-black bg-transparent text-xs font-semibold tracking-widest uppercase transition-all duration-200 cursor-pointer"
        >
          Todos
        </button>

        <button
          type="button"
          data-filter="lancamento"
          class="project-filter-btn whitespace-nowrap px-4 py-2 rounded-full border border-lzba-dark/20 hover:border-lzba-dark hover:bg-lzba-dark/5 text-lzba-muted hover:text-black bg-transparent text-xs font-semibold tracking-widest uppercase transition-all duration-200 cursor-pointer"
        >
          Lançamentos
        </button>

        <button
          type="button"
          data-filter="em_obras"
          class="project-filter-btn whitespace-nowrap px-4 py-2 rounded-full border border-lzba-dark/20 hover:border-lzba-dark hover:bg-lzba-dark/5 text-lzba-muted hover:text-black bg-transparent text-xs font-semibold tracking-widest uppercase transition-all duration-200 cursor-pointer"
        >
          Em obras
        </button>

        <button
          type="button"
          data-filter="entregue"
          class="project-filter-btn whitespace-nowrap px-4 py-2 rounded-full border border-lzba-dark/20 hover:border-lzba-dark hover:bg-lzba-dark/5 text-lzba-muted hover:text-black bg-transparent text-xs font-semibold tracking-widest uppercase transition-all duration-200 cursor-pointer"
        >
          Entregues
        </button>

        <button
          type="button"
          data-filter="futuros"
          class="project-filter-btn whitespace-nowrap px-4 py-2 rounded-full border border-lzba-dark/20 hover:border-lzba-dark hover:bg-lzba-dark/5 text-lzba-muted hover:text-black bg-transparent text-xs font-semibold tracking-widest uppercase transition-all duration-200 cursor-pointer"
        >
          Empreendimentos futuros
        </button>
      </div>
    </div>

    <!-- Área dos Cards (Largura Total para Privilegiar as Imagens) -->
    <div>
            <!-- Item 1: Destaques (Botão com contorno, ativo por padrão) -->
      <!-- Coluna Direita: Trilho Horizontal de Cards de Projetos com contenção de overflow -->
      <div class="reveal-right w-full flex-1 min-w-0 max-w-full overflow-hidden">
        <!-- Controles de Navegação (Pequenos, discretos e alinhados à direita) -->
        <div class="flex items-center justify-end gap-2 mb-3 pr-1">
          <button
            id="projects-prev-btn"
            type="button"
            aria-label="Projetos anteriores"
            class="w-8 h-8 rounded-full border border-lzba-border bg-white/80 hover:bg-white text-lzba-dark hover:text-lzba-gold hover:border-lzba-gold flex items-center justify-center transition-all duration-200 cursor-pointer shadow-2xs disabled:opacity-25 disabled:pointer-events-none hover:scale-105 active:scale-95"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"></path>
            </svg>
          </button>
          <button
            id="projects-next-btn"
            type="button"
            aria-label="Próximos projetos"
            class="w-8 h-8 rounded-full border border-lzba-border bg-white/80 hover:bg-white text-lzba-dark hover:text-lzba-gold hover:border-lzba-gold flex items-center justify-center transition-all duration-200 cursor-pointer shadow-2xs disabled:opacity-25 disabled:pointer-events-none hover:scale-105 active:scale-95"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </div>

        <!-- Trilho Horizontal de Cards -->
        <div
          id="projects-track"
          class="flex gap-5 sm:gap-6 overflow-x-auto pb-4 pt-1 scrollbar-none snap-x snap-mandatory scroll-smooth min-h-105 sm:min-h-115 items-stretch pl-1 sm:pl-0"
          style="scrollbar-width: none; -ms-overflow-style: none;"
        >
          <!-- Mensagem para categoria sem projetos -->
          <div
            id="projects-empty-message"
            class="hidden w-full py-16 px-6 text-center flex-col items-center justify-center my-auto min-w-70"
          >
            <p class="text-base font-semibold text-lzba-dark font-heading mb-1">
              Nenhum projeto nesta categoria no momento
            </p>
            <p class="text-xs text-lzba-muted font-light">
              Em breve novos empreendimentos serão anunciados pela LZBA.
            </p>
          </div>
          {
            todosProjetos.map((item, index) => (
              <ProjectCard item={item} index={index} />
            ))
          }
        </div>

        <!-- Barra de progresso horizontal sutil -->
        <div
          class="mt-4 h-px w-full bg-lzba-border overflow-hidden"
          aria-hidden="true"
        >
          <div
            id="projects-scroll-progress"
            class="h-full bg-lzba-gold origin-left transition-transform duration-150 ease-out"
            style="transform: scaleX(0);"
          ></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Script de interatividade encapsulado da seção Projetos -->
<script>
  function setupProjects() {
    const filterBar = document.getElementById("projects-filter-bar");
    const filterButtons = document.querySelectorAll<HTMLButtonElement>(
      ".project-filter-btn",
    );
    const cards = document.querySelectorAll<HTMLElement>(".project-card");
    const track = document.getElementById("projects-track");

    // Filtro ativo padrão: 'destaques'
    let activeFilter = "destaques";

    // Atualiza classes visuais de um botão de filtro
    function setFilterButtonState(btn: HTMLButtonElement, isActive: boolean) {
      if (isActive) {
        btn.className =
          "project-filter-btn whitespace-nowrap px-4 py-2 rounded-full border border-lzba-gold bg-lzba-gold/15 hover:bg-lzba-gold/25 text-black hover:text-black text-xs font-bold tracking-widest uppercase transition-all duration-200 cursor-pointer";
      } else {
        btn.className =
          "project-filter-btn whitespace-nowrap px-4 py-2 rounded-full border border-lzba-dark/20 hover:border-lzba-dark hover:bg-lzba-dark/5 text-lzba-muted hover:text-black bg-transparent text-xs font-semibold tracking-widest uppercase transition-all duration-200 cursor-pointer";
      }
    }

    const emptyMsg = document.getElementById("projects-empty-message");

    // Ativar um filtro específico
    function applyFilter(filter: string) {
      filterButtons.forEach((btn) => {
        const isCurrent = btn.getAttribute("data-filter") === filter;
        setFilterButtonState(btn, isCurrent);
      });

      let visibleCount = 0;
      cards.forEach((card) => {
        const status = card.getAttribute("data-status");
        const isDestaque = card.getAttribute("data-destaque") === "true";

        let matches = false;
        if (filter === "todos") {
          matches = true;
        } else if (filter === "destaques") {
          matches = isDestaque;
        } else {
          matches = status === filter;
        }

        if (matches) {
          card.style.display = "";
          visibleCount++;
        } else {
          card.style.display = "none";
          card.classList.remove("is-active");
        }
      });

      if (emptyMsg) {
        if (visibleCount === 0) {
          emptyMsg.classList.remove("hidden");
          emptyMsg.classList.add("flex");
        } else {
          emptyMsg.classList.add("hidden");
          emptyMsg.classList.remove("flex");
        }
      }

      if (track) {
        track.scrollTo({ left: 0, behavior: "smooth" });
      }

      setTimeout(updateNavButtons, 150);
    }

    // Eventos de clique nos botões de filtro (estável, sem piscamento)
    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.getAttribute("data-filter") || "todos";
        activeFilter = filter;
        applyFilter(filter);
      });
    });

    // Interações com os Cards: hover seleciona, sair deseleciona
    cards.forEach((card) => {
      card.addEventListener("mouseenter", () => {
        cards.forEach((c) => c.classList.remove("is-active"));
        card.classList.add("is-active");
      });

      card.addEventListener("mouseleave", () => {
        card.classList.remove("is-active");
      });

      card.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.closest("a")) return; // Link navega normalmente
        const slug = card.getAttribute("data-slug");
        if (slug) {
          window.location.href = `/empreendimentos/${slug}`;
        }
      });
    });

    // Quando o mouse sair da área do trilho de cards, garantir deseleção
    if (track) {
      track.addEventListener("mouseleave", () => {
        cards.forEach((c) => c.classList.remove("is-active"));
      });
    }

    // Interceptar cliques no botão Oportunidades (Header, Drawer ou Footer)
    const oportunidadeTriggers = document.querySelectorAll<HTMLAnchorElement>(
      '[data-filter-trigger], #header-btn-oportunidades',
    );
    oportunidadeTriggers.forEach((trigger) => {
      trigger.addEventListener("click", (e) => {
        const currentPath = window.location.pathname;
        if (currentPath === "/" || currentPath === "") {
          e.preventDefault();
          const filterToApply =
            trigger.getAttribute("data-filter-trigger") || "destaques";
          activeFilter = filterToApply;
          applyFilter(filterToApply);
          const targetSection = document.getElementById("projetos");
          if (targetSection) {
            targetSection.scrollIntoView({ behavior: "smooth" });
          }
          history.pushState(null, "", `/#projetos?status=${filterToApply}`);
        }
      });
    });

    // Checar se a página foi aberta com parâmetro status ou hash
    const params = new URLSearchParams(window.location.search);
    const hash = window.location.hash;
    const requestedStatus =
      params.get("status") ||
      (hash.includes("destaques")
        ? "destaques"
        : hash.includes("lancamento")
          ? "lancamento"
          : null);

    if (
      requestedStatus &&
      (requestedStatus === "destaques" || requestedStatus === "lancamento")
    ) {
      activeFilter = requestedStatus;
      applyFilter(requestedStatus);
      setTimeout(() => {
        const targetSection = document.getElementById("projetos");
        if (targetSection) {
          targetSection.scrollIntoView({ behavior: "smooth" });
        }
      }, 150);
    } else {
      activeFilter = "destaques";
      applyFilter("destaques");
    }
    // Botões de navegação do carrossel
    const prevBtn = document.getElementById(
      "projects-prev-btn",
    ) as HTMLButtonElement | null;
    const nextBtn = document.getElementById(
      "projects-next-btn",
    ) as HTMLButtonElement | null;

    function updateNavButtons() {
      if (!track || !prevBtn || !nextBtn) return;
      const scrollLeft = Math.round(track.scrollLeft);
      const maxScroll = Math.round(track.scrollWidth - track.clientWidth);

      // Se todo o conteúdo couber na tela sem scroll, esconde ambas as setas
      if (maxScroll <= 5) {
        prevBtn.classList.add("opacity-0", "pointer-events-none");
        nextBtn.classList.add("opacity-0", "pointer-events-none");
        return;
      } else {
        prevBtn.classList.remove("opacity-0");
        nextBtn.classList.remove("opacity-0");
      }

      // Seta Anterior
      if (scrollLeft <= 10) {
        prevBtn.disabled = true;
        prevBtn.classList.add("opacity-25", "pointer-events-none");
      } else {
        prevBtn.disabled = false;
        prevBtn.classList.remove("opacity-25", "pointer-events-none");
      }

      // Seta Próximo
      if (scrollLeft >= maxScroll - 10) {
        nextBtn.disabled = true;
        nextBtn.classList.add("opacity-25", "pointer-events-none");
      } else {
        nextBtn.disabled = false;
        nextBtn.classList.remove("opacity-25", "pointer-events-none");
      }
    }

    if (prevBtn && track) {
      prevBtn.addEventListener("click", () => {
        const firstCard = track.querySelector<HTMLElement>(".project-card");
        const scrollAmount = firstCard ? firstCard.offsetWidth + 24 : 340;
        track.scrollBy({ left: -scrollAmount, behavior: "smooth" });
      });
    }

    if (nextBtn && track) {
      nextBtn.addEventListener("click", () => {
        const firstCard = track.querySelector<HTMLElement>(".project-card");
        const scrollAmount = firstCard ? firstCard.offsetWidth + 24 : 340;
        track.scrollBy({ left: scrollAmount, behavior: "smooth" });
      });
    }

    const progressBar = document.getElementById("projects-scroll-progress");

    const updateScrollProgress = () => {
      if (!track || !progressBar) return;
      const maxScroll = track.scrollWidth - track.clientWidth;
      if (maxScroll <= 0) {
        progressBar.style.transform = "scaleX(1)";
        return;
      }
      const ratio = Math.min(Math.max(track.scrollLeft / maxScroll, 0), 1);
      progressBar.style.transform = `scaleX(${Math.max(ratio, 0.12)})`;
    };

    track?.addEventListener("scroll", updateNavButtons, { passive: true });
    track?.addEventListener("scroll", updateScrollProgress, { passive: true });
    window.addEventListener("resize", updateNavButtons, { passive: true });
    window.addEventListener("resize", updateScrollProgress, { passive: true });
    updateScrollProgress();

    // Drag-to-scroll com o mouse no desktop
    if (track && track.dataset.dragBound !== "true") {
      track.dataset.dragBound = "true";
      track.classList.add("cursor-grab");

      let isDragging = false;
      let hasMoved = false;
      let startX = 0;
      let startScrollLeft = 0;

      track.addEventListener("mousedown", (e: MouseEvent) => {
        if (e.button !== 0) return;
        isDragging = true;
        hasMoved = false;
        startX = e.pageX - track.offsetLeft;
        startScrollLeft = track.scrollLeft;
        track.classList.add("cursor-grabbing");
        track.classList.remove("cursor-grab");
      });

      track.addEventListener("mousemove", (e: MouseEvent) => {
        if (!isDragging) return;
        const x = e.pageX - track.offsetLeft;
        const walk = x - startX;
        if (Math.abs(walk) > 5) {
          hasMoved = true;
        }
        e.preventDefault();
        track.scrollLeft = startScrollLeft - walk;
      });

      const stopDragging = () => {
        if (!isDragging) return;
        isDragging = false;
        track.classList.remove("cursor-grabbing");
        track.classList.add("cursor-grab");
      };

      track.addEventListener("mouseup", stopDragging);
      track.addEventListener("mouseleave", stopDragging);

      track.addEventListener(
        "click",
        (e: MouseEvent) => {
          if (hasMoved) {
            e.preventDefault();
            e.stopPropagation();
            hasMoved = false;
          }
        },
        true,
      );
    }

    // Inicialização da visibilidade dos botões
    setTimeout(updateNavButtons, 200);
  }

  // Executar após renderização
  setupProjects();
  document.addEventListener("astro:page-load", setupProjects);
</script>
