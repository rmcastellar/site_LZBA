---
import { NUMEROS_LZBA } from "../../data/empreendimentos";
---

<!-- 1. HERO SECTION (ALINHADO AO TOPO DA TELA ATRÁS DO HEADER) -->
<section
  class="relative min-h-[100dvh] flex flex-col justify-between pt-24 sm:pt-36 lg:pt-40 pb-8 sm:pb-12 overflow-hidden bg-lzba-dark"
>
  <!-- Imagem de Fundo com Overlay Quente e Arquitetônico -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/02023-scaled-1.jpg"
      alt="Fachada Empreendimento LZBA"
      class="w-full h-full object-cover object-top sm:object-center brightness-[1] scale-100"
      loading="eager"
    />
    <!-- Overlay escuro arquitetônico derivado da paleta centralizada -->
    <div class="absolute inset-0 hero-overlay"></div>
  </div>

  <!-- Conteúdo Central do Hero -->
  <div
    class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full my-auto"
  >
    <div class="max-w-3xl">
      <!-- Título em Caixa Alta e Peso Firme -->
      <h1
        class="animate-hero-1 text-2xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight uppercase leading-[1.14] font-heading"
      >
        Solidez técnica e <br class="hidden sm:inline" />
        tradição que valorizam <br class="hidden sm:inline" />
        o patrimônio da sua família.
      </h1>

      <!-- Subtítulo / Descrição fiel -->
      <p
        class="animate-hero-2 text-xs sm:text-base lg:text-lg text-neutral-300 max-w-2xl mt-4 sm:mt-6 font-light leading-relaxed"
      >
        Há 34 anos transformando projetos em lares funcionais de alta
        consistência executiva. Mais de 1.340 apartamentos rigorosamente
        planejados, construídos e entregues.
      </p>

      <!-- Botão Nossos Projetos (Estilo Outline com Moldura) -->
      <div class="animate-hero-3 mt-6 sm:mt-10">
        <a
          href="#projetos"
          class="inline-block px-6 sm:px-8 py-3 sm:py-3.5 border border-white/60 hover:border-lzba-gold text-xs sm:text-sm font-semibold tracking-widest uppercase text-white hover:text-lzba-gold hover:bg-white/10 transition-all duration-200"
        >
          NOSSOS PROJETOS
        </a>
      </div>
    </div>
  </div>

  <!-- Barra de Métricas na Base do Hero (Separada por linha sutil) -->
  <div
    class="animate-hero-4 relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full mt-6 sm:mt-16"
  >
    <div class="border-t border-white/20 pt-4 sm:pt-8">
      <div class="grid grid-cols-3 gap-4 sm:gap-12 max-w-3xl">
        <!-- Métrica 1 -->
        <div>
          <span
            class="block text-[9px] sm:text-xs uppercase tracking-wider text-lzba-muted font-semibold leading-tight"
          >
            Anos de<br />Experiência
          </span>
          <span
            class="block text-2xl sm:text-5xl font-bold text-white mt-1 sm:mt-2 font-heading"
          >
            {NUMEROS_LZBA.anosCarreira}
          </span>
        </div>

        <!-- Métrica 2 -->
        <div>
          <span
            class="block text-[9px] sm:text-xs uppercase tracking-wider text-lzba-muted font-semibold leading-tight"
          >
            Empreendimentos<br />Entregues
          </span>
          <span
            class="block text-2xl sm:text-5xl font-bold text-white mt-1 sm:mt-2 font-heading"
          >
            {NUMEROS_LZBA.obrasEntregues}
          </span>
        </div>

        <!-- Métrica 3 -->
        <div>
          <span
            class="block text-[9px] sm:text-xs uppercase tracking-wider text-lzba-muted font-semibold leading-tight"
          >
            Unidades<br />Entregues
          </span>
          <span
            class="block text-2xl sm:text-5xl font-bold text-white mt-1 sm:mt-2 font-heading"
          >
            {NUMEROS_LZBA.aptosEntregues}
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
