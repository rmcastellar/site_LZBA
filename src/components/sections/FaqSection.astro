---
// Dados das perguntas frequentes com temática técnica, operacional e contratual
const faqs = [
  {
    id: "01",
    question: "Como o cliente acompanha a evolução da obra?",
    answer:
      "Disponibilizamos relatórios periódicos e registros fotográficos detalhados sobre o avanço de cada fase (infraestrutura, alvenaria, acabamentos) diretamente através do nosso canal de comunicação.",
  },
  {
    id: "02",
    question: "Quais são os padrões de acabamento e controle de qualidade?",
    answer:
      "Trabalhamos com especificações técnicas rigorosas e marcas líderes homologadas pelo mercado nacional, com inspeção sistemática de cada material aplicado para garantir durabilidade, desempenho acústico e conformidade com as normas ABNT.",
  },
  {
    id: "03",
    question: "Qual é o procedimento de vistoria antes da entrega das chaves?",
    answer:
      "A entrega é precedida por uma vistoria técnica individual, onde o proprietário e nosso responsável técnico validam cada detalhe conforme o memorial descritivo antes da assinatura final do termo de entrega.",
  },
  {
    id: "04",
    question: "Qual é a política de garantia técnica e suporte pós-entrega?",
    answer:
      "Todos os empreendimentos contam com garantia legal estrutural e operacional alinhada à ABNT NBR 15575 e ao Código Civil, amparados por um canal técnico ágil e estruturado para vistorias e assistência durante toda a fase pós-ocupação.",
  },
];
---

<!-- 6. DÚVIDAS FREQUENTES (FOTO + ESCLARECIMENTOS TÉCNICOS E CONTRATUAIS) -->
<section id="faq" class="py-20 lg:py-28 bg-white text-lzba-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Cabeçalho -->
    <div class="reveal-up mb-12">
      <span class="text-xs uppercase font-bold tracking-widest text-lzba-gold block mb-2 font-sans">
        DÚVIDAS FREQUENTES
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-lzba-dark tracking-tight font-heading leading-tight">
        Esclarecimentos Técnicos e Contratuais
      </h2>
      <p class="text-sm text-neutral-500 mt-2 font-light">
        Passe o mouse ou clique sobre uma questão para visualizar os detalhes.
      </p>
    </div>

    <!-- Layout 2 Colunas: Foto e Accordion Interativo -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Coluna da Esquerda: Foto Técnica de Engenharia -->
      <div class="reveal-left lg:col-span-5 lg:sticky lg:top-28">
        <div class="group overflow-hidden shadow-lg border border-lzba-border aspect-4/3 sm:aspect-4/5 lg:aspect-auto lg:h-145 bg-lzba-light relative">
          <img
            src="/images/faq-engenharia.webp"
            alt="Inspeção técnica e engenharia de projetos LZBA"
            class="w-full h-full object-cover object-[70%_center] transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-linear-to-t from-lzba-dark/75 via-lzba-dark/20 to-transparent"></div>
        </div>
      </div>

      <!-- Coluna da Direita: Lista Dinâmica e Interativa de FAQ -->
      <div
        id="faq-accordion"
        class="lg:col-span-7 space-y-4"
        data-faq-accordion
      >
        {faqs.map((faq, index) => (
          <div
            class={`faq-item reveal-right delay-${(index + 1) * 100} group border-b border-lzba-border first:border-t transition-colors duration-300`}
            data-faq-item
          >
            <button
              type="button"
              class="faq-trigger w-full text-left py-6 sm:py-7 flex items-center justify-between gap-4 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-lzba-gold select-none"
              aria-expanded="false"
              aria-controls={`faq-answer-${faq.id}`}
              id={`faq-trigger-${faq.id}`}
            >
              <div class="flex items-baseline gap-4 sm:gap-6">
                <span class="font-mono text-xs text-lzba-gold tabular-nums tracking-widest shrink-0">
                  {faq.id}
                </span>
                <h3 class="faq-question text-base sm:text-lg font-bold text-lzba-dark font-heading leading-snug transition-colors group-hover:text-lzba-red">
                  {faq.question}
                </h3>
              </div>
              <span
                class="w-6 h-6 flex items-center justify-center shrink-0 text-lzba-dark group-hover:text-lzba-gold transition-colors duration-300"
                aria-hidden="true"
              >
                <svg
                  class="faq-icon w-4 h-4 transition-transform duration-300"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  stroke-width="1.8"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 5v14M5 12h14"
                  />
                </svg>
              </span>
            </button>

            <div
              class="faq-content"
              id={`faq-answer-${faq.id}`}
              role="region"
              aria-labelledby={`faq-trigger-${faq.id}`}
            >
              <div>
                <div class="pb-6 pt-1 pl-8 sm:pl-11">
                  <div class="w-10 h-px bg-lzba-gold/70 mb-3 faq-divider" />
                  <p class="faq-text text-xs sm:text-sm text-neutral-600 leading-relaxed font-light">
                    {faq.answer}
                  </p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Expansão dinâmica suave via CSS Grid (0fr -> 1fr) */
  .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-content > div {
    overflow: hidden;
  }

  .faq-text,
  .faq-divider {
    opacity: 0;
    transition: opacity 280ms ease 40ms;
  }

  /* Estado Aberto (is-open) */
  .faq-item.is-open .faq-content {
    grid-template-rows: 1fr;
  }

  .faq-item.is-open .faq-text,
  .faq-item.is-open .faq-divider {
    opacity: 1;
  }

  .faq-item.is-open .faq-icon {
    transform: rotate(45deg);
  }
</style>

<script>
  function setupFaqAccordion() {
    const faqContainer = document.getElementById("faq-accordion");
    if (!faqContainer) return;

    // Se já estiver inicializado neste container, evita listeners duplicados
    if (faqContainer.dataset.initialized === "true") return;
    faqContainer.dataset.initialized = "true";

    const items = faqContainer.querySelectorAll<HTMLElement>("[data-faq-item]");
    if (!items.length) return;

    let openIndex = -1;

    function render() {
      items.forEach((item, index) => {
        const isOpen = index === openIndex;
        const trigger = item.querySelector(".faq-trigger");

        if (isOpen) {
          item.classList.add("is-open");
          trigger?.setAttribute("aria-expanded", "true");
        } else {
          item.classList.remove("is-open");
          trigger?.setAttribute("aria-expanded", "false");
        }
      });
    }

    items.forEach((item, index) => {
      const trigger = item.querySelector(".faq-trigger");

      trigger?.addEventListener("click", () => {
        openIndex = openIndex === index ? -1 : index;
        render();
      });
    });

    // Estado inicial: apenas perguntas visíveis por padrão
    render();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupFaqAccordion);
  } else {
    setupFaqAccordion();
  }

  // Suporte a transições de página do Astro
  document.addEventListener("astro:page-load", setupFaqAccordion);
</script>
