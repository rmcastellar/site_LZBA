---
interface Pilar {
  numero: string;
  titulo: string;
  descricao: string;
}

const pilares: Pilar[] = [
  {
    numero: "01",
    titulo: "Tradição Operacional e Presença Contínua",
    descricao:
      "Três décadas e meia construindo pontes sólidas com clientes, instituições financeiras e parceiros. A longevidade da LZBA é o maior aval de que seu projeto tem lastro, respaldo técnico e entrega assegurada.",
  },
  {
    numero: "02",
    titulo: "Consistência Construtiva e Design Inteligente",
    descricao:
      "Nossos projetos arquitetônicos unem sofisticação visual e inteligência espacial. Plantas otimizadas para a dinâmica real de famílias classe A/B, garantindo conforto acústico, ventilação equilibrada e baixa depreciação predial.",
  },
  {
    numero: "03",
    titulo: "Governança do Canteiro ao Pós-Venda",
    descricao:
      "Da seleção de insumos estruturais à vistoria técnica de entrega das chaves, nossa gestão é presente em cada etapa. Honramos o contrato com diálogo direto, rigor de cronograma e assistência pós-obra dedicada.",
  },
];
---

<!-- 2. COMO FAZEMOS (PILARES E DIFERENCIAIS DE SOLIDEZ) -->
<section class="py-20 lg:py-28 bg-white text-lzba-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Coluna Esquerda Fixa (Editorial) -->
      <div class="reveal-up lg:col-span-5 lg:sticky lg:top-32">
        <span class="text-xs uppercase font-bold tracking-widest text-lzba-gold block mb-3 font-sans">
          COMO FAZEMOS
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-lzba-dark tracking-tight font-heading leading-tight">
          Segurança patrimonial fundamentada em solidez e método
        </h2>
        <p class="text-sm sm:text-base text-neutral-600 mt-5 leading-relaxed font-light">
          Décadas de histórico comprovam que estabilidade e previsibilidade são
          os maiores ativos de um investimento residencial.
        </p>

        <div class="mt-8">
          <a
            href="/sobre"
            class="inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-widest text-lzba-dark hover:text-lzba-red transition-colors group"
          >
            <span>Conheça nossa história</span>
            <span
              class="inline-block w-6 h-px bg-lzba-gold group-hover:w-10 transition-all duration-300"
              aria-hidden="true"
            ></span>
          </a>
        </div>
      </div>

      <!-- Coluna Direita (Lista Vertical Arquitetônica) -->
      <div class="lg:col-span-7 divide-y divide-lzba-border border-y border-lzba-border">
        {
          pilares.map((pilar, index) => (
            <article
              class={`reveal-up delay-${(index + 1) * 100} group relative py-8 sm:py-10`}
            >
              <span
                class="absolute top-0 left-0 w-full h-px bg-lzba-gold origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500 ease-out"
                aria-hidden="true"
              ></span>

              <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 sm:gap-6 items-start">
                <span class="sm:col-span-2 font-mono text-xs sm:text-sm tracking-widest text-lzba-gold font-semibold tabular-nums pt-1">
                  {pilar.numero}
                </span>

                <div class="sm:col-span-10">
                  <h3 class="text-base sm:text-xl font-bold text-lzba-dark font-heading mb-3 group-hover:text-lzba-red transition-colors duration-300">
                    {pilar.titulo}
                  </h3>
                  <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed font-light">
                    {pilar.descricao}
                  </p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
