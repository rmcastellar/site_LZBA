---
import type { ArtigoBlog } from '../../data/artigos';

interface Props {
  artigo: ArtigoBlog;
  url: string;
}

const { artigo, url } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://lzba.com.br';
const fullImageUrl = artigo.imagemCapa.startsWith('http') 
  ? artigo.imagemCapa 
  : `${siteUrl}${artigo.imagemCapa}`;

const schemaArticle = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': url,
  },
  headline: artigo.titulo,
  description: artigo.metaDescription,
  image: [fullImageUrl],
  datePublished: `${artigo.dataPublicacao}T08:00:00-03:00`,
  dateModified: `${artigo.dataPublicacao}T08:00:00-03:00`,
  author: {
    '@type': 'Organization',
    name: 'LZBA Construtora e Incorporadora',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'LZBA Construtora e Incorporadora',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/images/logo.png`,
    },
  },
  keywords: artigo.tags.join(', '),
  articleSection: artigo.categoria,
  inLanguage: 'pt-BR',
  contentLocation: {
    '@type': 'Place',
    name: artigo.geo.placename,
    address: {
      '@type': 'PostalAddress',
      addressLocality: artigo.geo.bairro,
      addressRegion: artigo.geo.estado,
      postalCode: artigo.geo.postalCode,
      addressCountry: 'BR',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: artigo.geo.latitude,
      longitude: artigo.geo.longitude,
    },
  },
  about: [
    {
      '@type': 'Place',
      name: `${artigo.geo.regiao} de São Paulo`,
      geo: {
        '@type': 'GeoCoordinates',
        latitude: artigo.geo.latitude,
        longitude: artigo.geo.longitude,
      },
    },
    {
      '@type': 'Thing',
      name: 'Mercado Imobiliário de Alto Padrão na Zona Norte de São Paulo',
    },
  ],
};

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Início',
      item: siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: `${siteUrl}/blog`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: artigo.titulo,
      item: url,
    },
  ],
};
---

<!-- GEO Meta Tags para Motores de Busca e Busca Local -->
<meta name="geo.region" content={`BR-${artigo.geo.estado}`} />
<meta name="geo.placename" content={`${artigo.geo.placename}`} />
<meta name="geo.position" content={`${artigo.geo.latitude};${artigo.geo.longitude}`} />
<meta name="ICBM" content={`${artigo.geo.latitude}, ${artigo.geo.longitude}`} />
<meta name="city" content={artigo.geo.cidade} />
<meta name="state" content={artigo.geo.estado} />
<meta name="target_country" content="BR" />

<!-- Schema.org JSON-LD (Artigo + GEO + Breadcrumb) -->
<script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} />
<script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />
