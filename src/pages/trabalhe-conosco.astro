---
import Layout from '../layouts/Layout.astro';
import CtaSection from '../components/sections/CtaSection.astro';
import { CONTATO_LZBA } from '../data/empreendimentos';

const whatsappCorretoresLink = `https://wa.me/5511999618125?text=${encodeURIComponent('Olá! Sou corretor/imobiliária e gostaria de me credenciar para vender os empreendimentos da LZBA.')}`;
---

<Layout
  title="Trabalhe Conosco | Portal de Corretores e Imobiliárias LZBA"
  description="Cadastre-se como corretor parceiro ou imobiliária credenciada na Construtora LZBA. Tenha acesso a tabelas de vendas, espelhos de unidades, materiais de marketing e comissionamento garantido."
  currentPath="/trabalhe-conosco"
>
  <!-- 1. HERO INSTITUCIONAL (PADRÃO ESTÉTICO LZBA) -->
  <section class="relative pt-24 pb-16 sm:pb-20 overflow-hidden bg-lzba-dark text-white">
    <!-- Imagem de Fundo com Overlay Arquitetônico -->
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 hero-overlay"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full my-auto">
      <div class="max-w-3xl">
        <span class="animate-hero-1 text-xs uppercase font-bold tracking-widest text-lzba-gold block mb-3 font-sans">
          PARCERIAS COMERCIAIS • CANAL OFICIAL
        </span>
        <h1 class="animate-hero-2 text-3xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight uppercase leading-[1.12] font-heading">
          Canal de Corretores<br />e Imobiliárias
        </h1>
        <p class="animate-hero-3 text-sm sm:text-base lg:text-lg text-neutral-300 max-w-2xl mt-4 font-light leading-relaxed">
          Seja um parceiro credenciado da Construtora e Incorporadora LZBA. Tenha acesso a tabelas atualizadas de lançamentos e unidades prontas, espelhos de vendas em tempo real e comissionamento transparente com segurança jurídica.
        </p>

        <div class="animate-hero-4 flex flex-wrap items-center gap-3 mt-8">
          <a
            href={whatsappCorretoresLink}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 text-xs font-bold uppercase tracking-widest text-lzba-dark bg-lzba-gold hover:bg-amber-400 transition-all duration-300 shadow-md flex items-center gap-2.5 border border-lzba-gold cursor-pointer"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.149.929 3.182 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.288.043.088.072.189.014.305-.058.115-.087.188-.173.289l-.26.309c-.087.086-.179.18-.077.355.101.173.45 0.742.966 1.202.665.592 1.226.776 1.399.863.173.086.275.072.376-.044.101-.116.433-.506.549-.679.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.044.073.044.419-.1 0.824z"/>
            </svg>
            <span>Plantão de Parcerias</span>
          </a>
          <a
            href="#formulario"
            class="px-6 py-3.5 text-xs font-semibold uppercase tracking-widest text-white bg-white/10 hover:bg-white/20 border border-white/20 backdrop-blur-xs transition-all duration-300"
          >
            Formulário de Credenciamento
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. PILARES DO CORRETOR (MOLDURA ARQUITETÔNICA ELEGANTE) -->
  <section class="relative z-20 -mt-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="reveal-up bg-white border border-lzba-border shadow-xl p-6 sm:p-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center divide-y md:divide-y-0 md:divide-x divide-lzba-border/80">
        <div class="pt-2 md:pt-0">
          <span class="block text-[11px] uppercase tracking-widest text-neutral-500 font-semibold font-sans">Comissão Garantida</span>
          <span class="text-base sm:text-lg font-bold text-lzba-dark font-heading mt-1 block">Honorários Pontuais</span>
          <p class="text-xs text-neutral-600 mt-1 font-light">Contratos claros com respeito total à intermediação</p>
        </div>
        <div class="pt-4 md:pt-0">
          <span class="block text-[11px] uppercase tracking-widest text-neutral-500 font-semibold font-sans">Material Comercial</span>
          <span class="text-base sm:text-lg font-bold text-lzba-dark font-heading mt-1 block">Books, Renders e Plantas</span>
          <p class="text-xs text-neutral-600 mt-1 font-light">Suporte completo para impulsionar suas apresentações</p>
        </div>
        <div class="pt-4 md:pt-0">
          <span class="block text-[11px] uppercase tracking-widest text-neutral-500 font-semibold font-sans">Atendimento Ágil</span>
          <span class="text-base sm:text-lg font-bold text-lzba-dark font-heading mt-1 block">Gerência Direta</span>
          <p class="text-xs text-neutral-600 mt-1 font-light">Validação imediata de propostas e suporte em visitas</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. CONTEÚDO PRINCIPAL: VANTAGENS + FORMULÁRIO -->
  <section class="py-16 sm:py-24 bg-neutral-50/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-start">
        
        <!-- Coluna Esquerda: Benefícios e Contato Direto -->
        <div class="lg:col-span-5 space-y-8">
          <div class="reveal-up space-y-3">
            <span class="text-xs font-bold uppercase tracking-widest text-lzba-gold block font-sans">
              VANTAGENS EXCLUSIVAS
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold text-lzba-dark font-heading tracking-tight">
              Por que ser um parceiro LZBA?
            </h2>
            <div class="w-12 h-0.5 bg-lzba-gold my-2"></div>
            <p class="text-neutral-700 text-sm sm:text-base leading-relaxed font-light">
              Trabalhamos lado a lado com imobiliárias e corretores autônomos para oferecer a melhor experiência de compra aos clientes e total segurança aos profissionais de vendas.
            </p>
          </div>

          <!-- Cards de Vantagens -->
          <div class="space-y-4">
            
            <div class="reveal-up delay-100 p-5 bg-white border border-lzba-border shadow-2xs hover:border-lzba-gold/60 transition-all flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-lzba-gold/15 flex items-center justify-center text-amber-900 shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-lzba-dark font-heading">Tabelas e Espelhos de Vendas</h3>
                <p class="text-xs sm:text-sm text-neutral-600 mt-1 leading-relaxed font-light">
                  Acesso rápido a valores vigentes, condições facilitadas de fluxo de pagamento e disponibilidade de unidades para oferta imediata.
                </p>
              </div>
            </div>

            <div class="reveal-up delay-200 p-5 bg-white border border-lzba-border shadow-2xs hover:border-lzba-gold/60 transition-all flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-lzba-gold/15 flex items-center justify-center text-amber-900 shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-lzba-dark font-heading">Comissionamento Transparente</h3>
                <p class="text-xs sm:text-sm text-neutral-600 mt-1 leading-relaxed font-light">
                  Honorários de corretagem rigorosamente respeitados, com contratos seguros e prazos pré-determinados pela incorporadora.
                </p>
              </div>
            </div>

            <div class="reveal-up delay-300 p-5 bg-white border border-lzba-border shadow-2xs hover:border-lzba-gold/60 transition-all flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-lzba-gold/15 flex items-center justify-center text-amber-900 shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-lzba-dark font-heading">Material de Marketing Completo</h3>
                <p class="text-xs sm:text-sm text-neutral-600 mt-1 leading-relaxed font-light">
                  Disponibilizamos books digitais de apresentação, plantas humanizadas, perspectivas 3D em alta resolução e vídeos para redes sociais.
                </p>
              </div>
            </div>

            <div class="reveal-up delay-400 p-5 bg-white border border-lzba-border shadow-2xs hover:border-lzba-gold/60 transition-all flex items-start gap-4">
              <div class="w-10 h-10 rounded-full bg-lzba-gold/15 flex items-center justify-center text-amber-900 shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-lzba-dark font-heading">Suporte Direto da Incorporadora</h3>
                <p class="text-xs sm:text-sm text-neutral-600 mt-1 leading-relaxed font-light">
                  Apoio da gerência comercial para alinhamento de propostas, tirada de dúvidas jurídicas e suporte nos plantões presenciais.
                </p>
              </div>
            </div>

          </div>

          <!-- Chamada WhatsApp Especial Corretores -->
          <div class="reveal-up p-6 bg-lzba-light border border-lzba-gold/40 space-y-3">
            <span class="text-xs font-bold uppercase tracking-wider text-lzba-gold block font-sans">
              ATENDIMENTO DIRETO A CORRETORES
            </span>
            <p class="text-xs sm:text-sm text-neutral-700 font-light leading-relaxed">
              Precisa tirar uma dúvida urgente sobre disponibilidades, agendamento de visita ou proposta de compra? Fale agora com nossa gerência.
            </p>
            <a
              href={whatsappCorretoresLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs font-bold text-lzba-dark hover:text-amber-800 uppercase tracking-wider transition-colors pt-1"
            >
              <span>Chamar Plantão de Parcerias ({CONTATO_LZBA.whatsapp})</span>
              <span class="text-lzba-gold text-base">›</span>
            </a>
          </div>
        </div>

        <!-- Coluna Direita: Formulário de Credenciamento -->
        <div class="lg:col-span-7" id="formulario">
          <div class="reveal-up bg-white border border-lzba-border border-t-4 border-t-lzba-gold shadow-xl p-8 sm:p-10 space-y-6">
            
            <div class="space-y-2">
              <span class="text-xs font-bold uppercase tracking-widest text-lzba-gold block font-sans">
                CADASTRO OFICIAL
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold text-lzba-dark font-heading leading-tight">
                Credencie-se com a LZBA
              </h2>
              <p class="text-xs sm:text-sm text-neutral-500 leading-relaxed font-light">
                Preencha os campos abaixo para que nossa gerência comercial libere seu acesso aos materiais completos, espelhos e tabelas vigentes.
              </p>
            </div>

            <form class="space-y-4" action="/contato" method="GET">
              <input type="hidden" name="tipo" value="corretor_parceiro" />

              <!-- Tipo de Profissional -->
              <div>
                <label class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-2">Perfil de Atuação *</label>
                <div class="grid grid-cols-2 gap-3">
                  <label class="flex items-center gap-2.5 p-3 bg-neutral-50 border border-lzba-border text-xs text-neutral-800 font-medium cursor-pointer hover:border-lzba-gold transition-colors">
                    <input type="radio" name="perfil" value="imobiliaria" checked class="accent-lzba-gold" />
                    <span>Imobiliária</span>
                  </label>
                  <label class="flex items-center gap-2.5 p-3 bg-neutral-50 border border-lzba-border text-xs text-neutral-800 font-medium cursor-pointer hover:border-lzba-gold transition-colors">
                    <input type="radio" name="perfil" value="autonomo" class="accent-lzba-gold" />
                    <span>Corretor Autônomo</span>
                  </label>
                </div>
              </div>

              <!-- Nome Completo & CRECI -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="corr-nome" class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1">Nome Completo *</label>
                  <input
                    type="text"
                    id="corr-nome"
                    name="nome"
                    required
                    placeholder="Seu nome completo"
                    class="w-full px-3.5 py-2.5 bg-neutral-50 border border-lzba-border text-neutral-900 placeholder-neutral-400 text-sm focus:outline-none focus:border-lzba-gold focus:bg-white transition-colors"
                  />
                </div>

                <div>
                  <label for="corr-creci" class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1">Número do CRECI (com UF) *</label>
                  <input
                    type="text"
                    id="corr-creci"
                    name="creci"
                    required
                    placeholder="Ex: 123456-F/SP"
                    class="w-full px-3.5 py-2.5 bg-neutral-50 border border-lzba-border text-neutral-900 placeholder-neutral-400 text-sm focus:outline-none focus:border-lzba-gold focus:bg-white transition-colors"
                  />
                </div>
              </div>

              <!-- Imobiliária (opcional) & Região -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="corr-imobiliaria" class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1">Nome da Imobiliária</label>
                  <input
                    type="text"
                    id="corr-imobiliaria"
                    name="imobiliaria"
                    placeholder="Empresa associada"
                    class="w-full px-3.5 py-2.5 bg-neutral-50 border border-lzba-border text-neutral-900 placeholder-neutral-400 text-sm focus:outline-none focus:border-lzba-gold focus:bg-white transition-colors"
                  />
                </div>

                <div>
                  <label for="corr-regiao" class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1">Região de Principal Atuação *</label>
                  <input
                    type="text"
                    id="corr-regiao"
                    name="regiao"
                    required
                    placeholder="Ex: Zona Norte, Santana, Tucuruvi..."
                    class="w-full px-3.5 py-2.5 bg-neutral-50 border border-lzba-border text-neutral-900 placeholder-neutral-400 text-sm focus:outline-none focus:border-lzba-gold focus:bg-white transition-colors"
                  />
                </div>
              </div>

              <!-- E-mail & Celular -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="corr-email" class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1">E-mail Profissional *</label>
                  <input
                    type="email"
                    id="corr-email"
                    name="email"
                    required
                    placeholder="seu.email@exemplo.com"
                    class="w-full px-3.5 py-2.5 bg-neutral-50 border border-lzba-border text-neutral-900 placeholder-neutral-400 text-sm focus:outline-none focus:border-lzba-gold focus:bg-white transition-colors"
                  />
                </div>

                <div>
                  <label for="corr-celular" class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1">Celular / WhatsApp *</label>
                  <input
                    type="tel"
                    id="corr-celular"
                    name="telefone"
                    required
                    placeholder="(11) 90000-0000"
                    class="w-full px-3.5 py-2.5 bg-neutral-50 border border-lzba-border text-neutral-900 placeholder-neutral-400 text-sm focus:outline-none focus:border-lzba-gold focus:bg-white transition-colors"
                  />
                </div>
              </div>

              <!-- Mensagem -->
              <div>
                <label for="corr-mensagem" class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1">Observações ou Mensagem</label>
                <textarea
                  id="corr-mensagem"
                  name="mensagem"
                  rows="3"
                  placeholder="Gostaria de receber tabelas de vendas e espelhos dos empreendimentos..."
                  class="w-full px-3.5 py-2.5 bg-neutral-50 border border-lzba-border text-neutral-900 placeholder-neutral-400 text-sm focus:outline-none focus:border-lzba-gold focus:bg-white transition-colors resize-none"
                ></textarea>
              </div>

              <!-- Botão de Envio -->
              <button
                type="submit"
                class="w-full py-4 px-6 text-xs font-bold uppercase tracking-widest text-lzba-dark bg-lzba-gold hover:bg-amber-400 border border-lzba-gold transition-all duration-300 shadow-md cursor-pointer"
              >
                Solicitar Credenciamento e Tabelas
              </button>

              <p class="text-[11px] text-neutral-500 text-center leading-relaxed font-light">
                Ao enviar seus dados, você concorda com o tratamento de informações conforme nossa <a href="/politica-de-privacidade" class="text-neutral-700 underline hover:text-lzba-gold">Política de Privacidade</a>.
              </p>
            </form>

          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 4. BANNER INSTITUCIONAL DE FECHAMENTO -->
  <CtaSection />
</Layout>
