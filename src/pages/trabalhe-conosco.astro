---
import Layout from '../layouts/Layout.astro';
import { CONTATO_LZBA } from '../data/empreendimentos';

const whatsappCorretoresLink = `https://wa.me/5511999618125?text=${encodeURIComponent('Olá! Sou corretor/imobiliária e gostaria de me credenciar para vender os empreendimentos da LZBA.')}`;
---

<Layout
  title="Trabalhe Conosco | Portal de Corretores e Imobiliárias LZBA"
  description="Cadastre-se como corretor parceiro ou imobiliária credenciada na LZBA. Tenha acesso a tabelas de vendas, espelho de unidades, materiais de marketing e comissionamento pontual."
  currentPath="/trabalhe-conosco"
>
  <!-- Cabeçalho -->
  <section class="relative pt-20 pb-14 bg-gradient-to-b from-[#111827] to-[#0b0f17] border-b border-white/5">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs font-bold uppercase tracking-widest text-[#e5c07b]">
        Parcerias Comerciais
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white font-heading mt-2 mb-4">
        Canal de Corretores e Imobiliárias
      </h1>
      <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto font-light leading-relaxed">
        Seja um parceiro credenciado da LZBA. Acesse tabelas atualizadas de lançamentos e revendas, material comercial completo e comissões garantidas.
      </p>
    </div>
  </section>

  <!-- Conteúdo Principal: Benefícios + Formulário -->
  <section class="py-16 sm:py-24 bg-[#0b0f17]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Coluna Esquerda: Benefícios da Parceria -->
        <div class="lg:col-span-5 space-y-8">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-[#e5c07b]">
              Vantagens Exclusivas
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading mt-1">
              Por que ser um parceiro LZBA?
            </h2>
            <p class="text-slate-400 text-sm mt-3 leading-relaxed">
              Trabalhamos lado a lado com imobiliárias e corretores credenciados para oferecer a melhor experiência ao cliente final e segurança para os profissionais de intermediação.
            </p>
          </div>

          <div class="space-y-4">
            
            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white/5 border border-white/5">
              <div class="w-10 h-10 rounded-xl bg-[#c5a880]/15 flex items-center justify-center text-[#e5c07b] shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-white font-heading">Tabelas e Espelhos de Vendas</h3>
                <p class="text-xs text-slate-400 mt-1 leading-relaxed">
                  Acesso rápido aos valores vigentes, condições de fluxo de pagamento e unidades disponíveis para oferta imediata.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white/5 border border-white/5">
              <div class="w-10 h-10 rounded-xl bg-[#c5a880]/15 flex items-center justify-center text-[#e5c07b] shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-white font-heading">Comissionamento Transparente</h3>
                <p class="text-xs text-slate-400 mt-1 leading-relaxed">
                  Honorários de corretagem respeitados integralmente, com prazos claros e segurança contratual LZBA.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white/5 border border-white/5">
              <div class="w-10 h-10 rounded-xl bg-[#c5a880]/15 flex items-center justify-center text-[#e5c07b] shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-white font-heading">Material de Marketing Completo</h3>
                <p class="text-xs text-slate-400 mt-1 leading-relaxed">
                  Disponibilizamos books de vendas digitais, plantas humanizadas em alta definição, renders 3D e vídeos institucionais.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-2xl bg-white/5 border border-white/5">
              <div class="w-10 h-10 rounded-xl bg-[#c5a880]/15 flex items-center justify-center text-[#e5c07b] shrink-0 mt-0.5">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-white font-heading">Suporte Direto da Incorporadora</h3>
                <p class="text-xs text-slate-400 mt-1 leading-relaxed">
                  Canal aberto para validação rápida de propostas comerciais e suporte nas negociações com seus clientes.
                </p>
              </div>
            </div>

          </div>

          <!-- Chamada WhatsApp Especial Corretores -->
          <div class="p-6 rounded-2xl bg-emerald-950/40 border border-emerald-800/40 space-y-3">
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 block">
              Atendimento Direto a Corretores
            </span>
            <p class="text-xs text-slate-300">
              Precisa tirar uma dúvida urgente sobre disponibilidade ou proposta? Fale pelo WhatsApp comercial.
            </p>
            <a
              href={whatsappCorretoresLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs font-bold text-emerald-400 hover:text-emerald-300 underline"
            >
              <span>Chamar Plantão de Parcerias ({CONTATO_LZBA.whatsapp})</span>
              <span>›</span>
            </a>
          </div>
        </div>

        <!-- Coluna Direita: Formulário de Credenciamento -->
        <div class="lg:col-span-7">
          <div class="glass-panel p-8 sm:p-10 rounded-3xl border border-white/10 shadow-2xl">
            
            <div class="mb-8">
              <span class="text-xs font-bold uppercase tracking-wider text-[#e5c07b]">
                Formulário de Cadastro
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading mt-1">
                Credencie-se com a LZBA
              </h2>
              <p class="text-xs text-slate-400 mt-2">
                Preencha os campos abaixo para que nossa gerência de vendas libere seu acesso aos materiais e tabelas vigentes.
              </p>
            </div>

            <form class="space-y-4" action="/contato" method="GET">
              <input type="hidden" name="tipo" value="corretor_parceiro" />

              <!-- Tipo de Profissional -->
              <div>
                <label class="block text-xs font-medium text-slate-300 mb-2">Perfil de Atuação</label>
                <div class="grid grid-cols-2 gap-3">
                  <label class="flex items-center gap-2 p-3 rounded-xl bg-slate-900 border border-white/10 text-xs text-slate-300 cursor-pointer hover:border-[#c5a880]/50 transition-colors">
                    <input type="radio" name="perfil" value="imobiliaria" checked class="text-[#c5a880] focus:ring-0" />
                    <span>Imobiliária</span>
                  </label>
                  <label class="flex items-center gap-2 p-3 rounded-xl bg-slate-900 border border-white/10 text-xs text-slate-300 cursor-pointer hover:border-[#c5a880]/50 transition-colors">
                    <input type="radio" name="perfil" value="autonomo" class="text-[#c5a880] focus:ring-0" />
                    <span>Corretor Autônomo</span>
                  </label>
                </div>
              </div>

              <!-- Nome Completo & CRECI -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="corr-nome" class="block text-xs font-medium text-slate-300 mb-1">Nome Completo *</label>
                  <input
                    type="text"
                    id="corr-nome"
                    name="nome"
                    required
                    placeholder="Seu nome completo"
                    class="w-full px-4 py-3 rounded-xl bg-slate-900/90 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#c5a880] transition-colors"
                  />
                </div>

                <div>
                  <label for="corr-creci" class="block text-xs font-medium text-slate-300 mb-1">Número do CRECI (com UF) *</label>
                  <input
                    type="text"
                    id="corr-creci"
                    name="creci"
                    required
                    placeholder="Ex: 123456-F/SP"
                    class="w-full px-4 py-3 rounded-xl bg-slate-900/90 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#c5a880] transition-colors"
                  />
                </div>
              </div>

              <!-- Imobiliária (opcional) & Região -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="corr-imobiliaria" class="block text-xs font-medium text-slate-300 mb-1">Nome da Imobiliária</label>
                  <input
                    type="text"
                    id="corr-imobiliaria"
                    name="imobiliaria"
                    placeholder="Empresa associada"
                    class="w-full px-4 py-3 rounded-xl bg-slate-900/90 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#c5a880] transition-colors"
                  />
                </div>

                <div>
                  <label for="corr-regiao" class="block text-xs font-medium text-slate-300 mb-1">Região de Principal Atuação</label>
                  <input
                    type="text"
                    id="corr-regiao"
                    name="regiao"
                    placeholder="Ex: Zona Norte, Santana, Centro..."
                    class="w-full px-4 py-3 rounded-xl bg-slate-900/90 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#c5a880] transition-colors"
                  />
                </div>
              </div>

              <!-- E-mail & Celular -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="corr-email" class="block text-xs font-medium text-slate-300 mb-1">E-mail Profissional *</label>
                  <input
                    type="email"
                    id="corr-email"
                    name="email"
                    required
                    placeholder="seu.email@exemplo.com"
                    class="w-full px-4 py-3 rounded-xl bg-slate-900/90 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#c5a880] transition-colors"
                  />
                </div>

                <div>
                  <label for="corr-celular" class="block text-xs font-medium text-slate-300 mb-1">Celular / WhatsApp *</label>
                  <input
                    type="tel"
                    id="corr-celular"
                    name="telefone"
                    required
                    placeholder="(11) 90000-0000"
                    class="w-full px-4 py-3 rounded-xl bg-slate-900/90 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#c5a880] transition-colors"
                  />
                </div>
              </div>

              <!-- Mensagem -->
              <div>
                <label for="corr-mensagem" class="block text-xs font-medium text-slate-300 mb-1">Observações ou Mensagem</label>
                <textarea
                  id="corr-mensagem"
                  name="mensagem"
                  rows="3"
                  placeholder="Gostaria de receber a tabela do Residencial Season..."
                  class="w-full px-4 py-3 rounded-xl bg-slate-900/90 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#c5a880] transition-colors resize-none"
                ></textarea>
              </div>

              <!-- Botão de Envio -->
              <button
                type="submit"
                class="w-full py-4 px-6 rounded-xl text-sm font-bold text-slate-950 bg-gradient-to-r from-[#e5c07b] to-[#c5a880] hover:from-[#f3cf8e] hover:to-[#d4b58b] shadow-xl shadow-[#c5a880]/20 transition-all cursor-pointer"
              >
                Solicitar Credenciamento e Tabelas
              </button>

              <p class="text-[11px] text-slate-500 text-center leading-relaxed">
                Ao enviar seus dados, você concorda com o tratamento de informações conforme nossa <a href="/politica-de-privacidade" class="text-slate-400 underline">Política de Privacidade</a>.
              </p>
            </form>

          </div>
        </div>

      </div>

    </div>
  </section>
</Layout>
