---
import Layout from '../../layouts/Layout.astro';
import { EMPREENDIMENTOS, CONTATO_LZBA, type Empreendimento } from '../../data/empreendimentos';

export function getStaticPaths() {
  return EMPREENDIMENTOS.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

interface Props {
  item: Empreendimento;
}

const { item } = Astro.props;

const statusStyles = {
  lancamento: 'bg-amber-500/20 text-amber-300 border-amber-500/40',
  em_obras: 'bg-sky-500/20 text-sky-300 border-sky-500/40',
  entregue: 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40',
};

const whatsappText = encodeURIComponent(`Olá! Gostaria de mais informações sobre o ${item.titulo} (${item.bairro}).`);
const whatsappCustomLink = `https://wa.me/5511999618125?text=${whatsappText}`;
---

<Layout
  title={`${item.titulo} | LZBA Construtora e Incorporadora`}
  description={`${item.titulo} em ${item.bairro}: ${item.metragem}, ${item.dormitorios}, ${item.vagas}. Conheça plantas, diferenciais e status da obra.`}
  currentPath={`/empreendimentos/${item.slug}`}
  image={item.imagemCapa}
>
  <!-- 1. HERO DO EMPREENDIMENTO -->
  <section class="relative min-h-[65vh] flex flex-col justify-end pb-12 pt-28 overflow-hidden bg-slate-950">
    <div class="absolute inset-0 z-0">
      <img 
        src={item.imagemCapa} 
        alt={item.titulo} 
        class="w-full h-full object-cover object-center brightness-[0.35]"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#0b0f17] via-[#0b0f17]/60 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Início</a>
        <span>/</span>
        <a href="/empreendimentos" class="hover:text-white transition-colors">Empreendimentos</a>
        <span>/</span>
        <span class="text-[#e5c07b] font-medium">{item.titulo}</span>
      </nav>

      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2">
            <span class={`inline-flex items-center px-3.5 py-1 rounded-full text-xs font-semibold uppercase tracking-wider border backdrop-blur-md ${statusStyles[item.status]}`}>
              {item.statusLabel}
            </span>
            <span class="text-xs text-slate-400">{item.bairro}, {item.cidade} - {item.estado}</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white font-heading">
            {item.titulo}
          </h1>
          
          <p class="text-base sm:text-lg text-slate-300 font-light max-w-2xl">
            {item.subtitulo}
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <a
            href={whatsappCustomLink}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 rounded-xl text-sm font-bold text-slate-950 bg-gradient-to-r from-[#e5c07b] to-[#c5a880] hover:from-[#f3cf8e] hover:to-[#d4b58b] shadow-xl shadow-[#c5a880]/20 transition-all flex items-center gap-2"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.149.929 3.182 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.288.043.088.072.189.014.305-.058.115-.087.188-.173.289l-.26.309c-.087.086-.179.18-.077.355.101.173.45 0.742.966 1.202.665.592 1.226.776 1.399.863.173.086.275.072.376-.044.101-.116.433-.506.549-.679.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.044.073.044.419-.1 0.824z"/>
            </svg>
            <span>Falar com Corretor</span>
          </a>
          <a
            href="#formulario"
            class="px-6 py-3.5 rounded-xl text-sm font-semibold text-white bg-white/10 hover:bg-white/15 border border-white/20 transition-all"
          >
            Quero mais detalhes
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. QUICK SPECS FLUTUANTE -->
  <section class="relative z-20 -mt-6 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="glass-panel rounded-2xl p-6 border border-white/10 shadow-2xl">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center divide-y md:divide-y-0 md:divide-x divide-white/10">
        <div class="pt-2 md:pt-0">
          <span class="block text-xs uppercase text-slate-400 font-medium">Metragem Privativa</span>
          <span class="text-xl sm:text-2xl font-bold text-white font-heading mt-1 block">{item.metragem}</span>
        </div>
        <div class="pt-2 md:pt-0">
          <span class="block text-xs uppercase text-slate-400 font-medium">Dormitórios</span>
          <span class="text-xl sm:text-2xl font-bold text-white font-heading mt-1 block">{item.dormitorios}</span>
        </div>
        <div class="pt-2 md:pt-0">
          <span class="block text-xs uppercase text-slate-400 font-medium">Suítes</span>
          <span class="text-xl sm:text-2xl font-bold text-white font-heading mt-1 block">{item.suites}</span>
        </div>
        <div class="pt-2 md:pt-0">
          <span class="block text-xs uppercase text-slate-400 font-medium">Vagas de Garagem</span>
          <span class="text-xl sm:text-2xl font-bold text-white font-heading mt-1 block">{item.vagas}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. CONTEÚDO PRINCIPAL (SOBRE + DIFERENCIAIS + FORMULÁRIO) -->
  <section class="py-16 sm:py-20 bg-[#0b0f17]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Coluna Esquerda: Descrição, Galeria, Diferenciais, Plantas, Evolução -->
        <div class="lg:col-span-8 space-y-16">
          
          <!-- Descrição -->
          <div class="space-y-4">
            <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading">
              Sobre o Empreendimento
            </h2>
            <p class="text-slate-300 text-base leading-relaxed">
              {item.descricaoCompleta}
            </p>
          </div>

          <!-- Galeria de Imagens -->
          <div class="space-y-6">
            <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading">
              Galeria do Projeto
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {item.galeria.map((img, idx) => (
                <div class="rounded-2xl overflow-hidden border border-white/10 aspect-[16/10] bg-slate-900 group">
                  <img 
                    src={img} 
                    alt={`${item.titulo} - Imagem ${idx + 1}`}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
          </div>

          <!-- Diferenciais Exclusivos -->
          <div class="space-y-6">
            <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading">
              Diferenciais do Condomínio
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {item.diferenciais.map((dif) => (
                <div class="flex items-start gap-3 p-3.5 rounded-xl bg-white/5 border border-white/5">
                  <svg class="w-5 h-5 text-[#c5a880] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span class="text-sm text-slate-200">{dif}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Plantas Disponíveis -->
          <div class="space-y-6">
            <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading">
              Opções de Plantas
            </h2>
            <div class="grid grid-cols-1 gap-6">
              {item.plantas.map((planta) => (
                <div class="glass-panel rounded-2xl p-6 border border-white/10 flex flex-col sm:flex-row items-center gap-6">
                  <div class="w-full sm:w-1/3 aspect-[4/3] rounded-xl bg-slate-900 border border-white/10 flex items-center justify-center p-4">
                    <div class="text-center">
                      <svg class="w-10 h-10 text-[#c5a880] mx-auto mb-2 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/>
                      </svg>
                      <span class="text-xs text-slate-400">Planta Humanizada</span>
                    </div>
                  </div>
                  <div class="w-full sm:w-2/3 space-y-2">
                    <div class="flex items-center justify-between">
                      <h3 class="text-xl font-bold text-white font-heading">{planta.titulo}</h3>
                      <span class="px-3 py-1 rounded-full bg-[#c5a880]/20 text-[#e5c07b] text-xs font-bold">{planta.metragem}</span>
                    </div>
                    <p class="text-sm text-slate-400 leading-relaxed">{planta.descricao}</p>
                    <a
                      href={whatsappCustomLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#e5c07b] hover:underline pt-2"
                    >
                      <span>Solicitar planta detalhada no WhatsApp</span>
                      <span>›</span>
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Status / Acompanhamento de Obras -->
          {item.estagioObras && (
            <div class="space-y-6">
              <div class="flex items-center justify-between">
                <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading">
                  Evolução da Obra
                </h2>
                <span class="text-sm font-bold text-[#e5c07b] px-3 py-1 rounded-lg bg-white/5 border border-white/10">
                  {item.estagioObras.geral}% Concluído
                </span>
              </div>

              <div class="glass-panel p-6 rounded-2xl border border-white/10 space-y-5">
                <!-- Barra Geral -->
                <div>
                  <div class="flex justify-between text-xs text-slate-300 mb-1.5 font-medium">
                    <span>Progresso Geral</span>
                    <span>{item.estagioObras.geral}%</span>
                  </div>
                  <div class="w-full bg-slate-800 h-3 rounded-full overflow-hidden">
                    <div class="bg-gradient-to-r from-[#c5a880] to-[#e5c07b] h-3 rounded-full transition-all duration-1000" style={`width: ${item.estagioObras.geral}%`}></div>
                  </div>
                </div>

                <!-- Detalhes por Etapa -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-white/10 text-xs">
                  <div>
                    <div class="flex justify-between text-slate-400 mb-1">
                      <span>Fundação</span>
                      <span class="text-white font-bold">{item.estagioObras.fundacao}%</span>
                    </div>
                    <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
                      <div class="bg-emerald-400 h-1.5 rounded-full" style={`width: ${item.estagioObras.fundacao}%`}></div>
                    </div>
                  </div>

                  <div>
                    <div class="flex justify-between text-slate-400 mb-1">
                      <span>Estrutura</span>
                      <span class="text-white font-bold">{item.estagioObras.estrutura}%</span>
                    </div>
                    <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
                      <div class="bg-sky-400 h-1.5 rounded-full" style={`width: ${item.estagioObras.estrutura}%`}></div>
                    </div>
                  </div>

                  <div>
                    <div class="flex justify-between text-slate-400 mb-1">
                      <span>Alvenaria</span>
                      <span class="text-white font-bold">{item.estagioObras.alvenaria}%</span>
                    </div>
                    <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
                      <div class="bg-amber-400 h-1.5 rounded-full" style={`width: ${item.estagioObras.alvenaria}%`}></div>
                    </div>
                  </div>

                  <div>
                    <div class="flex justify-between text-slate-400 mb-1">
                      <span>Acabamento</span>
                      <span class="text-white font-bold">{item.estagioObras.acabamento}%</span>
                    </div>
                    <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
                      <div class="bg-purple-400 h-1.5 rounded-full" style={`width: ${item.estagioObras.acabamento}%`}></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}

          <!-- Localização e Endereço -->
          <div class="space-y-4">
            <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading">
              Localização Privilegiada
            </h2>
            <div class="glass-panel p-6 rounded-2xl border border-white/10 space-y-4">
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-[#c5a880] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <div>
                  <h3 class="text-base font-bold text-white">{item.endereco}</h3>
                  <p class="text-sm text-slate-400 mt-0.5">{item.bairro}, {item.cidade} - {item.estado}</p>
                </div>
              </div>
              <p class="text-xs text-slate-400 leading-relaxed border-t border-white/10 pt-3">
                Região valorizada com excelente infraestrutura: proximidade com estações de metrô, colégios renomados, hospitais, gastronomia refinada e comércio de alto padrão.
              </p>
            </div>
          </div>

        </div>

        <!-- Coluna Direita: Formulário Flutuante de Contato / Atendimento -->
        <div class="lg:col-span-4" id="formulario">
          <div class="sticky top-28 glass-panel p-6 sm:p-8 rounded-3xl border border-[#c5a880]/30 shadow-2xl space-y-6">
            
            <div class="space-y-2">
              <span class="text-xs font-bold uppercase tracking-wider text-[#e5c07b]">
                Atendimento LZBA
              </span>
              <h3 class="text-xl sm:text-2xl font-bold text-white font-heading">
                Interessado no {item.titulo}?
              </h3>
              <p class="text-xs text-slate-400">
                Cadastre seus dados para receber a tabela de vendas atualizada e agendar visita ao decorado.
              </p>
            </div>

            <!-- Botão WhatsApp Direto -->
            <a
              href={whatsappCustomLink}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-center gap-2 py-3.5 px-4 rounded-xl text-sm font-bold text-slate-950 bg-gradient-to-r from-[#e5c07b] to-[#c5a880] hover:from-[#f3cf8e] hover:to-[#d4b58b] shadow-lg shadow-[#c5a880]/20 transition-all"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.149.929 3.182 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.288.043.088.072.189.014.305-.058.115-.087.188-.173.289l-.26.309c-.087.086-.179.18-.077.355.101.173.45 0.742.966 1.202.665.592 1.226.776 1.399.863.173.086.275.072.376-.044.101-.116.433-.506.549-.679.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.044.073.044.419-.1 0.824z"/>
              </svg>
              <span>Plantão de Vendas no WhatsApp</span>
            </a>

            <div class="relative flex items-center justify-center my-4">
              <div class="border-t border-white/10 w-full"></div>
              <span class="bg-[#0f172a] px-3 text-[11px] text-slate-500 uppercase">ou preencha abaixo</span>
            </div>

            <!-- Formulário -->
            <form class="space-y-3.5" action="/contato" method="GET">
              <input type="hidden" name="empreendimento" value={item.titulo} />
              
              <div>
                <label for="lead-name" class="block text-xs font-medium text-slate-300 mb-1">Nome Completo</label>
                <input
                  type="text"
                  id="lead-name"
                  name="nome"
                  required
                  placeholder="Seu nome"
                  class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/80 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#c5a880] transition-colors"
                />
              </div>

              <div>
                <label for="lead-email" class="block text-xs font-medium text-slate-300 mb-1">E-mail</label>
                <input
                  type="email"
                  id="lead-email"
                  name="email"
                  required
                  placeholder="seu@email.com"
                  class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/80 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#c5a880] transition-colors"
                />
              </div>

              <div>
                <label for="lead-phone" class="block text-xs font-medium text-slate-300 mb-1">Telefone / WhatsApp</label>
                <input
                  type="tel"
                  id="lead-phone"
                  name="telefone"
                  required
                  placeholder="(11) 90000-0000"
                  class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/80 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#c5a880] transition-colors"
                />
              </div>

              <div>
                <label for="lead-message" class="block text-xs font-medium text-slate-300 mb-1">Mensagem (opcional)</label>
                <textarea
                  id="lead-message"
                  name="mensagem"
                  rows="3"
                  placeholder="Gostaria de agendar uma visita..."
                  class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/80 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-[#c5a880] transition-colors resize-none"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full py-3 px-4 rounded-xl text-sm font-bold text-white bg-white/10 hover:bg-white/20 border border-white/10 transition-colors"
              >
                Enviar Mensagem
              </button>

              <p class="text-[10px] text-slate-500 text-center leading-relaxed">
                Seus dados estão protegidos conforme nossa <a href="/politica-de-privacidade" class="text-slate-400 underline">Política de Privacidade</a>.
              </p>
            </form>

          </div>
        </div>

      </div>

    </div>
  </section>
</Layout>
