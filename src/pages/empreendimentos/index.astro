---
import Layout from '../../layouts/Layout.astro';
import BuildingCard from '../../components/BuildingCard.astro';
import { EMPREENDIMENTOS, CONTATO_LZBA } from '../../data/empreendimentos';

const totalProjetos = EMPREENDIMENTOS.length;
const totalLancamentos = EMPREENDIMENTOS.filter(e => e.status === 'lancamento').length;
const totalEmObras = EMPREENDIMENTOS.filter(e => e.status === 'em_obras').length;
const totalEntregues = EMPREENDIMENTOS.filter(e => e.status === 'entregue').length;
---

<Layout
  title="Empreendimentos | Construtora e Incorporadora LZBA"
  description="Catálogo de empreendimentos LZBA: lançamentos, edifícios em construção e apartamentos entregues na Zona Norte e regiões nobres de São Paulo."
  currentPath="/empreendimentos"
>
  <!-- Cabeçalho da Página -->
  <section class="relative pt-16 pb-12 bg-gradient-to-b from-[#111827] to-[#0b0f17] border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs font-bold uppercase tracking-widest text-[#e5c07b]">
        Portfólio Imobiliário
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white font-heading mt-2 mb-4">
        Nossos Empreendimentos
      </h1>
      <p class="text-slate-400 text-base max-w-2xl mx-auto font-light leading-relaxed">
        Conheça nossos projetos desenhados para proporcionar exclusividade, conveniência e alta valorização patrimonial.
      </p>

      <!-- Barra de Filtros por Status -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-2 sm:gap-3" id="filters-container">
        <button
          type="button"
          data-filter="todos"
          class="filter-btn active px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 bg-[#c5a880] text-slate-950 shadow-md"
        >
          Todos ({totalProjetos})
        </button>
        <button
          type="button"
          data-filter="lancamento"
          class="filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/10"
        >
          Lançamentos ({totalLancamentos})
        </button>
        <button
          type="button"
          data-filter="em_obras"
          class="filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/10"
        >
          Em Obras ({totalEmObras})
        </button>
        <button
          type="button"
          data-filter="entregue"
          class="filter-btn px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white border border-white/10"
        >
          Prontos / Entregues ({totalEntregues})
        </button>
      </div>

    </div>
  </section>

  <!-- Grid de Empreendimentos -->
  <section class="py-16 sm:py-20 bg-[#0b0f17]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="buildings-grid">
        {EMPREENDIMENTOS.map((item) => (
          <div class="building-item" data-status={item.status}>
            <BuildingCard item={item} />
          </div>
        ))}
      </div>

      <!-- Estado Vazio (fallback dinâmico) -->
      <div id="no-results" class="hidden text-center py-20">
        <p class="text-slate-400 text-lg">Nenhum empreendimento encontrado para esta categoria.</p>
      </div>

    </div>
  </section>

  <!-- CTA de Atendimento Personalizado -->
  <section class="py-16 bg-[#0e1422] border-t border-white/5">
    <div class="max-w-4xl mx-auto px-4 text-center space-y-6">
      <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading">
        Procurando um imóvel com características específicas?
      </h2>
      <p class="text-slate-400 text-sm sm:text-base">
        Fale diretamente com nossa equipe de atendimento para receber opções personalizadas de acordo com o seu perfil e orçamento.
      </p>
      <div class="pt-2">
        <a
          href={CONTATO_LZBA.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl text-sm font-bold text-slate-950 bg-gradient-to-r from-[#e5c07b] to-[#c5a880] hover:from-[#f3cf8e] hover:to-[#d4b58b] shadow-xl shadow-[#c5a880]/20 transition-all"
        >
          <span>Consultar Especialista pelo WhatsApp</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Script Leve de Filtragem (Zero dependências externas) -->
  <script is:inline>
    const buttons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.building-item');
    const noResults = document.getElementById('no-results');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Atualizar botões
        buttons.forEach((b) => {
          b.classList.remove('active', 'bg-[#c5a880]', 'text-slate-950', 'shadow-md');
          b.classList.add('bg-white/5', 'text-slate-300', 'border', 'border-white/10');
        });

        btn.classList.add('active', 'bg-[#c5a880]', 'text-slate-950', 'shadow-md');
        btn.classList.remove('bg-white/5', 'text-slate-300', 'border-white/10');

        // Filtrar cards
        let visibleCount = 0;
        items.forEach((item) => {
          const status = item.getAttribute('data-status');
          if (filter === 'todos' || status === filter) {
            item.style.display = 'block';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        if (noResults) {
          noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      });
    });
  </script>
</Layout>
