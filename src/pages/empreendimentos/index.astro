---
import Layout from "../../layouts/Layout.astro";
import BuildingCard from "../../components/BuildingCard.astro";
import CtaSection from "../../components/sections/CtaSection.astro";
import { EMPREENDIMENTOS } from "../../data/empreendimentos";

const totalProjetos = EMPREENDIMENTOS.length;
const totalDestaques = EMPREENDIMENTOS.filter((e) => e.destaque).length;
const totalLancamentos = EMPREENDIMENTOS.filter(
  (e) => e.status === "lancamento",
).length;
const totalEmObras = EMPREENDIMENTOS.filter(
  (e) => e.status === "em_obras",
).length;
const totalEntregues = EMPREENDIMENTOS.filter(
  (e) => e.status === "entregue",
).length;
---

<Layout
  title="Empreendimentos | Construtora e Incorporadora LZBA"
  description="Catálogo de empreendimentos LZBA: lançamentos, edifícios em construção e apartamentos entregues na Zona Norte e regiões nobres de São Paulo."
  currentPath="/empreendimentos"
  image="/images/02023-scaled-1.jpg"
>
  <!-- 1. HERO INSTITUCIONAL DE EMPREENDIMENTOS (PADRÃO ESTÉTICO DA HOME) -->
  <section
    class="relative pt-20 sm:pt-16 pb-16 overflow-hidden bg-lzba-dark text-white"
  >
    <!-- Imagem de Fundo com Overlay Arquitetônico -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/02023-scaled-1.jpg"
        alt="Empreendimentos LZBA na Zona Norte"
        class="w-full h-full object-cover object-top sm:object-center brightness-[0.4] scale-100"
        loading="eager"
      />
      <div class="absolute inset-0 hero-overlay"></div>
    </div>

    <div
      class="relative z-10 max-w-7xl mx-[10%] px-4 sm:px-6 lg:px-8 w-full my-auto"
    >
      <div class="max-w-3xl">
        <span
          class="animate-hero-1 text-xs uppercase font-bold tracking-widest text-lzba-gold block mb-3 font-sans"
        >
          PORTFÓLIO IMOBILIÁRIO • TRADIÇÃO NA ZONA NORTE
        </span>
        <h1
          class="animate-hero-2 text-3xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight uppercase leading-[1.12] font-heading"
        >
          Nossos Empreendimentos.
        </h1>
        <p
          class="animate-hero-3 text-sm sm:text-base lg:text-lg text-neutral-300 max-w-2xl mt-6 font-light leading-relaxed"
        >
          Projetos concebidos para proporcionar sofisticação, conforto acústico,
          funcionalidade real de plantas e valorização patrimonial consistente
          em endereços consolidados de São Paulo.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. BARRA DE FILTROS ARQUITETÔNICA -->
  <section
    class="bg-lzba-light border-b border-lzba-border/80 sticky top-20 z-30 shadow-2xs"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
      <div
        class="flex flex-wrap items-center justify-center sm:justify-start gap-2 sm:gap-3"
        id="filters-container"
      >
        <button
          type="button"
          data-filter="destaques"
          class="filter-btn active px-5 py-2.5 text-xs sm:text-sm font-semibold tracking-wider uppercase transition-all duration-200 border border-lzba-gold bg-lzba-gold text-lzba-dark shadow-xs cursor-pointer"
        >
          Oportunidades em Destaque ({totalDestaques})
        </button>

        <button
          type="button"
          data-filter="todos"
          class="filter-btn px-5 py-2.5 text-xs sm:text-sm font-semibold tracking-wider uppercase transition-all duration-200 border border-lzba-border bg-white text-neutral-700 hover:border-neutral-400 hover:text-neutral-900 shadow-2xs cursor-pointer"
        >
          Todos ({totalProjetos})
        </button>

        <button
          type="button"
          data-filter="lancamento"
          class="filter-btn px-5 py-2.5 text-xs sm:text-sm font-semibold tracking-wider uppercase transition-all duration-200 border border-lzba-border bg-white text-neutral-700 hover:border-neutral-400 hover:text-neutral-900 shadow-2xs cursor-pointer"
        >
          Lançamentos ({totalLancamentos})
        </button>

        <button
          type="button"
          data-filter="em_obras"
          class="filter-btn px-5 py-2.5 text-xs sm:text-sm font-semibold tracking-wider uppercase transition-all duration-200 border border-lzba-border bg-white text-neutral-700 hover:border-neutral-400 hover:text-neutral-900 shadow-2xs cursor-pointer"
        >
          Em Obras ({totalEmObras})
        </button>

        <button
          type="button"
          data-filter="entregue"
          class="filter-btn px-5 py-2.5 text-xs sm:text-sm font-semibold tracking-wider uppercase transition-all duration-200 border border-lzba-border bg-white text-neutral-700 hover:border-neutral-400 hover:text-neutral-900 shadow-2xs cursor-pointer"
        >
          Prontos / Entregues ({totalEntregues})
        </button>
      </div>
    </div>
  </section>

  <!-- 3. GRID DE EMPREENDIMENTOS -->
  <section class="py-16 sm:py-24 bg-white min-h-[50vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
        id="buildings-grid"
      >
        {
          EMPREENDIMENTOS.map((item) => (
            <div
              class="building-item"
              data-status={item.status}
              data-destaque={item.destaque ? "true" : "false"}
              style={item.destaque ? "display: block;" : "display: none;"}
            >
              <BuildingCard item={item} />
            </div>
          ))
        }
      </div>

      <!-- Estado Vazio (fallback dinâmico) -->
      <div
        id="no-results"
        class="hidden text-center py-20 p-8 border border-dashed border-lzba-border max-w-lg mx-auto"
      >
        <p class="text-neutral-500 text-base font-light">
          Nenhum empreendimento encontrado para a categoria selecionada.
        </p>
      </div>
    </div>
  </section>

  <!-- 4. CTA BANNER OFICIAL DA HOME -->
  <CtaSection />

  <!-- Script Leve de Filtragem (Zero dependências externas) -->
  <script is:inline>
    const setupFilters = () => {
      const buttons = document.querySelectorAll(".filter-btn");
      const items = document.querySelectorAll(".building-item");
      const noResults = document.getElementById("no-results");

      if (!buttons.length || !items.length) return;

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const filter = btn.getAttribute("data-filter");

          // Resetar todos os botões para o estado neutro
          buttons.forEach((b) => {
            b.classList.remove(
              "active",
              "bg-lzba-gold",
              "border-lzba-gold",
              "text-lzba-dark",
              "bg-lzba-dark",
              "text-white",
              "border-lzba-dark",
            );
            b.classList.add(
              "bg-white",
              "text-neutral-700",
              "border-lzba-border",
            );
          });

          // Ativar o botão clicado
          btn.classList.remove(
            "bg-white",
            "text-neutral-700",
            "border-lzba-border",
          );
          if (filter === "destaques") {
            btn.classList.add(
              "active",
              "bg-lzba-gold",
              "border-lzba-gold",
              "text-lzba-dark",
              "shadow-xs",
            );
          } else {
            btn.classList.add(
              "active",
              "bg-lzba-dark",
              "border-lzba-dark",
              "text-white",
              "shadow-xs",
            );
          }

          // Filtrar os cards
          let visibleCount = 0;
          items.forEach((item) => {
            const status = item.getAttribute("data-status");
            const isDestaque = item.getAttribute("data-destaque") === "true";

            let matches = false;
            if (filter === "todos") {
              matches = true;
            } else if (filter === "destaques") {
              matches = isDestaque;
            } else {
              matches = status === filter;
            }

            if (matches) {
              item.style.display = "block";
              visibleCount++;
            } else {
              item.style.display = "none";
            }
          });

          if (noResults) {
            noResults.style.display = visibleCount === 0 ? "block" : "none";
          }
        });
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupFilters);
    } else {
      setupFilters();
    }

    document.addEventListener("astro:page-load", setupFilters);
  </script>
</Layout>
