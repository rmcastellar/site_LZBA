---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import DiferenciaisSection from "../components/sections/DiferenciaisSection.astro";
import ProjetosSection from "../components/sections/ProjetosSection.astro";
import PrevisibilidadeSection from "../components/sections/PrevisibilidadeSection.astro";
import NumerosSection from "../components/sections/NumerosSection.astro";
import FaqSection from "../components/sections/FaqSection.astro";
import CtaSection from "../components/sections/CtaSection.astro";
---

<Layout
  title="LZBA Construtora e Incorporadora | Tradição, Solidez e Excelência"
  description="Solidez técnica e tradição que valorizam o patrimônio da sua família. Há 34 anos transformando projetos em lares funcionais de alta consistência executiva."
  currentPath="/"
>
  <!-- 1. Hero Principal -->
  <HeroSection />

  <!-- 2. Como Fazemos / Diferenciais e Pilares -->
  <DiferenciaisSection />

  <!-- 3. Projetos (Mockup com Timeline e Cards Interativos) -->
  <ProjetosSection />

  <!-- 4. Previsibilidade e Jornada de Compra -->
  <PrevisibilidadeSection />

  <!-- 5. Faixa Escura de Métricas -->
  <NumerosSection />

  <!-- 6. Dúvidas Frequentes e Esclarecimentos Técnicos -->
  <FaqSection />

  <!-- 7. CTA Final -->
  <CtaSection />
</Layout>
