---
import Layout from "../layouts/Layout.astro";
import { ARTIGOS_BLOG } from "../data/artigos";
import BlogCard from "../components/artigosBlog/BlogCard.astro";

const artigoDestaque = ARTIGOS_BLOG[0];
const demaisArtigos = ARTIGOS_BLOG.slice(1);

const title =
  "Blog LZBA | Imóveis, Parques e Qualidade de Vida na Zona Norte de SP";
const description =
  "Confira os artigos, guias de bairros e novidades sobre o mercado imobiliário da Zona Norte de São Paulo. Experiência de 35 anos da LZBA Incorporadora.";
---

<Layout
  title={title}
  description={description}
  currentPath="/blog"
  image="/images/blog/tradicao-inovacao-zona-norte.jpg"
>
  <!-- SEO Adicional Local & GEO -->
  <Fragment slot="head">
    <meta name="geo.region" content="BR-SP" />
    <meta name="geo.placename" content="São Paulo - Zona Norte" />
    <meta name="geo.position" content="-23.4925;-46.6180" />
    <meta name="ICBM" content="-23.4925, -46.6180" />
  </Fragment>

  <!-- 1. Header do Blog com Boas-Vindas -->
  <section
    class="relative pt-32 pb-20 sm:pt-40 sm:pb-28 bg-lzba-dark text-white overflow-hidden flex items-center min-h-[42vh]"
  >
    <!-- Overlay Arquitetônico -->
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 hero-overlay"></div>
    </div>

    <div
      class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full my-auto"
    >
      <div class="max-w-3xl">
        <span
          class="animate-hero-1 text-xs uppercase font-bold tracking-widest text-lzba-gold block mb-3 font-sans"
        >
          BLOG OFICIAL LZBA • CONTEÚDO EXCLUSIVO
        </span>
        <h1
          class="animate-hero-2 text-3xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight uppercase leading-[1.12] font-heading"
        >
          Notícias, Guias e Estilo de Vida na <span class="text-lzba-gold"
            >Zona Norte</span
          >
        </h1>
        <p class="animate-hero-3 text-sm sm:text-base lg:text-lg text-neutral-300 max-w-2xl mt-4 font-light leading-relaxed">
          Explore reflexões sobre arquitetura moderna, tendências do mercado imobiliário e guias dos bairros mais nobres da Zona Norte de São Paulo.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Conteúdo Principal do Blog -->
  <div class="bg-neutral-50 py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      <!-- Artigo em Destaque Principal -->
      {
        artigoDestaque && (
          <section aria-labelledby="featured-heading" class="reveal-up">
            <div class="flex items-center justify-between mb-6">
              <h2
                id="featured-heading"
                class="text-xs uppercase tracking-widest text-neutral-500 font-bold"
              >
                Artigo em Destaque
              </h2>
            </div>
            <BlogCard artigo={artigoDestaque} featured={true} />
          </section>
        )
      }

      <!-- Demais Artigos em Grid -->
      <section aria-labelledby="all-articles-heading" class="reveal-up">
        <div
          class="flex items-center justify-between mb-8 pb-4 border-b border-neutral-200"
        >
          <h2
            id="all-articles-heading"
            class="text-2xl font-bold text-neutral-900"
          >
            Últimas Publicações
          </h2>
          <span class="text-xs text-neutral-500 font-medium">
            {ARTIGOS_BLOG.length} artigos disponíveis
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            demaisArtigos.map((artigo, idx) => (
              <div class={`reveal-up delay-${(idx + 1) * 100}`}>
                <BlogCard artigo={artigo} />
              </div>
            ))
          }
        </div>
      </section>

      <!-- Banner GEO e Institucional LZBA -->
      <section
        class="reveal-scale bg-lzba-dark text-white rounded-2xl p-8 sm:p-12 relative overflow-hidden border border-white/10"
      >
        <div
          class="absolute -right-20 -bottom-20 w-80 h-80 bg-lzba-gold/10 rounded-full blur-3xl pointer-events-none"
        >
        </div>
        <div class="relative z-10 max-w-3xl">
          <span
            class="text-xs uppercase tracking-widest text-lzba-gold font-bold mb-3 block"
          >
            Mais de 30 Anos de Tradição e Excelência
          </span>
          <h3 class="text-2xl sm:text-3xl lg:text-4xl font-bold mb-4 text-white font-heading uppercase tracking-tight">
            Planejando morar na Zona Norte com exclusividade?
          </h3>
          <p class="text-neutral-300 font-light leading-relaxed mb-6 text-sm sm:text-base">
            Conheça nossos empreendimentos residenciais no Jardim São Paulo e na
            Vila Mazzei / Tucuruvi. Plantas pensadas para cada momento da sua
            vida com acabamento de alto padrão.
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <a
              href="/empreendimentos"
              class="inline-flex items-center gap-2 px-6 py-3.5 bg-lzba-red hover:bg-lzba-red/90 text-white font-medium text-xs sm:text-sm uppercase tracking-wider transition-all duration-300 shadow-sm"
            >
              Ver Empreendimentos LZBA
              <svg
                class="w-4 h-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
            <a
              href="https://wa.me/5511999618125?text=Ol%C3%A1!%20Acessei%20o%20Blog%20da%20LZBA%20e%20gostaria%20de%20falar%20com%20um%20consultor."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3.5 border border-lzba-gold/40 text-lzba-gold hover:bg-lzba-gold hover:text-lzba-dark font-medium text-xs sm:text-sm uppercase tracking-wider transition-all duration-300"
            >
              Falar via WhatsApp
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>
