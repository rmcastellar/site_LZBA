---
import Layout from "../layouts/Layout.astro";
import { CONTATO_LZBA } from "../data/empreendimentos";

const title = "Contato | Construtora e Incorporadora LZBA";
const description =
  "Entre em contato com a Construtora LZBA. Canais de atendimento via WhatsApp, telefone (11) 2691-9059, e-mail e sede própria em Santana, Zona Norte de São Paulo.";
---

<Layout
  title={title}
  description={description}
  currentPath="/contato"
  image="/images/hero-building.jpg"
>
  <!-- 1. HERO INSTITUCIONAL DE CONTATO (PADRÃO ESTÉTICO DA HOME) -->
  <section
    class="relative pt-20 sm:pt-16 pb-16 overflow-hidden bg-lzba-dark text-white"
  >
    <!-- Imagem de Fundo com Overlay Arquitetônico -->
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 hero-overlay"></div>
    </div>

    <div
      class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full my-auto"
    >
      <div class="max-w-3xl">
        <span
          class="animate-hero-1 text-xs uppercase font-bold tracking-widest text-lzba-gold block mb-3 font-sans"
        >
          CANAIS OFICIAIS • ATENDIMENTO EXCLUSIVO
        </span>
        <h1
          class="animate-hero-2 text-3xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight uppercase leading-[1.12] font-heading"
        >
          Fale com a LZBA<br />
          Incorporadora.
        </h1>
        <p
          class="animate-hero-3 text-sm sm:text-base lg:text-lg text-neutral-300 max-w-2xl mt-6 font-light leading-relaxed"
        >
          Nossa equipe de consultores técnicos e corretores parceiros está à
          disposição para apresentar plantas, agendar visitas exclusivas aos
          decorados ou avaliar novas oportunidades imobiliárias na Zona Norte.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. CARDS DE ATENDIMENTO RÁPIDO (COM A MOLDURA ARQUITETÔNICA LZBA) -->
  <section class="py-12 bg-lzba-light border-b border-lzba-border/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Telefone -->
        <div
          class="reveal-up delay-100 group relative p-1.5 border border-transparent hover:border-lzba-border transition-all duration-300"
        >
          <a
            href={`tel:${CONTATO_LZBA.telefone.replace(/\D/g, "")}`}
            class="h-full bg-white p-6 border border-lzba-border/80 hover:border-lzba-gold/60 transition-all duration-300 shadow-xs flex flex-col justify-between block"
          >
            <div>
              <div
                class="w-12 h-12 rounded-lg bg-lzba-light border border-lzba-border flex items-center justify-center text-lzba-dark mb-4 shadow-2xs group-hover:scale-105 transition-transform"
              >
                <svg
                  class="w-6 h-6 text-lzba-gold"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                  ></path>
                </svg>
              </div>
              <span
                class="text-xs uppercase font-bold tracking-wider text-neutral-500 block"
              >
                Telefone Comercial
              </span>
              <span
                class="text-lg font-bold text-lzba-dark font-heading mt-1 block"
              >
                {CONTATO_LZBA.telefone}
              </span>
            </div>
            <span
              class="text-xs text-lzba-gold font-medium mt-4 flex items-center gap-1"
            >
              Ligar agora
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </span>
          </a>
        </div>

        <!-- WhatsApp -->
        <div
          class="reveal-up delay-200 group relative p-1.5 border border-transparent hover:border-lzba-border transition-all duration-300"
        >
          <a
            href={CONTATO_LZBA.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="h-full bg-white p-6 border border-lzba-border/80 hover:border-lzba-gold/60 transition-all duration-300 shadow-xs flex flex-col justify-between block"
          >
            <div>
              <div
                class="w-12 h-12 rounded-lg bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-600 mb-4 shadow-2xs group-hover:scale-105 transition-transform"
              >
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                  <path
                    d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.149.929 3.182 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.768-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.288.043.088.072.189.014.305-.058.115-.087.188-.173.289l-.26.309c-.087.086-.179.18-.077.355.101.173.45 0.742.966 1.202.665.592 1.226.776 1.399.863.173.086.275.072.376-.044.101-.116.433-.506.549-.679.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.044.073.044.419-.1 0.824z"
                  ></path>
                </svg>
              </div>
              <span
                class="text-xs uppercase font-bold tracking-wider text-neutral-500 block"
              >
                Plantão WhatsApp
              </span>
              <span
                class="text-lg font-bold text-lzba-dark font-heading mt-1 block"
              >
                {CONTATO_LZBA.whatsapp}
              </span>
            </div>
            <span
              class="text-xs text-emerald-600 font-medium mt-4 flex items-center gap-1"
            >
              Conversar no WhatsApp
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </span>
          </a>
        </div>

        <!-- E-mail -->
        <div
          class="reveal-up delay-300 group relative p-1.5 border border-transparent hover:border-lzba-border transition-all duration-300"
        >
          <a
            href={`mailto:${CONTATO_LZBA.email}`}
            class="h-full bg-white p-6 border border-lzba-border/80 hover:border-lzba-gold/60 transition-all duration-300 shadow-xs flex flex-col justify-between block"
          >
            <div>
              <div
                class="w-12 h-12 rounded-lg bg-lzba-light border border-lzba-border flex items-center justify-center text-lzba-dark mb-4 shadow-2xs group-hover:scale-105 transition-transform"
              >
                <svg
                  class="w-6 h-6 text-lzba-gold"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>
              <span
                class="text-xs uppercase font-bold tracking-wider text-neutral-500 block"
              >
                E-mail Corporativo
              </span>
              <span
                class="text-sm font-bold text-lzba-dark font-heading mt-1 block truncate"
              >
                {CONTATO_LZBA.email}
              </span>
            </div>
            <span
              class="text-xs text-lzba-gold font-medium mt-4 flex items-center gap-1"
            >
              Enviar mensagem
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </span>
          </a>
        </div>

        <!-- Sede e Horário -->
        <div
          class="reveal-up delay-400 group relative p-1.5 border border-transparent hover:border-lzba-border transition-all duration-300"
        >
          <div
            class="h-full bg-white p-6 border border-lzba-border/80 shadow-xs flex flex-col justify-between"
          >
            <div>
              <div
                class="w-12 h-12 rounded-lg bg-lzba-light border border-lzba-border flex items-center justify-center text-lzba-dark mb-4 shadow-2xs"
              >
                <svg
                  class="w-6 h-6 text-lzba-gold"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <span
                class="text-xs uppercase font-bold tracking-wider text-neutral-500 block"
              >
                Sede Santana - SP
              </span>
              <span class="text-xs text-neutral-600 font-light mt-1 block">
                {CONTATO_LZBA.endereco}
              </span>
            </div>
            <span class="text-xs text-neutral-500 font-medium mt-4 block">
              {CONTATO_LZBA.horario}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. SEÇÃO PRINCIPAL: FORMULÁRIO DE ATENDIMENTO + SEDE & MAPA -->
  <section class="py-20 lg:py-28 bg-white text-lzba-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start"
      >
        <!-- Coluna da Esquerda: Formulário de Mensagem -->
        <div class="lg:col-span-7">
          <div
            class="reveal-left bg-lzba-light/50 p-8 sm:p-10 border border-lzba-border shadow-xs"
          >
            <div class="mb-8">
              <span
                class="text-xs uppercase font-bold tracking-widest text-lzba-gold block mb-2 font-sans"
              >
                FORMULÁRIO DE CONTATO
              </span>
              <h2
                class="text-2xl sm:text-3xl font-bold text-lzba-dark font-heading leading-tight"
              >
                Envie sua Solicitação
              </h2>
              <p
                class="text-sm text-neutral-600 font-light mt-2 leading-relaxed"
              >
                Preencha os dados abaixo e entraremos em contato com todas as
                informações e materiais solicitados.
              </p>
            </div>

            <!-- Feedback de Sucesso -->
            <div
              id="form-success"
              class="hidden p-5 bg-emerald-50 border border-emerald-300 text-emerald-800 text-sm mb-6 flex items-center gap-3"
            >
              <svg
                class="w-5 h-5 text-emerald-600 shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span
                >Sua mensagem foi enviada com sucesso! Nossa equipe entrará em
                contato em breve.</span
              >
            </div>

            <form id="contact-form" class="space-y-5">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label
                    for="f-nome"
                    class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 mb-2"
                  >
                    Nome Completo *
                  </label>
                  <input
                    type="text"
                    id="f-nome"
                    name="nome"
                    required
                    placeholder="Seu nome"
                    class="w-full px-4 py-3 bg-white border border-lzba-border text-lzba-dark placeholder-neutral-400 text-sm focus:outline-none focus:border-lzba-gold transition-colors"
                  />
                </div>

                <div>
                  <label
                    for="f-email"
                    class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 mb-2"
                  >
                    E-mail Comercial *
                  </label>
                  <input
                    type="email"
                    id="f-email"
                    name="email"
                    required
                    placeholder="seu@email.com"
                    class="w-full px-4 py-3 bg-white border border-lzba-border text-lzba-dark placeholder-neutral-400 text-sm focus:outline-none focus:border-lzba-gold transition-colors"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label
                    for="f-telefone"
                    class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 mb-2"
                  >
                    Telefone / WhatsApp *
                  </label>
                  <input
                    type="tel"
                    id="f-telefone"
                    name="telefone"
                    required
                    placeholder="(11) 90000-0000"
                    class="w-full px-4 py-3 bg-white border border-lzba-border text-lzba-dark placeholder-neutral-400 text-sm focus:outline-none focus:border-lzba-gold transition-colors"
                  />
                </div>

                <div>
                  <label
                    for="f-assunto"
                    class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 mb-2"
                  >
                    Finalidade do Contato
                  </label>
                  <select
                    id="f-assunto"
                    name="assunto"
                    class="w-full px-4 py-3 bg-white border border-lzba-border text-lzba-dark text-sm focus:outline-none focus:border-lzba-gold transition-colors"
                  >
                    <option value="Dúvidas sobre Empreendimentos">
                      Dúvidas sobre Empreendimentos
                    </option>
                    <option value="Agendar Visita ao Decorado">
                      Agendar Visita ao Decorado
                    </option>
                    <option value="Residencial Árbore (Jardim São Paulo)">
                      Residencial Árbore (Jd. São Paulo)
                    </option>
                    <option value="Residencial Season (Vila Mazzei)">
                      Residencial Season (Vila Mazzei)
                    </option>
                    <option value="Parceria de Corretores / Imobiliárias">
                      Parceria de Corretores / Imobiliárias
                    </option>
                    <option value="Venda de Terreno para Incorporação">
                      Venda de Terreno para Incorporação
                    </option>
                    <option value="Fornecedores e Suprimentos">
                      Fornecedores e Suprimentos
                    </option>
                    <option value="Outros">Outros assuntos</option>
                  </select>
                </div>
              </div>

              <div>
                <label
                  for="f-mensagem"
                  class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 mb-2"
                >
                  Mensagem Detalhada *
                </label>
                <textarea
                  id="f-mensagem"
                  name="mensagem"
                  rows="4"
                  required
                  placeholder="Escreva sua mensagem com os detalhes de seu interesse..."
                  class="w-full px-4 py-3 bg-white border border-lzba-border text-lzba-dark placeholder-neutral-400 text-sm focus:outline-none focus:border-lzba-gold transition-colors resize-none"
                ></textarea>
              </div>

              <div class="pt-2">
                <button
                  type="submit"
                  id="f-submit"
                  class="inline-block px-10 py-4 bg-lzba-dark hover:bg-lzba-red text-white text-xs sm:text-sm font-semibold tracking-widest uppercase transition-colors shadow-sm cursor-pointer"
                >
                  ENVIAR MENSAGEM
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- Coluna da Direita: Sede Santana & Mapa -->
        <div class="lg:col-span-5 space-y-8">
          <!-- Box Informativo da Sede -->
          <div
            class="reveal-right p-8 bg-lzba-light/60 border border-lzba-border"
          >
            <span
              class="text-xs uppercase font-bold tracking-widest text-lzba-gold block mb-2 font-sans"
            >
              SEDE PRÓPRIA
            </span>
            <h3 class="text-xl font-bold text-lzba-dark font-heading">
              Escritório Corporativo
            </h3>
            <p class="text-sm text-neutral-600 font-light mt-3 leading-relaxed">
              Instalada no coração do bairro de Santana, a sede da LZBA
              centraliza as diretorias de engenharia, jurídica, compras e
              atendimento ao cliente.
            </p>

            <div
              class="space-y-4 pt-6 mt-6 border-t border-lzba-border/80 text-sm"
            >
              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-lzba-gold shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <div>
                  <span class="font-bold text-lzba-dark block"
                    >Endereço Físico</span
                  >
                  <span class="text-xs text-neutral-600 font-light">
                    {CONTATO_LZBA.endereco}
                  </span>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-lzba-gold shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                  <span class="font-bold text-lzba-dark block"
                    >Atendimento Presencial</span
                  >
                  <span class="text-xs text-neutral-600 font-light">
                    {CONTATO_LZBA.horario} (mediante agendamento)
                  </span>
                </div>
              </div>
            </div>

            <!-- Botão de Traçar Rota no Google Maps -->
            <div class="mt-6 pt-4">
              <a
                href={CONTATO_LZBA.enderecoWeb}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-lzba-dark hover:text-lzba-gold transition-colors"
              >
                Abrir Rota no Google Maps
                <svg
                  class="w-4 h-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  ></path>
                </svg>
              </a>
            </div>
          </div>

          <!-- Mapa Interativo do Google Maps (Santana - SP) -->
          <div
            class="reveal-right delay-100 p-2 border border-lzba-border bg-white shadow-xs"
          >
            <div class="relative w-full h-64 overflow-hidden bg-neutral-100">
              <iframe
                title="Localização da sede da Construtora LZBA em Santana São Paulo"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3659.186638062013!2d-46.63435882379374!3d-23.490709878848135!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94cef7cc4bdf735d%3A0xe487216a9c1e7a0f!2sR.%20Augusto%20Tolle%2C%20767%20-%20Santana%2C%20S%C3%A3o%20Paulo%20-%20SP%2C%2002405-001!5e0!3m2!1spt-BR!2sbr!4v1710000000000!5m2!1spt-BR!2sbr"
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                class="w-full h-full grayscale-[50%] contrast-[1.05]"></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Script nativo para simulação e feedback do formulário -->
  <script is:inline>
    const form = document.getElementById("contact-form");
    const successMsg = document.getElementById("form-success");
    const submitBtn = document.getElementById("f-submit");

    if (form) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (submitBtn) {
          submitBtn.textContent = "ENVIANDO...";
          submitBtn.disabled = true;
        }

        setTimeout(() => {
          form.reset();
          if (successMsg) successMsg.classList.remove("hidden");
          if (submitBtn) {
            submitBtn.textContent = "MENSAGEM ENVIADA";
            setTimeout(() => {
              submitBtn.textContent = "ENVIAR MENSAGEM";
              submitBtn.disabled = false;
            }, 3000);
          }
        }, 600);
      });
    }
  </script>
</Layout>
