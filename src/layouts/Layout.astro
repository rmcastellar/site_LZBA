---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CONTATO_LZBA } from '../data/empreendimentos';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'LZBA Construtora e Incorporadora | 35 Anos de Excelência na Zona Norte de SP',
  description = 'Com mais de 3 décadas de expertise no mercado imobiliário, a LZBA consolida-se como referência em inovação, qualidade e pontualidade na entrega de apartamentos.',
  currentPath = '/',
  image = '/images/hero-building.jpg',
  type = 'website',
  noindex = false,
  structuredData,
} = Astro.props;

const siteOrigin = (Astro.site?.toString() || 'https://lzba.com.br').replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, siteOrigin).toString();
const absoluteImage = new URL(image, siteOrigin).toString();

const baseSchemas: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'RealEstateAgent',
    '@id': `${siteOrigin}/#organization`,
    name: 'LZBA Construtora e Incorporadora',
    url: siteOrigin,
    logo: new URL('/images/logo.png', siteOrigin).toString(),
    image: absoluteImage,
    telephone: CONTATO_LZBA.telefone,
    email: CONTATO_LZBA.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'R. Augusto Tolle, 767',
      addressLocality: 'São Paulo',
      addressRegion: 'SP',
      addressCountry: 'BR',
    },
    areaServed: {
      '@type': 'City',
      name: 'São Paulo',
    },
    openingHours: 'Mo-Fr 09:00-18:00',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteOrigin}/#website`,
    url: siteOrigin,
    name: 'LZBA Construtora e Incorporadora',
    inLanguage: 'pt-BR',
    publisher: {
      '@id': `${siteOrigin}/#organization`,
    },
  },
];

const extraSchemas = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];

const allSchemas = [...baseSchemas, ...extraSchemas];
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth bg-[#161616] text-neutral-900 antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#161616" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Inter (carregamento assíncrono não bloqueante) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      />
    </noscript>

    <!-- SEO Primário -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:site_name" content="LZBA Construtora e Incorporadora" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />

    <!-- Dados Estruturados (JSON-LD) -->
    {allSchemas.map((schema) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-neutral-900 overflow-x-clip max-w-full">
    <Header currentPath={currentPath} />
    
    <main class="grow w-full max-w-full overflow-x-clip">
      <slot />
    </main>

    <Footer />

    <!-- Script de Animações de Entrada e Rolagem (Zero Dependências, Alto Desempenho) -->
    <script is:inline>
      const setupScrollReveals = () => {
        const reveals = document.querySelectorAll(
          '.reveal, .reveal-up, .reveal-left, .reveal-right, .reveal-scale, .reveal-fade'
        );

        if (!reveals.length) return;

        if (!('IntersectionObserver' in window)) {
          reveals.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            });
          },
          {
            rootMargin: '0px 0px -30px 0px',
            threshold: 0.08,
          }
        );

        reveals.forEach((el) => observer.observe(el));
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupScrollReveals);
      } else {
        setupScrollReveals();
      }

      document.addEventListener('astro:page-load', setupScrollReveals);
    </script>
  </body>
</html>
